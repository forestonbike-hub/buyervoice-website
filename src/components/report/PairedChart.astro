---
import { ceilPctValue } from '../../lib/pct';
// PairedChart.astro — the canonical paired bar chart (cross-wave validation,
// push-vs-pull, cohort A vs cohort B). Framework rules enforced here:
//   - row label column is a FIXED width (never min-width), so bar tracks
//     align vertically across rows (pre-publish check item 14)
//   - fills are raw prevalence percents, never scaled to the max
//   - percentage labels render inside the bar at its right edge
//   - the delta column carries the pp difference with an asterisk when the
//     pair is statistically significant; p-values never render
//   - `noDelta` collapses the grid for destination-distribution pairs where
//     a delta is not meaningful
//
// Usage:
//   <PairedChart
//     title="What mattered most to people who actually left"
//     questionText="Thinking back, what pushed you to leave?"
//     seriesA={{ name: 'Wave 1 switchers (n=120)', color: 'signal' }}
//     seriesB={{ name: 'Wave 2 matched non-switchers (n=160)', color: 'ink' }}
//     rows={[
//       { label: 'Branch closures', a: 42.0, b: 27.0, deltaPp: -15, deltaSig: true },
//     ]}
//     footnote="An asterisk marks pairs significant at alpha = 0.10 (two-tailed)."
//   />
interface Series {
  name: string;
  color?: 'ink' | 'signal' | 'teal' | 'warm' | 'slate' | 'plum';
}
interface PairedRow {
  label: string;
  a: number;             // percentage 0-100
  b: number;
  deltaPp?: number;      // signed percentage-point delta
  deltaSig?: boolean;    // asterisk on the delta
}
interface Props {
  title: string;
  questionText: string;
  seriesA: Series;
  seriesB: Series;
  rows: PairedRow[];
  noDelta?: boolean;
  footnote?: string;
}
const { title, questionText, seriesA, seriesB, rows, noDelta = false, footnote } = Astro.props;
const COLORS: Record<string, string> = {
  ink: '#0B1F3A', signal: '#B8341B', teal: '#2A7A6E',
  warm: '#C4784A', slate: '#5B6472', plum: '#6E3B5C',
};
const colorA = COLORS[seriesA.color ?? 'signal'];
const colorB = COLORS[seriesB.color ?? 'ink'];
function fmtPct(v: number) { return String(ceilPctValue(v)); }
function fmtDelta(v: number) { return (v > 0 ? '+' : '') + String(Math.round(v)); }
---

<figure class="paired-chart">
  <figcaption class="chart-title">{title}</figcaption>
  <p class="chart-question">{questionText}</p>

  <div class="legend">
    <span class="legend-item"><span class="legend-swatch" style={`background: ${colorA};`}></span>{seriesA.name}</span>
    <span class="legend-item"><span class="legend-swatch" style={`background: ${colorB};`}></span>{seriesB.name}</span>
  </div>

  <div class="paired-body">
    {rows.map((r) => (
      <div class:list={['paired-block', { 'no-delta': noDelta }]}>
        <span class="paired-label">{r.label}</span>
        <div class="paired-bars">
          <div class="bar-track"><div class="bar-fill" style={`width: ${Math.min(100, r.a)}%; background: ${colorA};`}><span class="bar-val">{fmtPct(r.a)}%</span></div></div>
          <div class="bar-track"><div class="bar-fill" style={`width: ${Math.min(100, r.b)}%; background: ${colorB};`}><span class="bar-val">{fmtPct(r.b)}%</span></div></div>
        </div>
        {!noDelta && (
          <span class="paired-delta">{r.deltaPp !== undefined && (<span>{fmtDelta(r.deltaPp)} pp{r.deltaSig && '*'}</span>)}</span>
        )}
      </div>
    ))}
  </div>

  {footnote && <p class="chart-footnote">{footnote}</p>}
</figure>

<style>
  .paired-chart { margin: 32px 0; font-family: var(--sans); }
  .chart-title { font-family: var(--serif); font-size: 17px; font-weight: 600; color: var(--ink); margin: 0 0 4px; }
  .chart-question { font-size: 13px; color: var(--muted); margin: 0 0 12px; font-style: italic; }
  .legend { display: flex; gap: 20px; margin: 0 0 12px; font-size: 12px; color: var(--rule); flex-wrap: wrap; }
  .legend-item { display: inline-flex; align-items: center; gap: 6px; }
  .legend-swatch { width: 12px; height: 12px; border-radius: 2px; display: inline-block; }
  .paired-body { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 10px 0; }
  /* Fixed label width, never min-width: keeps every row's track origin
     aligned (pre-publish check item 14). */
  .paired-block { display: grid; grid-template-columns: 200px 1fr 80px; gap: 12px; align-items: center; padding: 6px 0; }
  .paired-block.no-delta { grid-template-columns: 200px 1fr; }
  .paired-label { width: 200px; flex-shrink: 0; text-align: right; font-size: 13px; color: var(--ink); font-weight: 500; padding-right: 4px; }
  .paired-bars { display: flex; flex-direction: column; gap: 3px; }
  .bar-track { height: 16px; background: rgba(11, 31, 58, 0.06); border-radius: 2px; }
  .bar-fill { height: 100%; border-radius: 2px; display: flex; align-items: center; justify-content: flex-end; padding-right: 6px; color: #fff; font-size: 11px; font-weight: 600; min-width: 26px; }
  .paired-delta { font-size: 13px; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .chart-footnote { font-size: 11px; color: var(--muted); margin: 8px 0 0; font-style: italic; line-height: 1.5; }
  @media print { .paired-chart { page-break-inside: avoid; } }
</style>
