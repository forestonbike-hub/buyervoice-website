---
import { ceilPctValue } from '../../lib/pct';
// Chart.astro — canonical bar chart component. Renders a subgroup
// comparison with the dashed overall-average line and sig-flag
// superscripts per the BuyerVoice statistical methodology:
//   - Dashed line = overall sample average (visual)
//   - Test = subgroup vs all-others (rigorous; pre-computed)
//   - Alpha = 0.10, two-tailed
//
// Pass pre-computed sig flags from report-stats.json. This component
// does NOT run any stats — that happens in Python via
// significance_tests.py. This way there is ONE place (Python) where
// the statistical method lives, and the Astro component is a pure
// renderer.
//
// Usage:
//   <Chart
//     title="Frustration with in-branch service, by age band"
//     questionText="Q11. What's been the most frustrating part of banking with your primary bank in the last year?"
//     xLabel="% citing this frustration"
//     overallAverage={24.3}
//     overallN={300}
//     rows={[
//       { label: '18-25', value: 38.0, n: 42, sigLetter: 'a', sigFlag: '*' },
//       { label: '26-35', value: 31.0, n: 68, sigLetter: 'a' },
//       { label: '36-50', value: 22.0, n: 95 },
//       { label: '51-65', value: 17.0, n: 64 },
//       { label: '65+',   value: 11.0, n: 31, sigLetter: 'b', sigFlag: '*' },
//     ]}
//     footnote="Significance test compares the subgroup vs all other respondents combined; dashed line shows the overall sample average including the subgroup (n=300). α = 0.10 two-tailed."
//   />
export interface ChartRow {
  label: string;
  value: number;       // percentage (0-100)
  n?: number;
  sigLetter?: string;  // compact-letter-display superscript
  sigFlag?: string;    // "*" for p<0.10 vs others; blank otherwise
  subgroupLabel?: string;
}
interface Props {
  title: string;
  questionText: string;     // REQUIRED. Rendered as subtitle.
  xLabel?: string;
  overallAverage?: number;  // percentage for the dashed line
  overallN?: number;
  rows: ChartRow[];
  footnote?: string;
  color?: 'ink' | 'signal' | 'teal' | 'warm' | 'slate' | 'plum';  // single fill color per chart (framework rule)
  drilldownId?: string;     // matches a key in the DrilldownModal charts block; adds the data attribute + hint
}
const { title, questionText, xLabel, overallAverage, overallN, rows, footnote, color = 'ink', drilldownId } = Astro.props;
const CHART_WIDTH_PX = 520;
// Canonical bar rule (framework + review G8): the fill width IS the raw
// prevalence percent. Never scale to the max value — that renders the top
// bar as always-full, which misreads as 100%.
function leftPct(val: number) { return Math.min(100, val); }
const FILL_COLORS: Record<string, string> = {
  ink: 'var(--ink)', signal: '#B8341B', teal: '#2A7A6E',
  warm: '#C4784A', slate: '#5B6472', plum: '#6E3B5C',
};
const fillColor = FILL_COLORS[color] ?? FILL_COLORS.ink;
// BuyerVoice reporting rule: every percentage shown to a reader is rounded UP
// to the nearest whole number. No decimals, anywhere. See the framework docs.
function fmtPct(val: number) { return String(ceilPctValue(val)); }
---

<figure class="chart">
  <figcaption class="chart-title">{title}</figcaption>
  <p class="chart-question">{questionText}</p>

  <div class="chart-canvas" style={`--chart-width: ${CHART_WIDTH_PX}px;`} {...(drilldownId ? { 'data-drilldown-chart': drilldownId } : {})}>
    {overallAverage !== undefined && (
      <div
        class="overall-line"
        style={`left: ${leftPct(overallAverage)}%;`}
        aria-label={`Overall average: ${overallAverage}%`}
      >
        <span class="overall-label">Overall {fmtPct(overallAverage)}%</span>
      </div>
    )}
    {rows.map((r) => (
      <div class="chart-row bar-row" data-bar-label={r.label}>
        <span class="row-label">{r.label}{r.n !== undefined && <span class="row-n"> (n={r.n})</span>}</span>
        <div class="bar-track">
          <div class="bar-fill" style={`width: ${leftPct(r.value)}%; background: ${fillColor};`}>
            <span class="bar-value">
              {fmtPct(r.value)}%{r.sigFlag && <sup class="sig-flag">{r.sigFlag}</sup>}{r.sigLetter && <sup class="sig-letter">{r.sigLetter}</sup>}
            </span>
          </div>
        </div>
      </div>
    ))}
  </div>

  {xLabel && <p class="chart-x-label">{xLabel}</p>}
  {(footnote || drilldownId) && (
    <p class="chart-footnote">
      {footnote}{drilldownId && <span class="vb-hint"> Click a theme to read participant quotes.</span>}
    </p>
  )}
</figure>

<style>
  .chart { margin: 32px 0; font-family: var(--sans); }
  .chart-title { font-family: var(--serif); font-size: 17px; font-weight: 600; color: var(--ink); margin: 0 0 4px; }
  .chart-question { font-family: var(--sans); font-size: 13px; color: var(--muted); margin: 0 0 16px; font-style: italic; }
  .chart-canvas { position: relative; padding: 16px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .overall-line { position: absolute; top: 0; bottom: 0; width: 0; border-left: 1px dashed var(--signal); z-index: 2; }
  .overall-label { position: absolute; top: -18px; transform: translateX(-50%); font-size: 10px; letter-spacing: 0.04em; color: var(--signal); white-space: nowrap; background: var(--paper); padding: 0 4px; }
  .chart-row { display: flex; align-items: center; gap: 12px; padding: 4px 0; }
  .row-label { flex: 0 0 140px; font-size: 13px; color: var(--ink); font-weight: 500; }
  .row-n { color: var(--muted); font-weight: 400; }
  .bar-track { flex: 1; height: 22px; background: var(--card-bg); border-radius: 2px; position: relative; }
  .bar-fill { height: 100%; border-radius: 2px; display: flex; align-items: center; justify-content: flex-end; padding-right: 8px; color: #fff; font-size: 12px; font-weight: 600; min-width: 32px; }
  .bar-row { cursor: default; }
  [data-drilldown-chart] .bar-row { cursor: pointer; }
  [data-drilldown-chart] .bar-row:hover .row-label { color: var(--signal); }
  .vb-hint { color: var(--signal); font-style: normal; }
  .vb-hint::before { content: '\203A  '; }
  .bar-value sup { font-weight: 400; margin-left: 2px; }
  .sig-flag { color: #FFD166; }
  .sig-letter { color: rgba(255,255,255,0.8); font-style: italic; }
  .chart-x-label { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 8px 0 0; }
  .chart-footnote { font-size: 11px; color: var(--muted); margin: 8px 0 0; font-style: italic; line-height: 1.5; }
  @media print { .chart { page-break-inside: avoid; } }
</style>
