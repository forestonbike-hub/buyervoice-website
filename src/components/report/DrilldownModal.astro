---
// DrilldownModal.astro — the shared click-to-view-quotes drilldown
// (framework rule: every theme bar chart must be drillable).
//
// Drop ONE instance at the bottom of a report body and pass the study's
// verbatim-exemplars payload. Charts opt in by carrying
// data-drilldown-chart="<chart_id>" (Chart.astro and Scatter2x2.astro do
// this via their drilldownId prop); rows/points carry data-bar-label /
// data-point-label. chart_id must match a key in vx.charts.
//
// Payload shape (verbatim-exemplars.json):
//   questions:    {qid: question text}
//   participants: [{pid, v: {qid: verbatim}, c: {qid: [codes]},
//                   b: {qid: {code: bws_score}}  (or legacy i: 1/2/3),
//                   ...demographic fields}]
//   charts:       {chart_id: {cohort, qids, question,
//                             bars: {bar_label: [codes]}}}
//
// tagFields lists which participant fields render as chips on each quote
// card (study-specific: bank/age/prov for CIBC, seniority/industry for
// B2B). Q-numbers never render to the reader; the matched code name is the
// context chip instead.
interface Props {
  vx: Record<string, unknown>;
  tagFields?: string[];
}
const { vx, tagFields = ['bank', 'age', 'emp', 'prov', 'area', 'seniority', 'industry'] } = Astro.props;
---

<div class="vb-overlay" id="vbOverlay" aria-hidden="true">
  <div class="vb-dialog" role="dialog" aria-modal="true" aria-labelledby="vbTitle">
    <button type="button" class="vb-close" id="vbClose" aria-label="Close">&times;</button>
    <div class="vb-header">
      <h3 id="vbTitle"></h3>
      <p class="vb-q" id="vbSubtitle"></p>
    </div>
    <div class="vb-body" id="vbBody"></div>
  </div>
</div>

<script is:inline set:html={`window.__VX = ${JSON.stringify(vx)}; window.__VX_TAGS = ${JSON.stringify(tagFields)};`}></script>
<script is:inline>
(function () {
  var VX = window.__VX;
  if (!VX) return;
  var TAGS = window.__VX_TAGS || [];

  var overlay = document.getElementById('vbOverlay');
  var titleEl = document.getElementById('vbTitle');
  var subEl = document.getElementById('vbSubtitle');
  var bodyEl = document.getElementById('vbBody');
  var closeBtn = document.getElementById('vbClose');
  if (!overlay || !titleEl || !subEl || !bodyEl || !closeBtn) return;

  function escHtml(s) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(s == null ? '' : String(s)));
    return d.innerHTML;
  }

  // BWS bands match the pipeline thresholds (high >= +0.20, low <= -0.20).
  function bwsChip(score) {
    if (score == null) return '';
    var band = score >= 0.2 ? 'high' : score <= -0.2 ? 'low' : 'mid';
    var label = band === 'high' ? 'High intensity' : band === 'low' ? 'Low intensity' : 'Mid intensity';
    return '<span class="vb-bws ' + band + '">' + label + '</span>';
  }
  // Legacy studies coded with the retired 1/2/3 layer.
  function intensityChip(i) {
    if (i == null) return '';
    var label = i === 3 ? 'Narrative' : i === 2 ? 'Elaborated' : 'Brief';
    return '<span class="vb-intensity i' + i + '">' + label + '</span>';
  }

  function renderCard(ex) {
    var html = '<div class="vb-card">';
    html += '<div class="vb-quote">&ldquo;' + escHtml(ex.quote) + '&rdquo;</div>';
    html += '<div class="vb-tags">';
    html += ex.bws != null ? bwsChip(ex.bws) : intensityChip(ex.intensity);
    html += '<span class="vb-tag code">' + escHtml(ex.code) + '</span>';
    ex.tags.forEach(function (t) {
      html += '<span class="vb-tag">' + escHtml(t) + '</span>';
    });
    html += '</div></div>';
    return html;
  }

  function openModal(chartId, barLabel) {
    var chart = (VX.charts || {})[chartId];
    if (!chart) return;
    var codeNames = (chart.bars || {})[barLabel];
    if (!codeNames) return;
    var qids = chart.qids || [];
    var codeSet = {};
    codeNames.forEach(function (cn) { codeSet[cn] = true; });

    var cards = [];
    (VX.participants || []).forEach(function (p) {
      qids.forEach(function (qid) {
        var pcodes = (p.c || {})[qid];
        if (!pcodes || !pcodes.length) return;
        var matched = null;
        for (var i = 0; i < pcodes.length; i++) {
          if (codeSet[pcodes[i]]) { matched = pcodes[i]; break; }
        }
        if (!matched) return;
        var verbatim = (p.v || {})[qid];
        if (!verbatim) return;
        var tags = [];
        TAGS.forEach(function (f) { if (p[f]) tags.push(p[f]); });
        cards.push({
          pid: p.pid,
          quote: verbatim,
          code: matched,
          bws: ((p.b || {})[qid] || {})[matched],
          intensity: ((p.i || {})[qid] || {})[matched],
          tags: tags,
        });
      });
    });

    // Heaviest-weighted quotes first, then stable participant order.
    cards.sort(function (a, b) {
      var wa = a.bws != null ? a.bws : (a.intensity != null ? (a.intensity - 2) / 2 : -2);
      var wb = b.bws != null ? b.bws : (b.intensity != null ? (b.intensity - 2) / 2 : -2);
      if (wa !== wb) return wb - wa;
      return (a.pid > b.pid) ? 1 : -1;
    });

    var uniquePids = {};
    cards.forEach(function (c) { uniquePids[c.pid] = true; });
    var nQuoted = Object.keys(uniquePids).length;

    var cohortLabel = chart.cohort || '';
    var cohortTotal = null;
    var m = /^(.*?)\s*\(n=(\d+)\)\s*$/.exec(cohortLabel);
    if (m) { cohortLabel = m[1]; cohortTotal = parseInt(m[2], 10); }

    subEl.textContent = chart.question || '';
    if (!cards.length) {
      titleEl.textContent = barLabel;
      bodyEl.innerHTML = '<p class="vb-empty">No participant quotes matched this theme.</p>';
    } else {
      titleEl.textContent = barLabel + '  ·  ' + nQuoted +
        (cohortTotal ? ' of ' + cohortTotal : '') +
        (cohortLabel ? ' ' + cohortLabel : '') + ' quoted';
      var intro = '<p class="vb-empty" style="margin:0 0 12px;font-size:12px;color:var(--muted);">' +
        'Showing ' + cards.length + (cards.length === 1 ? ' quote' : ' quotes') +
        ' from ' + nQuoted + ' participant' + (nQuoted === 1 ? '' : 's') +
        ' coded to this theme, heaviest-weighted first.</p>';
      bodyEl.innerHTML = intro + cards.map(renderCard).join('');
    }

    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  document.addEventListener('click', function (e) {
    var row = e.target.closest && e.target.closest('.bar-row, .scatter-point');
    if (!row) return;
    var container = row.closest('[data-drilldown-chart]');
    if (!container) return;
    var label = row.getAttribute('data-bar-label') || row.getAttribute('data-point-label');
    if (!label) return;
    openModal(container.getAttribute('data-drilldown-chart'), label);
  });
})();
</script>

<style is:global>
  .vb-overlay { display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 9999; }
  .vb-overlay.open { display: flex; justify-content: center; align-items: center; }
  .vb-dialog { background: var(--paper); border-radius: 10px; max-width: 760px; width: 94%; max-height: 86vh; display: flex; flex-direction: column; position: relative; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25); }
  .vb-close { position: absolute; top: 10px; right: 14px; background: none; border: none; font-size: 26px; line-height: 1; color: var(--muted); cursor: pointer; }
  .vb-close:hover { color: var(--ink); }
  .vb-header { padding: 20px 24px 12px; border-bottom: 1px solid var(--border); }
  .vb-header h3 { font-family: var(--serif); font-size: 18px; font-weight: 600; color: var(--ink); margin: 0 24px 4px 0; }
  .vb-q { font-size: 12.5px; color: var(--muted); font-style: italic; margin: 0; }
  .vb-body { padding: 16px 24px 20px; overflow-y: auto; }
  .vb-card { border: 1px solid var(--border); border-left: 3px solid var(--ink); border-radius: 0 6px 6px 0; padding: 12px 16px; margin-bottom: 12px; background: var(--card-bg); }
  .vb-quote { font-size: 14px; line-height: 1.6; color: var(--rule); }
  .vb-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .vb-tag { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: rgba(11, 31, 58, 0.07); color: var(--ink); }
  .vb-tag.code { background: rgba(11, 31, 58, 0.12); font-weight: 600; }
  .vb-bws { font-size: 11px; padding: 2px 8px; border-radius: 999px; font-weight: 600; }
  .vb-bws.high { background: rgba(184, 52, 27, 0.12); color: #B8341B; }
  .vb-bws.mid { background: rgba(196, 120, 74, 0.14); color: #8B5A1F; }
  .vb-bws.low { background: rgba(91, 100, 114, 0.14); color: #5B6472; }
  .vb-intensity { font-size: 11px; padding: 2px 8px; border-radius: 999px; font-weight: 600; }
  .vb-intensity.i3 { background: rgba(184, 52, 27, 0.12); color: #B8341B; }
  .vb-intensity.i2 { background: rgba(196, 120, 74, 0.14); color: #8B5A1F; }
  .vb-intensity.i1 { background: rgba(91, 100, 114, 0.14); color: #5B6472; }
  .vb-empty { font-size: 13px; color: var(--muted); }
  @media print { .vb-overlay { display: none !important; } }
</style>
