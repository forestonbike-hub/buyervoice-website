---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-brand">
      <a href="/internal/four-products-v1/" aria-label="KwantumLabs home">
        <img src="/images/kwantumlabs-logo.png" alt="KwantumLabs" width="140" height="35" />
      </a>
      <p class="footer-tagline">PhD-level market research at AI speed. Helping product and brand teams quantify what customers think, want, and will pay for.</p>
    </div>

    <div class="footer-col">
      <h4 class="footer-heading">Services</h4>
      <ul>
        <li><a href="/internal/four-products-v1/services/buyer-journey-analysis">Buyer Journey + Preferences</a></li>
        <li><a href="/internal/four-products-v1/services/brand-associations-csv">Brand Associations + CSV</a></li>
        <li><a href="/internal/four-products-v1/services/conjoint-pricing-packaging">Conjoint: Pricing and Packaging</a></li>
        <li><a href="/internal/four-products-v1/services/brand-csv-tracking">Brand + CSV Tracking</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="footer-heading">Learn</h4>
      <ul>
        <li><a href="/internal/four-products-v1/methodology/consumer-surplus-value">Methodology</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="footer-heading">Company</h4>
      <ul>
        <li><a href="/internal/four-products-v1/about">About</a></li>
        <li><a href="/internal/four-products-v1/contact">Contact</a></li>
        <li><a href="/internal/four-products-v1/privacy">Privacy Policy</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} KwantumLabs.ai. All rights reserved.</p>
    <a href="https://www.linkedin.com/company/kwantumlabs-ai" target="_blank" rel="noopener noreferrer" aria-label="KwantumLabs on LinkedIn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-light-gray);
    border-top: 1px solid var(--color-medium-gray);
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-xl);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer-tagline {
    font-size: 14px;
    color: var(--color-slate);
    margin-top: var(--space-md);
    max-width: 320px;
  }

  .footer-heading {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-black);
    margin-bottom: var(--space-md);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
  }

  .footer-col li {
    margin-bottom: var(--space-sm);
  }

  .footer-col a {
    font-size: 14px;
    color: var(--color-slate);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--color-green);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-medium-gray);
  }

  .footer-bottom p {
    font-size: 13px;
    color: var(--color-slate);
    margin: 0;
  }

  .footer-bottom a {
    color: var(--color-slate);
    transition: color 0.2s;
  }

  .footer-bottom a:hover {
    color: var(--color-green);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
