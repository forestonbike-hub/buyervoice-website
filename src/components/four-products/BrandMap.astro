// BrandMap.astro — correspondence analysis + brand attribute index heat map
// SVG viewBox: 0 0 1000 620
// Mapping: chartX [-1.7, 1.3] → svgX [50, 950] | chartY [-1.0, 2.1] → svgY [590, 30]
// svgX = 50 + (cx + 1.7) / 3.0 * 900
// svgY = 590 - (cy + 1.0) / 3.1 * 560

const AX = 560;
const AY = 409;

const brands = [
