---
interface Props {
  items: { number: string; label: string }[];
}

const { items } = Astro.props;
---

<div class="credential-bar section-gray">
  <div class="container credential-grid">
    {items.map(item => (
      <div class="credential">
        <span class="credential-number">{item.number}</span>
        <span class="credential-label">{item.label}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .credential-bar {
    padding: var(--space-2xl) 0;
  }

  .credential-grid {
    display: flex;
    justify-content: center;
    gap: 120px;
    flex-wrap: wrap;
  }

  .credential {
    text-align: center;
  }

  .credential-number {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(28px, 3vw, 40px);
    color: var(--color-green);
    line-height: 1.1;
  }

  .credential-label {
    display: block;
    font-size: 14px;
    color: var(--color-slate);
    margin-top: var(--space-xs);
  }

  @media (max-width: 640px) {
    .credential-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }
</style>
