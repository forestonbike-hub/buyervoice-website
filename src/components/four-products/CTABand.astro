---
interface Props {
  heading?: string;
}

const { heading = "Ready to talk?" } = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner">
    <h2>{heading}</h2>
    <div class="cta-actions">
      <a href="/internal/four-products-v1/contact" class="btn btn-white">Contact us</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background-color: var(--color-green);
    padding: var(--space-3xl) 0;
  }

  .cta-inner {
    text-align: center;
  }

  h2 {
    color: var(--color-white);
    font-size: clamp(24px, 3vw, 32px);
    margin-bottom: var(--space-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
</style>
