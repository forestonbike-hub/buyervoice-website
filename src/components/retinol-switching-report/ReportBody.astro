---
// ReportBody.astro, Retinol Switching study report body.
// Imported by BOTH the internal page (src/pages/internal/retinol-switching-report/)
// and the public page (src/pages/retinol-switching-report/).
//
// Visual language and section flow mirror hr-report and uk-neobanks-report
// per the canonical BuyerVoice report design: cover handled by ReportLayout,
// 8 accordion sections, INSIGHT/VULN/OPP callouts, color-coded inline bar
// charts, paired-bar comparisons, recommendation tables, drill-down modal.
import Section from '../report/Section.astro';
import reportStats from '../../data/retinol-switching/report-stats.json';
import verbatimData from '../../data/retinol-switching/verbatim-data.json';
import verbatimQuestions from '../../data/retinol-switching/verbatim-questions.json';

const d: any = reportStats;
const VD: any = verbatimData;
const VQ: any = verbatimQuestions;
const vdScript = '<script>window.__VD=' + JSON.stringify(VD).replace(/<\//g, '<\\/') + ';window.__VQ=' + JSON.stringify(VQ).replace(/<\//g, '<\\/') + ';<' + '/script>';

// Format helper: clean up code names that have brand acronyms
function pretty(label: string): string {
  return label
    .replace(/\bLrp\b/g, 'La Roche-Posay')
    .replace(/\bLRP\b/g, 'La Roche-Posay')
    .replace(/\bCerave\b/g, 'CeraVe')
    .replace(/\bCERAVE\b/g, 'CeraVe')
    .replace(/\bOlay Max\b/g, 'Olay MAX')
    .replace(/\bMax\b(?= )/g, 'MAX')
    .replace(/\bSpf\b/g, 'SPF')
    .replace(/\bTiktok\b/g, 'TikTok');
}

const sigStar = (p: number) => p < 0.10 ? '*' : '';
---

<style is:inline>
  /* Visual primitives lifted from hr-report and uk-neobanks-report. Scoped
     to .retinol-report so the visuals stay consistent across BuyerVoice
     reports. */
  .retinol-report .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 16px 0 24px; }
  .retinol-report .stat-card { text-align: center; padding: 16px; background: rgba(11, 31, 58, 0.04); border-radius: 8px; }
  .retinol-report .stat-num { font-family: var(--serif), Georgia, serif; font-size: 28px; font-weight: 600; color: var(--signal); }
  .retinol-report .stat-label { font-size: 11px; color: var(--muted); margin-top: 4px; line-height: 1.4; }
  .retinol-report .compact-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 18px 0; }
  .retinol-report .compact-stat { padding: 14px 12px; background: var(--card-bg, rgba(11, 31, 58, 0.04)); border: 1px solid var(--border, rgba(11, 31, 58, 0.10)); border-radius: 4px; }
  .retinol-report .compact-stat .csn { font-family: var(--serif), Georgia, serif; font-size: 22px; font-weight: 600; color: var(--signal); line-height: 1.1; }
  .retinol-report .compact-stat .csl { font-size: 11.5px; color: var(--rule); margin-top: 6px; line-height: 1.4; }

  .retinol-report .insight { border-left: 4px solid var(--signal); background: rgba(184, 52, 27, 0.06); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 16px 0; }
  .retinol-report .insight p { font-size: 13px; margin-bottom: 0; }
  .retinol-report .insight strong { color: var(--signal); }
  .retinol-report .vuln-callout { border-left: 4px solid #C4784A; background: rgba(196, 120, 74, 0.08); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 16px 0; }
  .retinol-report .vuln-callout p { font-size: 13px; margin-bottom: 0; }
  .retinol-report .vuln-callout strong { color: #C4784A; }
  .retinol-report .opp-callout { border-left: 4px solid #2A7A6E; background: rgba(42, 122, 110, 0.08); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 16px 0; }
  .retinol-report .opp-callout p { font-size: 13px; margin-bottom: 0; }
  .retinol-report .opp-callout strong { color: #2A7A6E; }

  .retinol-report .bar-chart { margin: 16px 0; }
  .retinol-report .bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .retinol-report .bar-label { width: 280px; font-size: 13px; font-weight: 500; text-align: right; flex-shrink: 0; }
  .retinol-report .bar-track { flex: 1; height: 24px; background: rgba(11, 31, 58, 0.06); border-radius: 4px; overflow: hidden; position: relative; }
  .retinol-report .bar-fill { height: 100%; border-radius: 4px; display: flex; align-items: center; justify-content: flex-end; padding-right: 8px; min-width: 36px; }
  .retinol-report .bar-fill.signal { background: var(--signal); }
  .retinol-report .bar-fill.ink { background: var(--ink); }
  .retinol-report .bar-fill.warm { background: #C4784A; }
  .retinol-report .bar-fill.slate { background: #5A7A94; }
  .retinol-report .bar-fill.teal { background: #2A7A6E; }
  .retinol-report .bar-fill.plum { background: #6B4C6E; }
  .retinol-report .bar-val { font-size: 11px; font-weight: 700; color: #fff; }
  .retinol-report .q-cite { display: block; font-family: var(--sans), system-ui, sans-serif; font-size: 12px; font-weight: 400; color: var(--muted); font-style: italic; margin-top: 2px; margin-bottom: 8px; }
  .retinol-report .source-note { font-size: 12px; color: var(--muted); margin-top: 8px; margin-bottom: 16px; }

  /* Tables */
  .retinol-report .rec-table { width: 100%; border-collapse: collapse; margin: 16px 0 24px; font-size: 13px; }
  .retinol-report .rec-table th { background: rgba(11, 31, 58, 0.04); text-align: left; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); padding: 10px 12px; border-bottom: 2px solid rgba(11, 31, 58, 0.12); }
  .retinol-report .rec-table td { padding: 10px 12px; border-bottom: 1px solid rgba(11, 31, 58, 0.06); vertical-align: top; }
  .retinol-report .rec-table td:first-child { font-weight: 600; width: 32%; }
  .retinol-report .nav-table { table-layout: fixed; width: 100%; }
  .retinol-report .nav-table th:first-child, .retinol-report .nav-table td:first-child { width: 60%; }
  .retinol-report .nav-table th:last-child, .retinol-report .nav-table td:last-child { width: 40%; text-align: right; padding-right: 4px; }

  /* Crosstab */
  .retinol-report .crosstab { margin: 16px 0; font-size: 13px; }
  .retinol-report .crosstab table { width: 100%; border-collapse: collapse; }
  .retinol-report .crosstab th, .retinol-report .crosstab td { padding: 8px 10px; text-align: right; white-space: nowrap; border-bottom: 1px solid rgba(11, 31, 58, 0.06); }
  .retinol-report .crosstab th:first-child, .retinol-report .crosstab td:first-child { text-align: left; font-weight: 500; }
  .retinol-report .crosstab th { background: rgba(11, 31, 58, 0.04); font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); border-bottom: 2px solid rgba(11, 31, 58, 0.12); }
  .retinol-report .crosstab .highlight { background: rgba(184, 52, 27, 0.10); font-weight: 700; color: var(--signal); }

  /* Paired bars (Arm 1 vs Arm 2) */
  .retinol-report .paired-block { display: grid; grid-template-columns: 220px 1fr 80px; align-items: center; gap: 16px; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid rgba(11, 31, 58, 0.06); }
  .retinol-report .paired-block:last-of-type { border-bottom: none; }
  .retinol-report .paired-theme { font-size: 13px; font-weight: 600; color: var(--ink); text-align: right; line-height: 1.3; }
  .retinol-report .paired-bars { display: flex; flex-direction: column; gap: 4px; }
  .retinol-report .paired-row { display: flex; align-items: center; gap: 8px; }
  .retinol-report .paired-mini-label { font-size: 11px; color: var(--muted); font-weight: 500; width: 130px; flex-shrink: 0; text-align: right; }
  .retinol-report .paired-track { flex: 1; height: 18px; background: rgba(11, 31, 58, 0.06); border-radius: 3px; overflow: hidden; }
  .retinol-report .paired-fill { height: 100%; display: flex; align-items: center; justify-content: flex-end; padding-right: 6px; min-width: 32px; border-radius: 3px; }
  .retinol-report .paired-fill.upgrader { background: var(--ink); }
  .retinol-report .paired-fill.defector { background: var(--signal); }
  .retinol-report .paired-val { font-size: 10.5px; font-weight: 700; color: #fff; }
  .retinol-report .paired-delta { font-size: 13px; font-weight: 600; text-align: right; color: var(--ink); }
  .retinol-report .paired-delta.pos { color: var(--signal); }
  .retinol-report .paired-delta.neg { color: var(--ink); }

  /* Drilldown affordance */
  .retinol-report [data-drilldown-chart] .bar-row { cursor: pointer; transition: opacity 0.15s; }
  .retinol-report [data-drilldown-chart] .bar-row:hover { opacity: 0.82; }
  .retinol-report [data-drilldown-chart] .bar-label { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .retinol-report [data-drilldown-chart] .paired-block { cursor: pointer; transition: opacity 0.15s; }
  .retinol-report [data-drilldown-chart] .paired-block:hover { opacity: 0.82; }
  .retinol-report [data-drilldown-chart] .paired-theme { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .retinol-report .vb-hint { font-size: 11.5px; color: var(--signal); font-weight: 500; }
  .retinol-report .vb-hint::before { content: '\203A  '; }

  /* Verbatim card list (brand description library) */
  .retinol-report .quote-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 16px 0; }
  @media (max-width: 720px) { .retinol-report .quote-grid { grid-template-columns: 1fr; } }
  .retinol-report .quote-card { background: rgba(11, 31, 58, 0.04); border-left: 3px solid var(--signal); padding: 12px 14px; border-radius: 0 6px 6px 0; }
  .retinol-report .quote-card .quote-text { font-family: var(--serif), Georgia, serif; font-style: italic; font-size: 13px; color: var(--rule); line-height: 1.55; margin-bottom: 8px; }
  .retinol-report .quote-card .quote-meta { font-size: 10.5px; color: var(--muted); }

  /* Section-body h2 (excluding accordion-title so accordion header keeps its tight spacing) */
  .retinol-report h2:not(.accordion-title) { font-family: var(--serif), Georgia, serif; font-size: 22px; font-weight: 600; color: var(--ink); margin-top: 28px; margin-bottom: 8px; letter-spacing: -0.02em; }
  .retinol-report h3 { font-family: var(--serif), Georgia, serif; font-size: 18px; font-weight: 600; color: var(--ink); margin-top: 24px; margin-bottom: 8px; letter-spacing: -0.02em; }
  .retinol-report h4 { font-family: var(--serif), Georgia, serif; font-size: 15px; font-weight: 600; color: var(--ink); margin-top: 16px; margin-bottom: 6px; letter-spacing: -0.02em; }
  .retinol-report p { font-size: 14px; line-height: 1.6; margin-bottom: 12px; }
  .retinol-report ul, .retinol-report ol { margin: 8px 0 16px 20px; }
  .retinol-report li { font-size: 14px; line-height: 1.6; margin-bottom: 6px; }

  .retinol-report .source-legend { display: flex; gap: 18px; align-items: center; font-size: 11px; color: var(--muted); margin: 8px 0 12px 236px; }
  .retinol-report .source-legend .leg-swatch { display: inline-block; width: 12px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
  .retinol-report .source-legend .leg-swatch.upgrader { background: var(--ink); }
  .retinol-report .source-legend .leg-swatch.defector { background: var(--signal); }

  /* Verbatim drill-down modal (matches uk-neobanks pattern) */
  .vb-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 9999; }
  .vb-overlay.open { display: flex; justify-content: center; align-items: center; }
  .vb-dialog { background: var(--paper); border-radius: 10px; max-width: 760px; width: 94%; max-height: 86vh; display: flex; flex-direction: column; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.25); }
  .vb-close { position: absolute; top: 8px; right: 12px; background: none; border: none; font-size: 26px; line-height: 1; cursor: pointer; color: var(--muted); padding: 4px 8px; }
  .vb-close:hover { color: var(--ink); }
  .vb-header { padding: 22px 28px 8px; border-bottom: 1px solid var(--border); }
  .vb-header h3 { font-family: var(--serif), Georgia, serif; font-size: 18px; font-weight: 600; color: var(--ink); margin: 0 0 4px; line-height: 1.3; }
  .vb-q { font-size: 12.5px; color: var(--muted); margin: 0; font-style: italic; line-height: 1.45; }
  .vb-body { padding: 16px 28px 22px; overflow-y: auto; }
  .vb-card { background: rgba(11,31,58,0.04); border-left: 3px solid var(--signal); padding: 14px 16px; border-radius: 0 6px 6px 0; margin-bottom: 12px; }
  .vb-card .vb-quote { font-family: var(--serif), Georgia, serif; font-style: italic; font-size: 14px; color: var(--rule); line-height: 1.6; margin-bottom: 10px; }
  .vb-card .vb-tags { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .vb-tag { font-size: 10.5px; background: rgba(11,31,58,0.08); color: var(--rule); padding: 2px 9px; border-radius: 10px; font-weight: 500; }
  .vb-tag.brand { background: rgba(184,52,27,0.12); color: var(--signal); font-weight: 600; }
  .vb-empty { font-size: 13px; color: var(--muted); }

  /* Stimulus figure (Section 4 packaging perceptions). The image
     reproduces what every participant saw before answering the four
     perception questions, so the reader can visually anchor on the
     same competitive set the participants did. */
  .retinol-report .stimulus { margin: 18px 0 24px; padding: 0; }
  .retinol-report .stimulus img { width: 100%; max-width: 720px; height: auto; display: block; margin: 0 auto; border: 1px solid var(--border, rgba(11, 31, 58, 0.10)); border-radius: 6px; background: #fff; }
  .retinol-report .stimulus figcaption { font-size: 12px; color: var(--muted); font-style: italic; margin-top: 10px; text-align: center; max-width: 720px; margin-left: auto; margin-right: auto; line-height: 1.5; }

  @media print {
    .retinol-report .insight { background: rgba(184, 52, 27, 0.06) !important; border-left: 4px solid var(--signal) !important; }
    .retinol-report .vuln-callout { background: rgba(196, 120, 74, 0.08) !important; border-left: 4px solid #C4784A !important; }
    .retinol-report .opp-callout { background: rgba(42, 122, 110, 0.08) !important; border-left: 4px solid #2A7A6E !important; }
    .retinol-report .bar-fill.signal { background: var(--signal) !important; }
    .retinol-report .bar-fill.ink { background: var(--ink) !important; }
    .retinol-report .bar-fill.warm { background: #C4784A !important; }
    .retinol-report .bar-fill.slate { background: #5A7A94 !important; }
    .retinol-report .bar-fill.teal { background: #2A7A6E !important; }
    .retinol-report .bar-fill.plum { background: #6B4C6E !important; }
    .retinol-report [data-drilldown-chart] .bar-label { text-decoration: none !important; }
    .retinol-report [data-drilldown-chart] .paired-theme { text-decoration: none !important; }
    .retinol-report .vb-hint { display: none !important; }
    .retinol-report .paired-fill.upgrader { background: var(--ink) !important; }
    .retinol-report .paired-fill.defector { background: var(--signal) !important; }
    .vb-overlay { display: none !important; }
  }
</style>

<div class="retinol-report">

<!-- ============================================================ -->
<!-- 01, EXECUTIVE SUMMARY -->
<!-- ============================================================ -->
<Section title="Executive Summary" subtitle="Olay's strategic position at the graduation moment, six critical findings, and three highest-leverage decisions">
  <h2>The Olay Strategic Position</h2>
  <p>
    Olay Regenerist Retinol 24 is the brand's primary entry point into the 35-43 cohort and its primary defection point. After 6 to 18 months of use, women experience one of two outcomes at the graduation moment: they upgrade within Olay to Retinol 24 MAX, or they defect to a competitor brand. This study interviewed 240 women evenly split across both arms. The headline finding is that <strong>Olay's loyalty is held by inertia, not by active engagement</strong>. Women who actively engage with the retinoid category, who research ingredients on Reddit and TikTok, who follow dermatologist content, who read up on serum-versus-moisturizer formulation, defect at substantially higher rates. Women who treat skincare as a low-effort drugstore replenishment stay with Olay. The brand currently retains the disengaged half of its customer base; the engaged half is converting to CeraVe and La Roche-Posay at scale.
  </p>

  <h2>Four Hero Numbers</h2>
  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-num">{d.info_channels.find((c: any) => c.display_label.includes('Reddit'))?.arm2_pct ?? 85}%</div>
      <div class="stat-label">Of defectors used Reddit to research the switch (vs {d.info_channels.find((c: any) => c.display_label.includes('Reddit'))?.arm1_pct ?? 43}% of upgraders)</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">{d.trigger_taxonomy.find((c: any) => c.display_label.includes('Content-driven'))?.arm2_pct ?? 73}%</div>
      <div class="stat-label">Of defectors cite social media content as a switching catalyst (vs {d.trigger_taxonomy.find((c: any) => c.display_label.includes('Content-driven'))?.arm1_pct ?? 31}% of upgraders)</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">{d.arm2_considered_max.pct}%</div>
      <div class="stat-label">Of defectors considered Olay Retinol 24 MAX and rejected it for a competitor</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">98%</div>
      <div class="stat-label">Of all participants picked La Roche-Posay as the package conveying high-quality ingredients</div>
    </div>
  </div>

  <h2>Six Critical Findings</h2>

  <div class="vuln-callout">
    <p><strong>1. Defectors are research-engaged. Upgraders are not.</strong> 85% of defectors used Reddit during the decision (vs 43% of upgraders, p&lt;0.001). 25% of defectors followed TikTok dermatologist content (vs 4% of upgraders, p&lt;0.001). 18% consulted a dermatologist directly (vs 8%, p=0.02). The asymmetry is consistent across every research channel measured. This is not a marginal pattern. It is the organizing principle of the defection. <em>Owner: Brand &amp; Marketing.</em></p>
  </div>

  <div class="vuln-callout">
    <p><strong>2. The defection isn't an awareness problem; it's a positioning problem.</strong> {d.arm2_considered_max.pct}% of defectors considered Olay Retinol 24 MAX during their decision, then chose a competitor. Olay MAX appeared in the consideration set; the brand simply lost the comparison. The diagnosis is not "make defectors aware of MAX," they are aware. It is "give defectors a reason to choose MAX once they see it." <em>Owner: Brand &amp; Marketing + Product.</em></p>
  </div>

  <div class="insight">
    <p><strong>3. Triggers are arm-asymmetric in a way that reveals the strategic vulnerability.</strong> Defectors trigger primarily on content discovery (73% vs 31%, p&lt;0.001) and dermatologist credibility cues. Upgraders trigger on plateau-with-Retinol-24 (52% vs 25%, p&lt;0.001) and brand-trust continuity. This means defection happens when active engagement meets a credible alternative, while upgraders move only when their current product clearly stops working. Olay retains the cohort that doesn't shop the category. <em>Owner: Brand &amp; Marketing.</em></p>
  </div>

  <div class="vuln-callout">
    <p><strong>4. The "format upgrade" frame is a structural gap in Olay's portfolio.</strong> Defectors articulate a hypothesis about retinol delivery: dedicated serums in airless or dropper packaging are perceived as more effective than retinol-in-moisturizer formats. The jar is named in nearly every initial-experience response across both arms as a friction point. Olay does not currently field a serum-format retinoid product in this competitive set, while CeraVe, La Roche-Posay, The Ordinary, and Naturium all do. The format choice is a positioning lever Olay has not pulled. <em>Owner: Product &amp; Portfolio.</em></p>
  </div>

  <div class="insight">
    <p><strong>5. Brand trust holds upgraders specifically because Retinol 24 was tolerated.</strong> The dominant upgrader logic is risk minimization: "I know my skin handles Olay; the MAX is a smaller jump than a brand switch." This is a real defense, not just inertia, especially among participants with sensitive or melanin-rich skin who explicitly cite post-inflammatory hyperpigmentation risk. The defense breaks the moment a defector finds a credibly tolerable alternative with a stronger ingredient story. <em>Owner: Brand &amp; Marketing.</em></p>
  </div>

  <div class="opp-callout">
    <p><strong>6. The graduation ladder is the cohort's mental model, and it ends at prescription tretinoin (not in-office procedures).</strong> Across both arms, the forward trajectory is dominated by routine expansion (89%) and ingredient additions (peptides, retinaldehyde, vitamin C, niacinamide). 42% mention prescription tretinoin as a future goal. In-office procedures are largely deferred for cost reasons. The graduation framing offers Olay a clear narrative spine: the cohort wants a step-up retinoid path, ideally with a serum format and a credible ingredient story, before they age out toward prescription. <em>Owner: Product &amp; Portfolio.</em></p>
  </div>

  <h2>Three Strategic Decisions</h2>
  <table class="rec-table">
    <thead><tr><th>Decision</th><th>Recommendation</th></tr></thead>
    <tbody>
      <tr>
        <td>1. Does Olay need a step-up retinoid product beyond MAX?</td>
        <td><strong>Yes, in serum format.</strong> The "format upgrade" hypothesis is real in the data, the jar friction is universal, and Olay does not currently compete in the serum lane where defectors are landing. A dedicated retinol serum with airless packaging and a higher concentration story closes the structural gap.</td>
      </tr>
      <tr>
        <td>2. Is MAX visible enough to women who are graduating from Retinol 24?</td>
        <td><strong>MAX is visible; it loses on positioning, not awareness.</strong> Defectors saw MAX, considered it, and chose a competitor (59%). The fix is not increased media weight on MAX, it is a sharper ingredient-story articulation that competes with CeraVe and La Roche-Posay on dermatologist-credibility cues, not on Olay-brand familiarity.</td>
      </tr>
      <tr>
        <td>3. Should the next big bet be a stronger retinoid or a longevity-platform product?</td>
        <td><strong>Stronger retinoid first; longevity platform 18 to 24 months out.</strong> The cohort is still mentally on the retinoid graduation ladder. Peptides and exosomes appear in the radar but with curiosity rather than conviction. The retinoid lane has 12 to 18 months of unfilled product opportunity before the cohort migrates to longevity narratives.</td>
      </tr>
    </tbody>
  </table>

  <h2>Report Navigation</h2>
  <table class="rec-table nav-table">
    <thead><tr><th>Section</th><th>Primary Audience</th></tr></thead>
    <tbody>
      <tr><td>02. The Graduation Moment: Why Women Switch</td><td>All teams</td></tr>
      <tr><td>03. The Decision Process: Channels, Consideration, Drivers</td><td>Brand &amp; Marketing, Product</td></tr>
      <tr><td>04. Packaging Perceptions: Olay MAX vs CeraVe vs La Roche-Posay</td><td>Brand &amp; Marketing, Product</td></tr>
      <tr><td>05. Brand &amp; Marketing Recommendations</td><td>Brand &amp; Marketing</td></tr>
      <tr><td>06. Product &amp; Portfolio Recommendations</td><td>Product &amp; Innovation</td></tr>
      <tr><td>07. Forward Trajectory &amp; Retention Risk</td><td>All teams</td></tr>
      <tr><td>08. Methodology</td><td>All teams</td></tr>
    </tbody>
  </table>
</Section>

<!-- ============================================================ -->
<!-- 02, THE GRADUATION MOMENT -->
<!-- ============================================================ -->
<Section title="The Graduation Moment: Why Women Switch" subtitle="The Retinol 24 experience, the trigger taxonomy, and the asymmetric switching logic across the two arms">
  <p>
    Every participant in this study had used Olay Regenerist Retinol 24, the purple jar, for at least three months and then switched away within the past three months. They had positive things to say about Retinol 24 and reasons to leave it. Both arms describe a strikingly similar product experience; what differs is what happens at the graduation moment.
  </p>

  <h2>2a. What Worked About Retinol 24</h2>
  <p>The product earned its retention. Both arms describe early texture improvement, gentle tolerability, and accessible price. Where the arms diverge is in the depth of positive sentiment overall.</p>
  <p class="source-note">Source question: "Tell me about your experience using Retinol 24. What did you like or dislike about it?" Bars show the share of each arm who mentioned the theme positively. <span class="vb-hint">Click any theme to read participant quotes.</span></p>
  <div class="source-legend">
    <span><span class="leg-swatch upgrader"></span>Arm 1 Upgraders (n={d.n_arm1})</span>
    <span><span class="leg-swatch defector"></span>Arm 2 Defectors (n={d.n_arm2})</span>
  </div>
  <div class="paired-chart" data-drilldown-chart="q1_likes">
    {d.q1_likes.slice(0, 7).map((row: any) => (
      <div class="paired-block" data-code-name={row.code} data-qid="Q1">
        <div class="paired-theme">{pretty(row.code)}</div>
        <div class="paired-bars">
          <div class="paired-row">
            <span class="paired-mini-label">Upgraders</span>
            <div class="paired-track">
              {row.arm1_pct > 0 && <div class="paired-fill upgrader" style={`width: ${row.arm1_pct}%;`}>
                <span class="paired-val">{row.arm1_pct}%</span>
              </div>}
            </div>
          </div>
          <div class="paired-row">
            <span class="paired-mini-label">Defectors</span>
            <div class="paired-track">
              {row.arm2_pct > 0 && <div class="paired-fill defector" style={`width: ${row.arm2_pct}%;`}>
                <span class="paired-val">{row.arm2_pct}%</span>
              </div>}
            </div>
          </div>
        </div>
        <div class={`paired-delta ${row.arm2_pct - row.arm1_pct > 0 ? 'pos' : 'neg'}`}>
          {row.arm2_pct - row.arm1_pct > 0 ? '+' : ''}{row.arm2_pct - row.arm1_pct} pp{sigStar(row.p_value)}
        </div>
      </div>
    ))}
  </div>
  <p class="source-note">Asterisk on the delta indicates the upgrader vs defector difference is statistically significant at alpha=0.10 (two-proportion z-test, two-tailed).</p>
  <div class="insight">
    <p><strong>Read:</strong> Upgraders carry stronger overall-positive sentiment about Retinol 24 (95% vs 64% positive overall, p&lt;0.001) and notice the early texture improvement at higher rates. Both arms agree on tolerability and on Olay-brand familiarity. The difference is not that defectors hated the product. It is that defectors set the bar higher, recognized when the product stopped clearing it, and moved on.</p>
  </div>

  <h2>2b. What Fell Short</h2>
  <p>Both arms describe the same Retinol 24 friction profile: the efficacy plateau around month five or six, the jar packaging concern, the desire for stronger results. The fact that defectors and upgraders share the same dissatisfaction profile but choose different responses is what makes this study analytically valuable.</p>
  <p class="source-note">Source question: "Tell me about your experience using Retinol 24. What did you like or dislike about it?" Bars show the share of each arm who mentioned the theme as a friction point. <span class="vb-hint">Click any theme to read participant quotes.</span></p>
  <div class="paired-chart" data-drilldown-chart="q1_dislikes">
    {d.q1_dislikes.slice(0, 6).map((row: any) => (
      <div class="paired-block" data-code-name={row.code} data-qid="Q1">
        <div class="paired-theme">{pretty(row.code)}</div>
        <div class="paired-bars">
          <div class="paired-row">
            <span class="paired-mini-label">Upgraders</span>
            <div class="paired-track">
              {row.arm1_pct > 0 && <div class="paired-fill upgrader" style={`width: ${row.arm1_pct}%;`}>
                <span class="paired-val">{row.arm1_pct}%</span>
              </div>}
            </div>
          </div>
          <div class="paired-row">
            <span class="paired-mini-label">Defectors</span>
            <div class="paired-track">
              {row.arm2_pct > 0 && <div class="paired-fill defector" style={`width: ${row.arm2_pct}%;`}>
                <span class="paired-val">{row.arm2_pct}%</span>
              </div>}
            </div>
          </div>
        </div>
        <div class={`paired-delta ${row.arm2_pct - row.arm1_pct > 0 ? 'pos' : 'neg'}`}>
          {row.arm2_pct - row.arm1_pct > 0 ? '+' : ''}{row.arm2_pct - row.arm1_pct} pp{sigStar(row.p_value)}
        </div>
      </div>
    ))}
  </div>
  <div class="vuln-callout">
    <p><strong>The jar is a universal friction point.</strong> Across both arms, women describe oxidation worry (light and air degrading the active retinol) and finger-contact hygiene anxiety. The jar format itself is the friction; this carries over into the perception of the MAX product, which is also a moisturizer in jar packaging. A serum-format step-up product would address an articulated dissatisfaction Olay currently leaves unanswered.</p>
  </div>

  <h2>2c. The Trigger Taxonomy</h2>
  <p>What pushes a participant from passive dissatisfaction into action? The brief proposed six trigger categories; the data clusters them into a clear arm asymmetry. Defectors are content-driven and dermatologist-influenced. Upgraders are product-dissatisfaction-driven, with a "my Retinol 24 stopped working, my sister recommended MAX" narrative.</p>
  <p class="source-note">Source question: "What prompted your switch? Was there anything going on in your life more broadly that was a factor in switching skincare products? Was there a specific event or situation that was a factor?" <span class="vb-hint">Click any trigger to read participant quotes.</span></p>
  <div class="paired-chart" data-drilldown-chart="trigger_taxonomy">
    {d.trigger_taxonomy.slice(0, 9).map((row: any) => (
      <div class="paired-block" data-code-name={row.code} data-qid="Q3">
        <div class="paired-theme">{pretty(row.display_label)}</div>
        <div class="paired-bars">
