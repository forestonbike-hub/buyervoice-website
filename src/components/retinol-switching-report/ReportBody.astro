<Fragment set:html={vdScript} />

<script is:inline>
  (function () {
    const overlay = document.getElementById('vb-overlay');
    const title = document.getElementById('vb-title');
    const qel = document.getElementById('vb-question');
    const body = document.getElementById('vb-body');
    const closeBtn = document.getElementById('vb-close');
    if (!overlay || !title || !qel || !body || !closeBtn) return;

    function close() {
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    function brandLabel(brand) {
      if (!brand) return '';
      if (brand.toLowerCase().includes('olay retinol 24 max')) return 'Olay MAX';
      if (brand.toLowerCase().includes('cerave')) return 'CeraVe';
      if (brand.toLowerCase().includes('la roche')) return 'La Roche-Posay';
      return brand;
    }

    document.addEventListener('click', (e) => {
      const target = e.target;
      const block = target.closest('[data-code-name][data-qid]');
      if (!block) return;
      const chartContainer = block.closest('[data-drilldown-chart]');
      if (!chartContainer) return;

      const code = block.getAttribute('data-code-name');
      const qid = block.getAttribute('data-qid');
      const key = qid + '::' + code;
      const quotes = (window.__VD || {})[key] || [];
      const qtext = (window.__VQ || {})[qid] || '';

      title.textContent = code + (quotes.length ? ' (n=' + quotes.length + ' participants)' : '');
      qel.textContent = qtext ? 'Source question: ' + qtext : '';

      if (!quotes.length) {
        body.innerHTML = '<p class="vb-empty">No quotes captured for this code in this question. The drilldown only surfaces quotes from segments where the coder applied this exact (question, code) pair.</p>';
      } else {
        // Sort by intensity desc and show ALL quotes for this (question, code)
        // pair. Earlier versions capped at 8; that hid the bulk of evidence
        // for high-prevalence codes (e.g. "Multiple Factors Converging" has
        // ~175 of 240 participants). Full quotes, no per-quote truncation,
        // so the reader can see the entire response in context.
        const sorted = quotes.slice().sort((a, b) => (b.intensity || 0) - (a.intensity || 0));
        body.innerHTML = sorted.map((q) => {
          const txt = q.text || '';
          const tags = [
            q.arm === 'U' ? 'Upgrader' : 'Defector',
            brandLabel(q.brand),
            q.age,
            q.income,
            q.ethnicity,
          ].filter(Boolean);
          const tagsHtml = tags.map((t, i) => '<span class="vb-tag' + (i === 1 ? ' brand' : '') + '">' + t + '</span>').join('');
          return '<div class="vb-card"><p class="vb-quote">' + txt + '</p><div class="vb-tags">' + tagsHtml + '</div></div>';
        }).join('');
      }
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  })();
</script>
