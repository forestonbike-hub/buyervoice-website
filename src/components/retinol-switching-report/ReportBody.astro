              <td class={all['CeraVe Resurfacing Retinol Serum'].pct === max ? 'highlight' : ''}>{all['CeraVe Resurfacing Retinol Serum'].pct}%</td>
              <td class={all['La Roche-Posay Pure Retinol B3 Serum'].pct === max ? 'highlight' : ''}>{all['La Roche-Posay Pure Retinol B3 Serum'].pct}%</td>
