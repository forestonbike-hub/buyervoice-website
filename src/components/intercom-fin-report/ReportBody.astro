  .ifr-report .q-cite { display: block; font-family: var(--sans); font-size: 12px; font-weight: 400; color: var(--muted); font-style: italic; margin: 4px 0 16px; line-height: 1.5; }
  .ifr-report .bar-chart-container { margin: 16px 0; }
  .ifr-report .bar-row { display: flex; align-items: center; gap: 12px; padding: 5px 0; font-size: 13px; }
  .ifr-report .bar-label { flex: 0 0 200px; color: var(--ink); font-weight: 500; }
  .ifr-report .bar-track { flex: 1; height: 22px; background: rgba(11, 31, 58, 0.06); border-radius: 2px; position: relative; }
  /* Bar fill width is the raw percentage; no min-width so bars accurately
     reflect their value (a 0% or 1% bar is genuinely tiny). The percentage
     label sits inside the fill (right-aligned, white) when the fill is
     wide enough; when the fill is too narrow the label still shows but
