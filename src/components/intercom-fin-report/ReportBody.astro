  .ifr-report .plat-tag.zd { background: var(--ink); color: var(--paper); }
  .ifr-report .plat-tag.sf { background: var(--signal); color: var(--paper); }
  @media (max-width: 700px) { .ifr-report .subtheme-row { grid-template-columns: 1fr; gap: 8px; } }

  /* Two playbooks summary (Sales section opener) */
  .ifr-report .playbooks { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 16px 0; }
  .ifr-report .playbook { padding: 18px 22px; border-radius: 8px; border-left: 4px solid; background: rgba(11, 31, 58, 0.03); }
  .ifr-report .playbook.zd { border-left-color: var(--ink); }
  .ifr-report .playbook.sf { border-left-color: var(--signal); }
  .ifr-report .playbook-title { font-family: var(--serif); font-size: 15px; font-weight: 600; margin: 0 0 4px; color: var(--ink); }
  .ifr-report .playbook-n { font-size: 11px; color: var(--muted); margin-bottom: 12px; }
  .ifr-report .playbook-row { display: grid; grid-template-columns: 100px 1fr; gap: 8px; padding: 4px 0; font-size: 12px; }
  .ifr-report .playbook-row .pb-key { color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; font-size: 10px; padding-top: 2px; }
  .ifr-report .playbook-row .pb-val { color: var(--ink); line-height: 1.4; }
  @media (max-width: 700px) { .ifr-report .playbooks { grid-template-columns: 1fr; } }

  /* Click-to-view-quotes affordance: any chart row inside a
     [data-drilldown-chart] container shows a pointer cursor and the bar
     label gets a signal-red underline to indicate interactivity. Both
     the .gbc-row (grouped bar chart, the dominant pattern in this report)
     and .bar-row (single-color bar chart, used in the two-panel likely-
     choice and the small replatform-aggregate chart) trigger the modal. */
  .ifr-report [data-drilldown-chart] .gbc-row,
  .ifr-report [data-drilldown-chart] .bar-row { cursor: pointer; transition: opacity 0.15s; }
  .ifr-report [data-drilldown-chart] .gbc-row:hover,
  .ifr-report [data-drilldown-chart] .bar-row:hover { opacity: 0.82; }
  .ifr-report [data-drilldown-chart] .gbc-label,
  .ifr-report [data-drilldown-chart] .bar-label { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  /* The Sales motion chart's first row is "Fin likely-choice rate", not
     a thematic code, so opt out of the drilldown affordance for that row. */
  .ifr-report [data-drilldown-chart] .gbc-row[data-no-drill],
  .ifr-report [data-drilldown-chart] .bar-row[data-no-drill] { cursor: default; }
  .ifr-report [data-drilldown-chart] .gbc-row[data-no-drill] .gbc-label,
  .ifr-report [data-drilldown-chart] .bar-row[data-no-drill] .bar-label { text-decoration: none; }

  /* Drilldown hint embedded as red signal text inside the source-note line,
     prefixed with a › guillemet, matching retail-banking-report and
     uk-neobanks-report. */
  .ifr-report .vb-hint { font-size: 11.5px; color: var(--signal); font-weight: 500; }
  .ifr-report .vb-hint::before { content: '\203A  '; }

  /* Verbatim drill-down modal. Hidden by default; the click handler adds
     the .open class. Visual style mirrors hr-report (the canonical
     BuyerVoice modal design): paper background, signal-red left border on
     each card, sans italic quote text, neutral tag badges. */
  .vb-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; }
  .vb-overlay.open { display: flex; justify-content: center; align-items: center; }
  .vb-dialog { background: var(--paper); border-radius: 12px; max-width: 760px; width: 95%; max-height: 85vh; display: flex; flex-direction: column; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.25); }
  .vb-close { position: absolute; top: 8px; right: 12px; background: none; border: none; font-size: 26px; line-height: 1; cursor: pointer; color: var(--muted); padding: 4px 8px; }
  .vb-close:hover { color: var(--ink); }
  .vb-header { padding: 20px 24px 12px; border-bottom: 1px solid rgba(11,31,58,0.10); }
  .vb-header h3 { font-family: var(--serif), Georgia, serif; font-size: 18px; font-weight: 600; color: var(--ink); margin: 0; line-height: 1.3; }
  .vb-q { font-size: 13px; color: var(--muted); margin: 4px 0 0; font-style: italic; line-height: 1.45; }
  .vb-body { padding: 16px 24px 24px; overflow-y: auto; flex: 1; }
  .vb-card { background: rgba(11,31,58,0.04); border-left: 3px solid var(--signal); padding: 14px 16px; border-radius: 0 6px 6px 0; margin-bottom: 12px; }
  .vb-card .vb-quote { font-style: italic; font-size: 13px; color: var(--rule); line-height: 1.6; margin-bottom: 8px; }
  .vb-card .vb-more { font-size: 12px; color: var(--signal); cursor: pointer; border: none; background: none; padding: 0; margin-bottom: 8px; font-weight: 500; }
  .vb-card .vb-more:hover { text-decoration: underline; }
  .vb-card .vb-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .vb-tag { font-size: 11px; background: rgba(11,31,58,0.08); color: var(--rule); padding: 2px 8px; border-radius: 10px; }
  .vb-empty { font-size: 13px; color: var(--muted); }

  @media print {
    .ifr-report [data-drilldown-chart] .gbc-label,
