  /* Grouped bar chart, paired Zendesk vs Salesforce bars per theme.
     Used for per-platform theme-prevalence charts throughout the report. */
  .ifr-report .gbc { margin: 16px 0 8px; }
  .ifr-report .gbc-header { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; margin-bottom: 10px; }
