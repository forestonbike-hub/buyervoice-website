  .ifr-report .gbc-swatch.sf { background: var(--signal); }
  .ifr-report .gbc-rows { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 12px 0; position: relative; }
  .ifr-report .gbc-row { display: grid; grid-template-columns: 220px 1fr; gap: 12px; align-items: center; padding: 4px 0; }
  .ifr-report .gbc-label { font-size: 12px; color: var(--ink); font-weight: 500; line-height: 1.3; }
  .ifr-report .gbc-pair { display: flex; flex-direction: column; gap: 3px; }
  /* No gbc-tag column: bars sit flush against the theme column. The legend at the top of the chart identifies which color is which platform. */
  .ifr-report .gbc-bar { display: grid; grid-template-columns: 1fr; gap: 0; align-items: center; }
  /* Per-chart overrides not needed since the default .gbc-bar already drops the tag column. */
  .ifr-report .gbc-tag { font-size: 9px; font-weight: 700; letter-spacing: 0.05em; color: var(--muted); text-transform: uppercase; }
  .ifr-report .gbc-track { height: 18px; background: rgba(11, 31, 58, 0.06); border-radius: 2px; position: relative; }
  /* No min-width: bars genuinely scale to their percentage. */
  .ifr-report .gbc-fill { height: 100%; border-radius: 2px; display: flex; align-items: center; justify-content: flex-end; padding-right: 5px; color: #fff; font-size: 11px; font-weight: 600; overflow: visible; }
  /* External label that sits to the right of the fill end, used when the
     fill is too narrow to show the value inside. Positioned absolutely
     against the gbc-track. */
  .ifr-report .bar-val-out { position: absolute; top: 50%; transform: translateY(-50%); font-size: 11px; font-weight: 600; color: var(--ink); white-space: nowrap; pointer-events: none; }
  /* Inside-bar percentage labels are pure white. They only render when
     the bar is wide enough to fit them (BarCell handles the gating);
     when the bar is too narrow, the .bar-val-out external label below
     is rendered instead. */
  .ifr-report .gbc-fill .bar-val,
  .ifr-report .bar-fill .bar-val { color: #fff; }
  /* External label, positioned absolutely against the track at the
     fill's right edge. Rendered for narrow bars (< 8%) and zero bars
     so the value stays visible. */
  .ifr-report .gbc-track .bar-val-out,
  .ifr-report .bar-track .bar-val-out { position: absolute; top: 50%; transform: translateY(-50%); font-size: 11px; font-weight: 600; color: var(--ink); white-space: nowrap; pointer-events: none; }
  .ifr-report .gbc-fill.zd { background: var(--ink); }
  .ifr-report .gbc-fill.sf { background: var(--signal); }
  .ifr-report .gbc-avg-line { position: absolute; top: 0; bottom: 0; border-left: 1px dashed var(--muted); pointer-events: none; }
  .ifr-report .gbc-avg-label { position: absolute; top: -16px; transform: translateX(-50%); font-size: 9px; letter-spacing: 0.04em; color: var(--muted); white-space: nowrap; background: var(--paper); padding: 0 3px; }
  .ifr-report .gbc-footnote { font-size: 11px; color: var(--muted); font-style: italic; margin: 8px 0 0; line-height: 1.5; }
  @media (max-width: 700px) { .ifr-report .gbc-row { grid-template-columns: 1fr; } }

  /* Two-panel layout (e.g. likely-choice for Section 03) */
  .ifr-report .two-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 16px 0; }
  .ifr-report .two-panel .panel { background: rgba(11, 31, 58, 0.03); padding: 18px 20px; border-radius: 8px; border: 1px solid var(--border); }
  .ifr-report .two-panel .panel-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12px; }
  .ifr-report .two-panel .panel-title { font-family: var(--serif); font-size: 15px; font-weight: 600; color: var(--ink); }
  .ifr-report .two-panel .panel-n { font-size: 12px; color: var(--muted); }
  @media (max-width: 700px) { .ifr-report .two-panel { grid-template-columns: 1fr; } }

  /* Sub-theme drill-down block (Customer Insights, below push-force charts).
