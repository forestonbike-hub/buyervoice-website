        var verbatim = (p.v || {})[qid];
        if (!verbatim) return;
        var intensity = ((p.i || {})[qid] || {})[matched] || 2;
        cards.push({
          pid: p.pid,
          qid: qid,
          quote: verbatim,
          intensity: intensity,
          platform: p.platform,
          wave: p.wave,
          size: p.size,
          industry: p.industry,
          role: p.role,
          code: matched,
        });
      });
    });

    // Sort by intensity desc (most narrative-weighted first), then pid stable
    cards.sort(function (a, b) {
      var ia = a.intensity || 0;
      var ib = b.intensity || 0;
      if (ia !== ib) return ib - ia;
      return a.pid - b.pid;
    });

    // Title shows the actual count of unique participants matched, not the
    // chart's overall cohort n. Cards may include same pid at multiple qids
    // (e.g. fin-pull-w1 spans w1_Q6 + w1_Q9), so dedupe by pid for the
    // count. Matches the hr-report modal title format.
    var pidSet = {};
    cards.forEach(function (c) { pidSet[c.pid] = true; });
    var nUnique = 0;
    for (var k in pidSet) { if (Object.prototype.hasOwnProperty.call(pidSet, k)) nUnique++; }
    titleEl.textContent = barLabel + ' (' + nUnique + ' participant' + (nUnique !== 1 ? 's' : '') + ')';
    subEl.textContent = chart.question || '';

    bodyEl.innerHTML = '';
    if (cards.length === 0) {
      bodyEl.innerHTML = '<p class="vb-empty">No participant quotes matched this theme.</p>';
    } else {
      cards.forEach(function (ex) {
        var card = document.createElement('div');
        card.className = 'vb-card';

        var fullText = ex.quote || '';
        var truncated = fullText.length > 500;
        var shortText = truncated ? fullText.substring(0, 500).replace(/\s+\S*$/, '') + '...' : fullText;

        var quoteDiv = document.createElement('div');
        quoteDiv.className = 'vb-quote';
        quoteDiv.textContent = '“' + shortText + '”';
        card.appendChild(quoteDiv);

        if (truncated) {
          var moreBtn = document.createElement('button');
          moreBtn.type = 'button';
          moreBtn.className = 'vb-more';
          moreBtn.textContent = 'Show more';
          var expanded = false;
          moreBtn.addEventListener('click', function () {
            expanded = !expanded;
            quoteDiv.textContent = expanded ? ('“' + fullText + '”') : ('“' + shortText + '”');
            moreBtn.textContent = expanded ? 'Show less' : 'Show more';
          });
          card.appendChild(moreBtn);
        }

        var tagsDiv = document.createElement('div');
        tagsDiv.className = 'vb-tags';
        var tagLabels = [
          platformShort(ex.platform),
          waveLabel(ex.wave),
          ex.size,
          ex.industry,
          ex.role,
        ].filter(Boolean);
        tagLabels.forEach(function (t) {
          var span = document.createElement('span');
          span.className = 'vb-tag';
          span.textContent = t;
          tagsDiv.appendChild(span);
        });
        card.appendChild(tagsDiv);

        bodyEl.appendChild(card);
      });
    }
    bodyEl.scrollTop = 0;

    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  // Click delegation: any chart row inside a [data-drilldown-chart] container
  // opens the modal. Reads the bar label from .gbc-label (grouped charts) or
  // .bar-label / .stack-bar-label (single-color and stacked charts).
  document.addEventListener('click', function (e) {
    var row = e.target.closest('[data-drilldown-chart] .gbc-row, [data-drilldown-chart] .bar-row, [data-drilldown-chart] .stack-bar-row');
    if (!row) return;
    if (row.hasAttribute('data-no-drill')) return;
    var chartEl = row.closest('[data-drilldown-chart]');
    if (!chartEl) return;
    var chartId = chartEl.getAttribute('data-drilldown-chart');
    var labelEl = row.querySelector('.gbc-label, .bar-label, .stack-bar-label');
    if (!labelEl) return;
    // Use textContent so any <strong> wrapper text is included; trim trailing
    // significance asterisks before lookup.
    var label = (labelEl.textContent || '').replace(/\*+\s*$/, '').trim();
    openModal(chartId, label);
  });
})();
</script>

<style is:inline>
