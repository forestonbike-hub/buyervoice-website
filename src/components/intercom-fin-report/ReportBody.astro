  .ifr-report .subtheme-block { background: rgba(11, 31, 58, 0.04); border: 1px solid var(--border); border-radius: 10px; padding: 22px 26px; margin: 20px 0 24px; }
  .ifr-report .subtheme-block-title { font-family: var(--serif); font-size: 17px; font-weight: 600; color: var(--ink); margin: 0 0 6px; line-height: 1.3; }
  .ifr-report .subtheme-block-intro { font-size: 13px; line-height: 1.6; color: var(--rule); margin: 0 0 16px; }
  .ifr-report .subtheme-row { display: grid; grid-template-columns: 200px 1fr; gap: 18px; padding: 14px 0; border-top: 1px solid rgba(11, 31, 58, 0.08); }
  .ifr-report .subtheme-row:first-of-type { padding-top: 4px; border-top: none; }
  .ifr-report .subtheme-name { font-family: var(--serif); font-size: 14px; font-weight: 600; color: var(--ink); line-height: 1.35; padding-top: 2px; }
