<script is:inline>
  (function () {
    var VX = window.__VX || { participants: [], charts: {} };
    var overlay = document.getElementById('vb-overlay');
    var titleEl = document.getElementById('vb-title');
    var subEl = document.getElementById('vb-sub');
    var bodyEl = document.getElementById('vb-body');

    function esc(s) {
      return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Filterable drilldown state. Each card carries participant tags across
    // six dimensions; clicking a tag toggles a filter on that dimension.
    var DIMS = ['func', 'ind', 'sen', 'age', 'ai', 'intent'];
    var currentCards = [];
    var filters = {};

    function cardHtml(c) {
      var tags = DIMS.map(function (d) {
        var v = c.tags[d];
        if (!v) return '';
        var active = filters[d] === v ? ' active' : '';
        return '<button class="vb-tagf' + active + '" data-dim="' + d + '" data-val="' + esc(v) + '" title="Filter by ' + esc(v) + '">' + esc(v) + '</button>';
      }).join('');
      return '<div class="vb-card">' +
        (c.qtext ? '<div class="vb-q">In response to: ' + esc(c.qtext) + '</div>' : '') +
        '<div class="vb-quote">&ldquo;' + esc(c.text) + '&rdquo;</div>' +
        '<div class="vb-meta">' + tags + '</div>' +
      '</div>';
    }

    function renderCards() {
      var active = Object.keys(filters);
      var shown = currentCards.filter(function (c) {
        return active.every(function (d) { return c.tags[d] === filters[d]; });
      });
      var header = shown.length + ' of ' + currentCards.length + ' participant quotes shown &middot; <span class="vb-filter-hint">Click any tag to filter; click it again to remove the filter.</span>';
      if (active.length) {
        var chips = active.map(function (d) {
          return '<button class="vb-fchip" data-dim="' + d + '">' + esc(filters[d]) + ' &#215;</button>';
        }).join('');
        header += '<span class="vb-fbar">' + chips + '<button class="vb-clear">Clear all filters</button></span>';
      }
      subEl.innerHTML = header;
      bodyEl.innerHTML = shown.length
        ? shown.map(cardHtml).join('')
        : '<p style="color:var(--muted);font-size:13px;">No quotes match the selected filters.</p>';
    }

    function openDrill(chartId, code) {
      // Prevalence bars are aggregated by code across every question, so the
      // drilldown searches all of a participant's coded questions for the code
      // (not a fixed question subset). This keeps the quote count equal to the
      // prevalence shown on the bar.
      titleEl.textContent = code;
      var questions = VX.questions || {};
      filters = {};
      currentCards = [];
      VX.participants.forEach(function (p) {
        if (!p.c) return;
        var hitQids = [];
        for (var q in p.c) {
          if (p.c[q].indexOf(code) !== -1) hitQids.push(q);
        }
        if (!hitQids.length) return;
        // prefer the question where this theme carries a Best-Worst Scaling
        // score (the participant's peak mention); else the first match.
        var chosen = hitQids[0];
        for (var i = 0; i < hitQids.length; i++) {
          if (p.b && p.b[hitQids[i]] && p.b[hitQids[i]][code] != null) { chosen = hitQids[i]; break; }
        }
        currentCards.push({
          qtext: questions[chosen] || '',
          text: (p.v && p.v[chosen]) || '',
          tags: {
            func: p.func || '',
            ind: p.ind || '',
            sen: p.sen || '',
            age: p.age || '',
            ai: p.ai || '',
            intent: p.intent ? p.intent + ' to enroll' : '',
          },
        });
      });
      renderCards();
      bodyEl.scrollTop = 0;
      overlay.classList.add('open');
    }

    // Tag clicks toggle filters; header chips remove them.
    bodyEl.addEventListener('click', function (e) {
      var tag = e.target.closest('.vb-tagf');
      if (!tag) return;
      var dim = tag.getAttribute('data-dim');
      var val = tag.getAttribute('data-val');
      if (filters[dim] === val) { delete filters[dim]; } else { filters[dim] = val; }
      renderCards();
    });
    subEl.addEventListener('click', function (e) {
      var chip = e.target.closest('.vb-fchip');
      if (chip) { delete filters[chip.getAttribute('data-dim')]; renderCards(); return; }
      if (e.target.closest('.vb-clear')) { filters = {}; renderCards(); }
    });

    document.querySelectorAll('[data-drilldown-chart]').forEach(function (chartEl) {
      var chartId = chartEl.getAttribute('data-drilldown-chart');
      chartEl.querySelectorAll('.bar-row, .paired-block').forEach(function (row) {
        row.addEventListener('click', function () {
          var code = row.getAttribute('data-code');
          if (code) openDrill(chartId, code);
        });
      });
    });

    function close() { overlay.classList.remove('open'); }
    document.getElementById('vb-close').addEventListener('click', close);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();
</script>

