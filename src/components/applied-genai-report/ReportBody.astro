// ReportBody.astro — Applied Generative AI Course Concept, findings report body.
// Shared between the internal (/internal/applied-genai-report/) and public
// (/applied-genai-report/) pages so both stay in sync. Reproduces the
// hr-report visual vocabulary (stat cards, INSIGHT/VULN/OPP callouts,
// raw-% inline bar charts, crosstabs, 2x2 freq x intensity scatter,
// recommendation tables, click-to-view-quotes drilldown) scoped under
// the .genai-report wrapper class.
import stats from '../../data/applied-genai-report/report-stats.json';
import vx from '../../data/applied-genai-report/verbatim-exemplars.json';

const m = stats.meta;
const ceil = (v: number) => Math.ceil(v);

// Embed the drilldown payload for the client-side modal handler.
const vxScript =
  '<' + 'script>window.__VX=' +
  JSON.stringify(vx).replace(/<\//g, '<\\/') +
  ';<' + '/script>';

// ---- inline bar chart helper data ----
type Row = {
  code: string; n: number; pct: number; pos: number; neg: number;
  pos_pct: number; pos_share_raisers: number;
  hot_n: number; warm_n: number; cold_n: number;
  hot_pct: number; warm_pct: number;
  hot_vs_warm_p: number | null; hot_vs_warm_sig: boolean;
  source_questions: string[];
};

// 2x2 freq x intensity scatter (inline SVG). Points filtered to the
// meaningfully-frequent codes so the plot stays legible.
function median(nums: number[]): number {
  const s = [...nums].sort((a, b) => a - b);
  const mid = Math.floor(s.length / 2);
  return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
}
type Pt = { label: string; freq_pct: number; mean_bws: number; n: number };
function buildScatter(points: Pt[], minFreq: number) {
  const pts = points.filter((p) => p.freq_pct >= minFreq);
  const W = 720, H = 430;
  const padL = 66, padR = 188, padT = 28, padB = 56;
  const plotW = W - padL - padR, plotH = H - padT - padB;
  const xMin = 0, xMax = 100;
  const ys = pts.map((p) => p.mean_bws);
  const yMin = Math.min(-0.6, ...ys) - 0.05;
  const yMax = Math.max(0.6, ...ys) + 0.05;
  const xOf = (v: number) => padL + ((v - xMin) / (xMax - xMin)) * plotW;
  const yOf = (v: number) => padT + (1 - (v - yMin) / (yMax - yMin)) * plotH;
  const xMed = median(pts.map((p) => p.freq_pct));
  const yMed = median(pts.map((p) => p.mean_bws));
  // Axis scales: numeric ticks along both axes.
  const xTicks = [0, 20, 40, 60, 80, 100];
  const yStep = 0.25;
  const yTicks: number[] = [];
  for (let v = Math.ceil(yMin / yStep) * yStep; v <= yMax + 1e-9; v += yStep) {
    yTicks.push(Math.round(v * 100) / 100);
  }
  const fmtY = (v: number) => (v > 0 ? '+' + v : '' + v);
  // Label layout: all labels sit to the right of their point (using the
  // reserved right gutter). A single vertical de-collision pass nudges
  // labels apart so text never overlaps.
  const labels = pts
    .map((p) => ({ label: p.label, cx: xOf(p.freq_pct), cy: yOf(p.mean_bws), lx: xOf(p.freq_pct) + 10, ly: yOf(p.mean_bws) + 3 }))
    .sort((a, b) => a.ly - b.ly);
  const GAP = 15;
  for (let i = 1; i < labels.length; i++) {
    if (labels[i].ly - labels[i - 1].ly < GAP) labels[i].ly = labels[i - 1].ly + GAP;
  }
  return { pts, labels, W, H, padL, padR, padT, padB, plotW, plotH, xOf, yOf, xMed, yMed, yMin, yMax, xTicks, yTicks, fmtY };
}
const scConcept = buildScatter(stats.bws.concept_appeal as Pt[], 24);
const scBarriers = buildScatter(stats.bws.barriers_price as Pt[], 24);

// cohort composition helper
const aiHot = (stats.cohort_demo.ai_familiarity.hot ?? {}) as Record<string, number>;
const aiWarm = (stats.cohort_demo.ai_familiarity.warm ?? {}) as Record<string, number>;
const aiOrder = ['Regular user', 'Occasional user', 'Non-user'];

// cohort-gap paired rows: significant gaps first (sorted by gap size),
// then the themes where the two cohorts broadly agree (sorted by prevalence).
const gapRowsAll = [...(stats.cohort_gaps as Row[])];
const sigRows = gapRowsAll
  .filter((r) => r.hot_vs_warm_sig)
  .sort((a, b) => Math.abs(b.hot_pct - b.warm_pct) - Math.abs(a.hot_pct - a.warm_pct));
const agreeRows = gapRowsAll
  .filter((r) => !r.hot_vs_warm_sig)
  .sort((a, b) => b.hot_pct - a.hot_pct);

// Every single-percentage bar chart renders highest prevalence at the top.
const sortPct = (arr: Row[]) => [...arr].sort((a, b) => b.pct - a.pct);

const medianExpectation = '$' + Number(stats.price_expectations.median_expectation_midpoint).toLocaleString('en-US');
const fc = stats.funding_contingency;

// Verbatim interview questions, quoted above every question-based chart so
// the reader knows exactly what participants were asked.
const Q = stats.question_text as Record<string, string>;

// Real high- vs low-intensity quote pairs (trimmed from actual interviews)
// used in the "how to read intensity" explainer box. Same theme each row, so
// the contrast isolates weight, not topic.
const intensityExamples = [
  {
    topic: 'Worrying the content might be too basic',
    high: "I genuinely worry about investing in something that's going to spend significant time on things I already know. If the first three weeks are 'here's what generative AI is and here's how to write a basic prompt,' I'm going to feel like my time isn't being respected.",
    low: "The level concern, I don't want to spend eight weeks reviewing things I already know.",
  },
  {
    topic: 'Reacting to the $3,000 price',
    high: "It's a stretch, and for me specifically it would be very difficult to self-fund that amount. I'd have to make a formal case to my executive director for reimbursement, and even then our professional-development budget is quite small.",
    low: "It's a reasonable ask for what's described. I'd expect employer support to be either fully available or likely available.",
  },
  {
    topic: 'The "no coding required" promise',
    high: "Every time I've tried to get my head around AI on my own, I hit a wall where it starts feeling very technical and I don't have that background. Knowing that's not a prerequisite is genuinely reassuring.",
    low: "The no-coding angle is fine, though for me it's not a selling point, since I've never felt coding was a barrier.",
  },
];
---

<Fragment set:html={vxScript} />

<div class="genai-report">

<!-- ============================================================ -->
<!-- 01 EXECUTIVE SUMMARY -->
<!-- ============================================================ -->
<details class="accordion">
  <summary class="accordion-header">
    <div style="flex:1;">
      <div style="display:flex;align-items:center;gap:16px;">
        <div style="flex:1;">
          <h2 class="accordion-title">Executive Summary</h2>
          <p class="accordion-subtitle">The launch verdict, seven decision-shaping findings, and the three conditions attached</p>
        </div>
        <span class="accordion-icon" aria-hidden="true">+</span>
      </div>
    </div>
  </summary>
  <div class="accordion-body">

    <p>This study answers one question: should the university launch "Applied Generative AI for Professionals," an eight-week online certificate that teaches non-technical professionals to use generative artificial intelligence (AI) in their daily work? Fifty working professionals in the target market evaluated the concept in depth, including its $3,000 price.</p>

    <div class="verdict">
      <p><strong>The verdict: a conditional yes.</strong> The concept, the format, and the hands-on approach draw near-universal approval, and 62% say they would seriously consider enrolling. But that demand is heavily contingent on employer funding, and the price sits at the ceiling of what the market expected. The evidence supports launching, on three conditions: build enrollment around an employer-sponsorship channel, publish the full curriculum with a level-fit path for experienced AI users, and lead the recruitment message with opportunity rather than fear. Each condition traces to a specific finding below.</p>
    </div>

    <div class="stat-grid">
      <div class="stat-card"><div class="stat-num">{m.n}</div><div class="stat-label">Professionals interviewed</div></div>
      <div class="stat-card"><div class="stat-num">96%</div><div class="stat-label">Positive first reaction to the concept</div></div>
      <div class="stat-card"><div class="stat-num">62%</div><div class="stat-label">Likely to seriously consider enrolling</div></div>
      <div class="stat-card"><div class="stat-num">96%</div><div class="stat-label">Say who funds it shapes the decision</div></div>
    </div>

    <h2>The Concept as Participants Heard It</h2>
    <p>Every finding in this report is a reaction to the exact description below, read aloud by the interviewer. No visuals, brand name, or price accompanied it; the $3,000 price was revealed separately, later in the interview, after participants had formed their impression of the offer.</p>
    <div class="concept-box">
      <span class="concept-label">Program Description</span>
      <p>"I'd like to describe a new course idea and get your honest reactions. It's called <strong>Applied Generative AI for Professionals</strong>, a new 8-week online certificate from a well-known university that teaches working professionals how to actually use generative AI in their day-to-day jobs. It's built for people in roles like marketing, operations, finance, and HR, with no coding or technical background required. You meet online one evening a week for a live, hands-on session, plus about three hours of your own project work, so roughly four to five hours a week total. Instead of theory, you work with the real tools, like ChatGPT and Copilot, on projects from your own job: automating routine tasks, drafting and analyzing documents, and building simple AI assistants that handle repetitive work. By the end, you can confidently put AI to work in your role, and you earn a professional certificate from the university to show for it. It's positioned as a way to stay ahead as AI reshapes your field, rather than get left behind."</p>
    </div>

    <h2>Who Was Interviewed</h2>
    <p>Fifty working professionals in the Greater Toronto Area, all currently employed, all with at least six years of work experience, all aged 25 or older. There was no company-size or seniority screen, and the sample was deliberately spread across levels of current AI use so the concept was tested on skeptics and non-users, not only enthusiasts.</p>
    <div class="demo-box">
      <div class="demo-grid">
        <div class="demo-cell">
          <div class="demo-head">Function</div>
          {stats.demographics.function.map((d) => (
            <div class="demo-row"><span>{d.label}</span><span class="demo-n">{d.n}</span></div>
          ))}
        </div>
        <div class="demo-cell">
          <div class="demo-head">Industry</div>
          {stats.demographics.industry.map((d) => (
            <div class="demo-row"><span>{d.label}</span><span class="demo-n">{d.n}</span></div>
          ))}
        </div>
        <div class="demo-cell">
          <div class="demo-head">Seniority</div>
          {stats.demographics.seniority.map((d) => (
            <div class="demo-row"><span>{d.label}</span><span class="demo-n">{d.n}</span></div>
          ))}
          <div class="demo-head" style="margin-top: 14px;">Current AI use</div>
          {stats.demographics.ai_familiarity.map((d) => (
            <div class="demo-row"><span>{d.label}</span><span class="demo-n">{d.n}</span></div>
          ))}
        </div>
        <div class="demo-cell">
          <div class="demo-head">Age band</div>
          {stats.demographics.age_band.map((d) => (
            <div class="demo-row"><span>{d.label}</span><span class="demo-n">{d.n}</span></div>
          ))}
          <div class="demo-head" style="margin-top: 14px;">Years of experience</div>
          {stats.demographics.years_experience.map((d) => (
            <div class="demo-row"><span>{d.label}</span><span class="demo-n">{d.n}</span></div>
          ))}
        </div>
      </div>
      <p class="demo-note">Counts of the 50 participants in each category.</p>
    </div>

    <h2>Seven Findings That Shape the Launch Decision</h2>

    <div class="insight">
      <p><strong>1. The concept lands almost universally, with an honest asterisk on format.</strong> 96% reacted positively to the concept (78% without any qualification), and 96% found the eight-week duration acceptable outright. The weekly time commitment reads as workable but conditional: nearly every participant treated it as feasible, yet only 58% affirmed it without reservation; most of the rest made it contingent on flexibility like session recordings. Neither the premise nor the format blocks a launch, but the format needs the flexibility features in Finding 6. <em>Owner: Program leadership.</em></p>
    </div>
    <div class="insight">
      <p><strong>2. "No coding required" plus "use your own work" is the accessibility engine.</strong> 78% named the no-coding framing as what makes the program feel built for them, and 92% valued applying it to their actual job tasks over generic exercises. This pairing is the core of the concept's appeal and should anchor the top of every recruitment message. <em>Owner: Enrollment marketing.</em></p>
    </div>
    <div class="opp-callout">
      <p><strong>3. The stated demand is employer-funding-contingent demand.</strong> 96% said who pays shapes whether they would enroll, and 88% would prefer their employer to fund or split the cost. The dependence runs deepest exactly where intent is highest: of the 31 likely enrollees, 27 prefer employer funding, and only 4 participants in the entire sample (8%) look both willing and able to self-fund at $3,000. Enrollment planning should treat the employer-sponsorship channel as the primary route and individual self-pay as the exception. <em>Owner: Corporate partnerships.</em></p>
    </div>
    <div class="vuln-callout">
      <p><strong>4. The price has no headroom.</strong> Before the reveal, participants expected the program to cost about $2,150 at the median, and $3,000 sits at or above what 80% of the sample anticipated; nobody expected more. 70% still judged it reasonable once framed as a university certificate with live instruction, but acceptance splits along conviction: 84% of the likely cohort versus 50% of the unsure cohort, a statistically significant gap. Hold the price, defend it with proof, and do not raise it. <em>Owner: Program leadership.</em></p>
    </div>
    <div class="insight">
      <p><strong>5. Fear-based positioning preaches to the choir.</strong> The "stay ahead rather than get left behind" framing resonates with the already-convinced likely cohort (87%) but the persuadable unsure cohort resists it (50% resist versus 23% of the likely cohort, a significant gap). Opportunity framing, cited by 68% overall, is the safer lead message for moving the middle. <em>Owner: Enrollment marketing.</em></p>
    </div>
    <div class="vuln-callout">
      <p><strong>6. The unsure cohort needs proof, not persuasion.</strong> The unsure cohort significantly over-indexes on wanting an advanced or intermediate track (22% versus 3%), payment-plan flexibility (28% versus 6%), and lower price acceptance. The advanced-track question is concentrated among regular AI users, 95% of whom worry the content is too basic for them. These are solvable objections about proof and fit, not rejections of the concept. <em>Owner: Program design.</em></p>
    </div>
    <div class="opp-callout">
      <p><strong>7. Structure beats free content.</strong> What justifies paying over free online material is structure and accountability (86%), the limits of self-directed free content (92%), and the inadequacy of employer-provided training (78%), not the raw information. The value story is the guided path, the live cohort, and the credential. <em>Owner: Enrollment marketing and Program design.</em></p>
    </div>

    <h2>The Three Conditions</h2>
    <table class="rec-table">
      <thead><tr><th>Condition</th><th>Description</th><th>Evidence</th></tr></thead>
      <tbody>
        <tr>
          <td>1. Build enrollment around employer sponsorship</td>
          <td>Lead every enrollment path with an employer-funded option, an approval toolkit prospective learners can hand their manager, and a split-cost fallback. Individual self-pay is the exception route, not the default.</td>
          <td>96% say funding shapes the decision; 27 of the 31 likely enrollees prefer employer funding; only 8% of the sample looks self-pay viable.</td>
        </tr>
        <tr>
          <td>2. Lead the recruitment message with opportunity, not fear</td>
          <td>Retire "get left behind" as the lead. Anchor on becoming more effective and staying ahead as an opportunity. Reserve urgency language for warm audiences already leaning in.</td>
          <td>68% prefer opportunity framing; the unsure cohort resists fear framing at 50% versus 23% of the likely cohort.</td>
        </tr>
        <tr>
          <td>3. Publish the curriculum and offer a level-fit path</td>
          <td>Publish a week-by-week syllabus and a placement or advanced-track option so experienced users can see the program is not too basic for them. This directly answers the unsure cohort's top objection.</td>
          <td>52% raise a "too basic" concern, rising to 95% among regular AI users; advanced-track demand runs 22% in the unsure cohort versus 3% in the likely cohort.</td>
        </tr>
      </tbody>
    </table>

    <h2>Report Navigation</h2>
    <table>
      <thead><tr><th>Section</th><th>Primary audience</th></tr></thead>
      <tbody>
        <tr><td>02. How the Concept Lands</td><td>All readers</td></tr>
        <tr><td>03. Price, Funding, and Positioning</td><td>Program leadership, Enrollment marketing</td></tr>
        <tr><td>04. The Intent Cohorts</td><td>Program leadership</td></tr>
        <tr><td>05. Program Positioning and Recruitment</td><td>Enrollment marketing</td></tr>
        <tr><td>06. Program Design and Curriculum</td><td>Program design, Faculty</td></tr>
        <tr><td>07. Enrollment Strategy and Employer Partnerships</td><td>Corporate partnerships</td></tr>
        <tr><td>08. Barriers, Risk, and Pre-Launch Validation</td><td>All readers</td></tr>
        <tr><td>09. Methodology</td><td>All readers</td></tr>
      </tbody>
    </table>

  </div>
</details>

<!-- ============================================================ -->
<!-- 02 HOW THE CONCEPT LANDS -->
<!-- ============================================================ -->
<details class="accordion">
  <summary class="accordion-header">
    <div style="flex:1;">
      <div style="display:flex;align-items:center;gap:16px;">
        <div style="flex:1;">
          <h2 class="accordion-title">How the Concept Lands</h2>
          <p class="accordion-subtitle">First reaction, what justifies paying, the credential, format fit, and career value</p>
        </div>
        <span class="accordion-icon" aria-hidden="true">+</span>
      </div>
    </div>
  </summary>
  <div class="accordion-body">

    <h2>First Reaction and Self-Relevance</h2>
    <p>The unaided first reaction to the concept is strongly positive and remarkably consistent across roles, industries, and levels of AI experience. What stands out is not a single feature but a pairing: the program removes the technical-barrier assumption ("no coding required") and grounds the learning in the participant's own job rather than abstract exercises.</p>
    <div class="q-asked">
      <span class="q-asked-label">Participants were asked, immediately after the concept was described and before any price was mentioned</span>
      <p class="q-asked-text">"{Q.Q4}"</p>
      <p class="q-asked-text">"{Q.Q5}"</p>
    </div>
    <p class="source-note">Share of all 50 participants whose interview raised each theme; themes are counted once per participant. <span class="vb-hint">Click a theme to read participant quotes.</span></p>
    <div class="bar-chart" data-drilldown-chart="first_reaction">
      {sortPct(stats.first_reaction as Row[]).map((s) => (
        <div class="bar-row" data-code={s.code}>
          <span class="bar-label">{s.code}</span>
          <div class="bar-track"><div class="bar-fill teal" style={`width:${s.pct}%`}><span class="bar-val">{ceil(s.pct)}%</span></div></div>
        </div>
      ))}
    </div>
    <div class="insight">
      <p><strong>The "no coding" hook and the own-work framing are the accessibility engine.</strong> 78% cited the no-coding signal and 92% wanted to apply the learning to their own job. Within the 96% positive first reaction, 78% were positive without qualification and the rest paired enthusiasm with a caveat, most often about content depth. Two-thirds (66%) described a latent gap between how much they use AI today and how much they feel they should, a signal that the concept meets a felt need rather than manufacturing one.</p>
    </div>

    <h2>What Justifies Paying Over Free Content</h2>
    <p>The most common threat to the concept is not a competitor program. It is the belief that the same material is available free online or through an employer. What flips that objection is structure, not information. Professionals who have tried to self-direct their AI learning describe abandoning free courses and value a guided path with accountability.</p>
    <div class="q-asked">
      <span class="q-asked-label">Participants were asked</span>
      <p class="q-asked-text">"{Q.Q7}"</p>
    </div>
    <p class="source-note">Share of all 50 participants whose interview raised each theme; themes are counted once per participant. <span class="vb-hint">Click a theme to read participant quotes.</span></p>
    <div class="bar-chart" data-drilldown-chart="why_pay">
      {sortPct(stats.why_pay as Row[]).map((s) => (
        <div class="bar-row" data-code={s.code}>
          <span class="bar-label">{s.code}</span>
          <div class="bar-track"><div class="bar-fill signal" style={`width:${s.pct}%`}><span class="bar-val">{ceil(s.pct)}%</span></div></div>
        </div>
      ))}
    </div>
    <div class="insight">
      <p><strong>Structure and accountability are the paid-value story.</strong> 86% valued a structured program over self-directed learning, 92% named the limits of free content, and 78% found employer-provided training insufficient. The information is a commodity. The guided path, the live cohort, and the finish line are what people will pay for.</p>
    </div>

    <h2>The University Credential</h2>
    <p>The university name adds credibility and signals quality, but most participants are clear that at their career stage the skill matters more than the certificate. The credential is a supporting asset, not the primary purchase reason. Skepticism, where it exists, is about whether the content goes deep enough, not about the university's legitimacy.</p>
    <div class="q-asked">
      <span class="q-asked-label">Participants were asked</span>
      <p class="q-asked-text">"{Q.Q6}"</p>
    </div>
    <p class="source-note">Share of all 50 participants whose interview raised each theme; themes are counted once per participant. <span class="vb-hint">Click a theme to read participant quotes.</span></p>
    <div class="bar-chart" data-drilldown-chart="credential">
      {sortPct(stats.credential as Row[]).map((s) => (
        <div class="bar-row" data-code={s.code}>
          <span class="bar-label">{s.code}</span>
          <div class="bar-track"><div class="bar-fill plum" style={`width:${s.pct}%`}><span class="bar-val">{ceil(s.pct)}%</span></div></div>
        </div>
      ))}
    </div>

    <h2>Format Fit</h2>
    <p>The eight-week, one-live-evening, four-to-five-hours-a-week format is broadly workable, with a caveat the direction coding makes visible: nearly every participant treated the weekly commitment as feasible, but only 58% affirmed it without reservation, and most of the rest made it conditional. The eight-week duration, by contrast, was endorsed outright by everyone who discussed it. The frictions are real but specific: unpredictable work demands and seasonal cycles (tax season, healthcare crises, public-sector budget periods) are the recurring scheduling risks, and a majority want session recordings so a missed evening does not mean falling behind.</p>
    <div class="q-asked">
      <span class="q-asked-label">Participants were asked</span>
      <p class="q-asked-text">"{Q.Q8}"</p>
    </div>
    <p class="source-note">Share of all 50 participants whose interview raised each theme; themes are counted once per participant. <span class="vb-hint">Click a theme to read participant quotes.</span></p>
    <div class="bar-chart" data-drilldown-chart="format_fit">
      {sortPct(stats.format_fit as Row[]).map((s) => (
        <div class="bar-row" data-code={s.code}>
          <span class="bar-label">{s.code}</span>
          <div class="bar-track"><div class="bar-fill slate" style={`width:${s.pct}%`}><span class="bar-val">{ceil(s.pct)}%</span></div></div>
        </div>
      ))}
    </div>
    <div class="vuln-callout">
      <p><strong>The live evening is a draw and an obstacle at once.</strong> 58% asked for recorded sessions and 56% flagged unpredictable work demands as a scheduling risk. A recorded-and-catch-up option would defuse the single most common format objection without giving up the live cohort experience that others value.</p>
    </div>

    <h2>Career Value</h2>
    <p>Belief in career payoff is real but uneven. Private-sector and mid-career participants see clearer advancement value; public-sector, nonprofit, and later-career participants expect relevance but not a salary jump. A recurring frame is defensive value, staying relevant and not falling behind, as much as offensive value like promotion or new roles.</p>
    <div class="q-asked">
      <span class="q-asked-label">Participants were asked</span>
      <p class="q-asked-text">"{Q.Q9}"</p>
    </div>
    <p class="source-note">Share of all 50 participants whose interview raised each theme; themes are counted once per participant. <span class="vb-hint">Click a theme to read participant quotes.</span></p>
    <div class="bar-chart" data-drilldown-chart="career_value">
      {sortPct(stats.career_value as Row[]).map((s) => (
        <div class="bar-row" data-code={s.code}>
          <span class="bar-label">{s.code}</span>
          <div class="bar-track"><div class="bar-fill ink" style={`width:${s.pct}%`}><span class="bar-val">{ceil(s.pct)}%</span></div></div>
        </div>
      ))}
    </div>

    <h2>Which Appeal Drivers Carry the Most Weight</h2>

    <div class="intensity-box">
      <span class="intensity-title">How to read "intensity"</span>
      <p class="intensity-lead">Two things about a theme are worth separating. <strong>Prevalence</strong> is how many people raised it. <strong>Intensity</strong> is how much weight sat behind those mentions. "The price is a bit high" and "there is no way I could justify $3,000 to my director" are coded to the same theme, but they are not the same signal. The scatter charts in this report plot both: how often a theme came up along the horizontal axis, and how heavily it was weighted along the vertical axis. Below are real pairs from these interviews, each showing the same idea expressed with high and low intensity.</p>
      {intensityExamples.map((ex) => (
        <div class="intensity-example">
          <div class="ix-topic">{ex.topic}</div>
          <div class="ix-pair">
            <div class="iq-card high">
              <span class="iq-tag">Higher intensity</span>
