<Fragment set:html={vxScript} />

<script is:inline>
(function () {
  var VX = window.__VX;
  if (!VX) return;

  var overlay = document.getElementById('vbOverlay');
  var titleEl = document.getElementById('vbTitle');
  var subEl = document.getElementById('vbSubtitle');
  var bodyEl = document.getElementById('vbBody');
  var closeBtn = document.getElementById('vbClose');
  if (!overlay || !titleEl || !subEl || !bodyEl || !closeBtn) return;

  function escHtml(s) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(s == null ? '' : String(s)));
    return d.innerHTML;
  }

  function renderCard(ex) {
    var tags = [];
    if (ex.bank) tags.push({label: ex.bank, cls: 'bank'});
    if (ex.age) tags.push({label: ex.age, cls: ''});
    if (ex.emp) tags.push({label: ex.emp, cls: ''});
    if (ex.income) tags.push({label: ex.income, cls: ''});

    var html = '<div class="vb-card">';
    html += '<div class="vb-quote">&ldquo;' + escHtml(ex.quote) + '&rdquo;</div>';
    html += '<div class="vb-tags">';
    tags.forEach(function (t) {
      html += '<span class="vb-tag ' + t.cls + '">' + escHtml(t.label) + '</span>';
    });
    html += '</div></div>';
    return html;
  }

  function openModal(chartId, barLabel) {
    var chart = VX.charts[chartId];
    if (!chart) return;
    var codeNames = chart.bars[barLabel];
    if (!codeNames) return;
    var qids = chart.qids || [];
    var codeSet = {};
    codeNames.forEach(function (cn) { codeSet[cn] = true; });

    // Find every (participant, qid) pair where the participant's codes at
    // that qid include any of the bar's code names. Emit one card per pair.
    var cards = [];
    (VX.participants || []).forEach(function (p) {
      qids.forEach(function (qid) {
        var pcodes = (p.c || {})[qid];
        if (!pcodes || !pcodes.length) return;
        var matched = null;
        for (var i = 0; i < pcodes.length; i++) {
          if (codeSet[pcodes[i]]) { matched = pcodes[i]; break; }
        }
        if (!matched) return;
        var verbatim = (p.v || {})[qid];
        if (!verbatim) return;
        var intensity = ((p.i || {})[qid] || {})[matched] || 2;
        cards.push({
          pid: p.pid,
          qid: qid,
          quote: verbatim,
          intensity: intensity,
          bank: p.bank,
          age: p.age,
          emp: p.emp,
          income: p.income,
          code: matched,
        });
      });
    });

    // Sort by intensity desc (most narrative-weighted first), then pid stable
    cards.sort(function (a, b) {
      var ia = a.intensity || 0;
      var ib = b.intensity || 0;
      if (ia !== ib) return ib - ia;
      return a.pid - b.pid;
    });

    titleEl.textContent = barLabel + ' (' + chart.cohort + ')';
    subEl.textContent = chart.question || '';

    if (cards.length === 0) {
      bodyEl.innerHTML = '<p class="vb-empty">No participant quotes matched this theme.</p>';
    } else {
      var intro = '<p class="vb-empty" style="margin:0 0 12px;font-size:12px;">' +
        'Showing all ' + cards.length + ' participant quote' + (cards.length === 1 ? '' : 's') +
        ' coded to this theme.</p>';
      bodyEl.innerHTML = intro + cards.map(renderCard).join('');
    }

    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  // Click delegation: any bar row inside a [data-drilldown-chart] container
  // opens the modal with that chart_id + the bar label's text content.
  document.addEventListener('click', function (e) {
    var row = e.target.closest('[data-drilldown-chart] .bar-row, [data-drilldown-chart] .stack-bar-row');
    if (!row) return;
    var chartEl = row.closest('[data-drilldown-chart]');
    if (!chartEl) return;
    var chartId = chartEl.getAttribute('data-drilldown-chart');
    var labelEl = row.querySelector('.bar-label, .stack-bar-label');
    if (!labelEl) return;
    var label = (labelEl.textContent || '').replace(/\*+\s*$/, '').trim();
    openModal(chartId, label);
  });
})();
</script>
