---
// ReportBody.astro, UK Neobank Switching Study report body.
// Imported by BOTH the internal page (src/pages/internal/uk-neobanks-report/)
// and the public page (src/pages/uk-neobanks-report/).
//
// Visual language mirrors hr-report (the canonical BuyerVoice report
// design): stat-card grid, INSIGHT/VULN/OPP callout boxes, color-coded
// inline bar charts, recommendation tables, crosstab highlights. Section
// flow mirrors hr-report ordering: Exec Summary, Findings, Competitive
// Position, 3-stakeholder Recommendations, Retention & Risk, Methodology.
//
// Charts marked stacked-by-intensity render the per-code bar as three
// segments (high / medium / low intensity) summing to the code's overall
// prevalence. Forest specified intensity stacking on 2A, 2C, 3E, 7A, 7B.
// Other theme charts render flat but still get the click-to-view-quotes
// drilldown via the data-drilldown-chart attribute and the __VX modal.
import Section from '../report/Section.astro';
import reportStats from '../../data/uk-neobanks/report-stats.json';
import verbatimExemplars from '../../data/uk-neobanks/verbatim-exemplars.json';
import triggerSubpatterns from '../../data/uk-neobanks/trigger-subpatterns.json';
import switchingLikelihood from '../../data/uk-neobanks/switching-likelihood.json';

const d: any = reportStats;
const tsp: any = triggerSubpatterns;
const swl: any = switchingLikelihood;
const vxScript = '<script>window.__VX=' + JSON.stringify(verbatimExemplars).replace(/<\//g, '<\\/') + ';<' + '/script>';

interface CodeRow { label: string; pct: number; n_pos: number; }
function rows(codes: CodeRow[], topN = 8) {
  return codes.slice(0, topN).map((c) => ({ label: c.label, pct: c.pct, n: c.n_pos }));
}

// Build a brand-by-theme correspondence matrix from the per-brand
// appeal / concern arrays. The result is one row per unique theme label
// (union across all three brands) with three percentage columns
// (Monzo, Starling Bank, Revolut). Used by Section 3b and 3c to render
// the appeal correspondence and concerns correspondence heatmaps.
const BRANDS = ['Monzo', 'Starling Bank', 'Revolut'] as const;
function buildCorrespondence(side: 'appeal' | 'concerns') {
  const matrix: any = (d.chapter3_whos_next?.brand_attribute_matrix) ?? {};
  const labelSet = new Set<string>();
  BRANDS.forEach((b) => {
    (matrix[b]?.[side] ?? []).forEach((c: any) => labelSet.add(c.label));
  });
  const out = Array.from(labelSet).map((label) => {
    const row: any = { label };
    BRANDS.forEach((b) => {
      const found = (matrix[b]?.[side] ?? []).find((c: any) => c.label === label);
      row[b] = found ? found.pct : 0;
    });
    row.maxPct = Math.max(...BRANDS.map((b) => row[b]));
    row.maxBrand = BRANDS.find((b) => row[b] === row.maxPct);
    return row;
  });
  out.sort((a, b) => b.maxPct - a.maxPct);
  return out;
}
function heatClass(pct: number) {
  if (pct === 0) return 'heat-zero';
  if (pct >= 60) return 'heat-hi';
  if (pct >= 30) return 'heat-med';
  return 'heat-lo';
}

// Union of push (Wave 1 Q5 frustrations with previous bank) and pull
// (Wave 1 Q7 reasons for choosing the neobank) per-theme percentages.
// Ranked by push percentage descending so the reader's eye starts at
// the largest frustration with the previous bank and works down. The
// pull bar sits beside it so the strategic question (does the neobank
// actually solve this frustration?) reads in a glance.
function pushPullPaired() {
  const push = d.chapter1_why_they_left?.push_forces_q5?.codes ?? [];
  const pull = d.chapter1_why_they_left?.pull_forces_q7?.codes ?? [];
  const labels = new Set<string>();
  push.forEach((c: any) => labels.add(c.label));
  pull.forEach((c: any) => labels.add(c.label));
  const out = Array.from(labels).map((label) => {
    const p = push.find((c: any) => c.label === label);
    const u = pull.find((c: any) => c.label === label);
    return {
      label,
      push_pct: p ? p.pct : 0,
      pull_pct: u ? u.pct : 0,
    };
  });
  // Sort by push_pct descending. Tiebreaker is pull_pct so that themes
  // tied on push prevalence are ordered by which is also a stronger
  // pull, surfacing the "most-actively-solved" theme of the tied set
  // first.
  out.sort((a, b) => (b.push_pct - a.push_pct) || (b.pull_pct - a.pull_pct));
  return out.slice(0, 10);
}
---

<style is:inline>
  /* Visual primitives lifted from hr-report, the canonical BuyerVoice
     report design. Scoped here so this report inherits the same look as
     hr-report, retail-banking-report, etc., without depending on the
     ReportLayout stylesheet to grow them. */
  .ukn-report .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 16px 0 24px; }
  .ukn-report .stat-card { text-align: center; padding: 16px; background: rgba(11, 31, 58, 0.04); border-radius: 8px; }
  .ukn-report .stat-num { font-family: var(--serif), Georgia, serif; font-size: 28px; font-weight: 600; color: var(--signal); }
  .ukn-report .stat-label { font-size: 11px; color: var(--muted); margin-top: 4px; line-height: 1.4; }
  /* Compact stats variant (used in Section 2 to describe the switcher
     cohort). Smaller per-card padding and font so 4 cards with longer
     descriptive labels fit comfortably on one row. Matches the
     retail-banking-report `.compact-stats` pattern verbatim. */
  .ukn-report .compact-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 18px 0; }
  .ukn-report .compact-stat { padding: 14px 12px; background: var(--card-bg, rgba(11, 31, 58, 0.04)); border: 1px solid var(--border, rgba(11, 31, 58, 0.10)); border-radius: 4px; }
  .ukn-report .compact-stat .csn { font-family: var(--serif), Georgia, serif; font-size: 22px; font-weight: 600; color: var(--signal); line-height: 1.1; }
  .ukn-report .compact-stat .csl { font-size: 11.5px; color: var(--rule); margin-top: 6px; line-height: 1.4; }
  /* Source-centric stacked-bar (Section 2b "Where they came from").
     Single 100% horizontal bar per incumbent showing what share of that
     bank's departing switchers went to Monzo vs Starling. */
  .ukn-report .source-block { display: grid; grid-template-columns: 200px 1fr 80px; align-items: center; gap: 16px; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid rgba(11, 31, 58, 0.06); }
  .ukn-report .source-block:last-of-type { border-bottom: none; }
  .ukn-report .source-bank { font-size: 13px; font-weight: 600; color: var(--ink); text-align: right; line-height: 1.3; }
  .ukn-report .source-track { height: 22px; background: rgba(11, 31, 58, 0.06); border-radius: 3px; overflow: hidden; display: flex; }
  .ukn-report .source-seg { height: 100%; display: flex; align-items: center; justify-content: center; font-size: 10.5px; font-weight: 700; color: #fff; overflow: hidden; white-space: nowrap; padding: 0 4px; }
  .ukn-report .source-seg.monzo { background: var(--signal); }
  .ukn-report .source-seg.starling { background: var(--ink); }
  .ukn-report .source-n { font-size: 12px; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
  .ukn-report .source-legend { display: flex; gap: 18px; align-items: center; font-size: 11px; color: var(--muted); margin: 8px 0 12px 216px; }
  .ukn-report .source-legend .leg-swatch { display: inline-block; width: 12px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
  .ukn-report .source-legend .leg-swatch.monzo { background: var(--signal); }
  .ukn-report .source-legend .leg-swatch.starling { background: var(--ink); }
  .ukn-report .insight { border-left: 4px solid var(--signal); background: rgba(184, 52, 27, 0.06); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 16px 0; }
  .ukn-report .insight p { font-size: 13px; margin-bottom: 0; }
  .ukn-report .insight strong { color: var(--signal); }
  .ukn-report .vuln-callout { border-left: 4px solid #C4784A; background: rgba(196, 120, 74, 0.08); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 16px 0; }
  .ukn-report .vuln-callout p { font-size: 13px; margin-bottom: 0; }
  .ukn-report .vuln-callout strong { color: #C4784A; }
  .ukn-report .opp-callout { border-left: 4px solid #2A7A6E; background: rgba(42, 122, 110, 0.08); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 16px 0; }
  .ukn-report .opp-callout p { font-size: 13px; margin-bottom: 0; }
  .ukn-report .opp-callout strong { color: #2A7A6E; }
  .ukn-report .bar-chart { margin: 16px 0; }
  .ukn-report .bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .ukn-report .bar-label { width: 240px; font-size: 13px; font-weight: 500; text-align: right; flex-shrink: 0; }
  .ukn-report .bar-track { flex: 1; height: 24px; background: rgba(11, 31, 58, 0.06); border-radius: 4px; overflow: hidden; position: relative; }
  .ukn-report .bar-fill { height: 100%; border-radius: 4px; display: flex; align-items: center; justify-content: flex-end; padding-right: 8px; min-width: 36px; }
  .ukn-report .bar-fill.signal { background: var(--signal); }
  .ukn-report .bar-fill.ink { background: var(--ink); }
  .ukn-report .bar-fill.warm { background: #C4784A; }
  .ukn-report .bar-fill.slate { background: #5A7A94; }
  .ukn-report .bar-fill.teal { background: #2A7A6E; }
  .ukn-report .bar-fill.plum { background: #6B4C6E; }
  .ukn-report .bar-val { font-size: 11px; font-weight: 700; color: #fff; }
  .ukn-report .q-cite { display: block; font-family: var(--sans), system-ui, sans-serif; font-size: 12px; font-weight: 400; color: var(--muted); font-style: italic; margin-top: 2px; margin-bottom: 8px; }
  .ukn-report .source-note { font-size: 12px; color: var(--muted); margin-top: 8px; margin-bottom: 16px; }
  .ukn-report .rec-table { width: 100%; border-collapse: collapse; margin: 16px 0 24px; font-size: 13px; }
  .ukn-report .rec-table th { background: rgba(11, 31, 58, 0.04); text-align: left; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); padding: 10px 12px; border-bottom: 2px solid rgba(11, 31, 58, 0.12); }
  .ukn-report .rec-table td { padding: 10px 12px; border-bottom: 1px solid rgba(11, 31, 58, 0.06); }
  .ukn-report .rec-table td:first-child { font-weight: 600; width: 30%; }
  /* Navigation table: spread columns across full width and right-justify the
     audience column so it reads cleanly against the section list on the
     left. Without this, the audience column hugs the section text and
     looks cramped (especially on the longer Section 7 row). */
  .ukn-report .nav-table { table-layout: fixed; width: 100%; }
  .ukn-report .nav-table th:first-child, .ukn-report .nav-table td:first-child { width: 60%; }
  .ukn-report .nav-table th:last-child, .ukn-report .nav-table td:last-child { width: 40%; text-align: right; padding-right: 4px; }
  .ukn-report .crosstab { font-size: 12px; overflow-x: auto; margin: 16px 0; }
  .ukn-report .crosstab table { width: 100%; min-width: 600px; border-collapse: collapse; }
  .ukn-report .crosstab th, .ukn-report .crosstab td { padding: 8px 10px; text-align: right; white-space: nowrap; border-bottom: 1px solid rgba(11, 31, 58, 0.06); }
  .ukn-report .crosstab th:first-child, .ukn-report .crosstab td:first-child { text-align: left; min-width: 200px; }
  .ukn-report .crosstab th { background: rgba(11, 31, 58, 0.04); font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); border-bottom: 2px solid rgba(11, 31, 58, 0.12); }
  .ukn-report .crosstab .highlight { background: rgba(184, 52, 27, 0.10); font-weight: 700; }
  /* Correspondence heatmap (Section 3b, 3c). Rows = appeal or concern
     themes (union across the three neobanks). Columns = Monzo, Starling
     Bank, Revolut. Cells are colored by intensity of the brand-theme
     association, with the row max outlined in signal red so the
     "this brand owns this attribute" pattern is visually obvious. */
  .ukn-report .heat { margin: 16px 0 12px; }
  .ukn-report .heat table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 13px; }
  .ukn-report .heat th { background: rgba(11, 31, 58, 0.04); font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); padding: 10px 8px; border-bottom: 2px solid rgba(11, 31, 58, 0.12); text-align: center; }
  .ukn-report .heat th:first-child { text-align: left; width: 40%; }
  .ukn-report .heat td { padding: 10px 8px; border-bottom: 1px solid rgba(11, 31, 58, 0.06); text-align: center; vertical-align: middle; }
  .ukn-report .heat td:first-child { text-align: left; font-weight: 500; color: var(--ink); line-height: 1.35; }
  .ukn-report .heat td.cell { font-weight: 600; }
  .ukn-report .heat td.heat-hi { background: rgba(184, 52, 27, 0.18); color: var(--signal); }
  .ukn-report .heat td.heat-med { background: rgba(184, 52, 27, 0.08); color: var(--ink); }
  .ukn-report .heat td.heat-lo { background: rgba(11, 31, 58, 0.03); color: var(--muted); font-weight: 500; }
  .ukn-report .heat td.heat-zero { background: transparent; color: rgba(11, 31, 58, 0.25); font-weight: 400; }
  .ukn-report .heat td.heat-max { outline: 2px solid var(--signal); outline-offset: -2px; color: var(--signal); }
  .ukn-report .heat-legend { display: flex; gap: 16px; align-items: center; font-size: 11px; color: var(--muted); margin: 8px 0 4px; }
  .ukn-report .heat-swatch { display: inline-block; width: 12px; height: 10px; border-radius: 2px; margin-right: 5px; vertical-align: middle; }
  .ukn-report .heat-swatch.heat-hi { background: rgba(184, 52, 27, 0.18); }
  .ukn-report .heat-swatch.heat-med { background: rgba(184, 52, 27, 0.08); }
  .ukn-report .heat-swatch.heat-lo { background: rgba(11, 31, 58, 0.03); border: 1px solid var(--border, rgba(11, 31, 58, 0.10)); }
  .ukn-report .heat-swatch.heat-max { outline: 2px solid var(--signal); outline-offset: -1px; background: rgba(184, 52, 27, 0.18); }
  /* Section-body h2 (e.g. "2a. Why they left"). Excludes .accordion-title
     so the accordion header doesn't inherit the 28px top margin and look
     visually stretched relative to retail-banking. */
  .ukn-report h2:not(.accordion-title) { font-family: var(--serif), Georgia, serif; font-size: 22px; font-weight: 600; color: var(--ink); margin-top: 28px; margin-bottom: 8px; letter-spacing: -0.02em; }
  .ukn-report h3 { font-family: var(--serif), Georgia, serif; font-size: 18px; font-weight: 600; color: var(--ink); margin-top: 24px; margin-bottom: 8px; letter-spacing: -0.02em; }
  .ukn-report h4 { font-family: var(--serif), Georgia, serif; font-size: 15px; font-weight: 600; color: var(--ink); margin-top: 16px; margin-bottom: 6px; letter-spacing: -0.02em; }
  .ukn-report p { font-size: 14px; line-height: 1.6; margin-bottom: 12px; }
  .ukn-report ul, .ukn-report ol { margin: 8px 0 16px 20px; }
  .ukn-report li { font-size: 14px; line-height: 1.6; margin-bottom: 6px; }
  /* Bar chart standard (canonical for every BuyerVoice report; matches
     the retail-banking-report pattern). Each .bar-track is a 100%-wide
     gray rail; the .bar-fill width is set inline as the RAW prevalence
     percent (so a 77% bar takes 77% of the track, not the whole track).
     The percentage label sits inside the bar at its right edge, with
     no external value column. Bar fill is single-color per chart; pick the
     thematic color (signal for frustrations, teal for positives, warm
     for triggers/concerns, ink for neutral) and apply it to every bar
     in that chart. */
  /* Click-to-view-quotes affordance: bar rows inside a data-drilldown-chart
     container show a pointer cursor and the bar label gets an underline so
     readers know it's interactive. Print: revert all of this. */
  .ukn-report [data-drilldown-chart] .bar-row { cursor: pointer; transition: opacity 0.15s; }
  .ukn-report [data-drilldown-chart] .bar-row:hover { opacity: 0.82; }
  .ukn-report [data-drilldown-chart] .bar-label { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  /* Drilldown hint embedded as red signal text inside the source-note line,
     prefixed with a › guillemet, matching retail-banking-report's .vb-hint. */
  .ukn-report .vb-hint { font-size: 11.5px; color: var(--signal); font-weight: 500; }
  .ukn-report .vb-hint::before { content: '\203A  '; }
  /* Paired bar chart for cross-wave comparisons (Section 2i). One block
     per theme: theme label on the left, two stacked mini-bars in the
     middle (Wave 1 + Wave 2), delta-pp column on the right. The
     `.paired-block.no-delta` variant drops the delta column for
     destination-distribution charts (Section 2b "where they came from",
     2c "other banks considered") that pair Monzo vs Starling switchers
     without a meaningful delta. */
  .ukn-report .paired-block { display: grid; grid-template-columns: 200px 1fr 80px; align-items: center; gap: 16px; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid rgba(11, 31, 58, 0.06); }
  .ukn-report .paired-block.no-delta { grid-template-columns: 200px 1fr; }
  .ukn-report .paired-block:last-of-type { border-bottom: none; }
  .ukn-report .paired-theme { font-size: 13px; font-weight: 600; color: var(--ink); text-align: right; line-height: 1.3; }
  .ukn-report .paired-bars { display: flex; flex-direction: column; gap: 4px; }
  .ukn-report .paired-row { display: flex; align-items: center; gap: 8px; }
  /* Fixed width + right-align so the bar tracks share an origin x-position
     across rows. Without the fixed width, the longer mini-label (e.g.
     "Pull (selection driver)") pushes the track right relative to a
     shorter mini-label (e.g. "Push (frustration)") and the bar origins
     no longer align. Applies to every paired-bar chart in the report
     (Sections 2e push/pull, 4a cross-wave, 4b likelihood frustrations). */
  .ukn-report .paired-mini-label { font-size: 11px; color: var(--muted); font-weight: 500; width: 150px; flex-shrink: 0; text-align: right; }
  .ukn-report .paired-track { flex: 1; height: 18px; background: rgba(11, 31, 58, 0.06); border-radius: 3px; overflow: hidden; }
  .ukn-report .paired-fill { height: 100%; display: flex; align-items: center; justify-content: flex-end; padding-right: 6px; min-width: 32px; border-radius: 3px; }
  .ukn-report .paired-fill.w1 { background: var(--ink); }
  .ukn-report .paired-fill.w2 { background: var(--signal); }
  /* Monzo and Starling color treatment for destination-paired charts.
     Monzo signal red (the more dominant/recognized brand), Starling navy
     ink to differentiate visually from Monzo bars. */
  .ukn-report .paired-fill.monzo { background: var(--signal); }
  .ukn-report .paired-fill.starling { background: var(--ink); }
  .ukn-report .paired-fill.push { background: var(--signal); }
  .ukn-report .paired-fill.pull { background: #2A7A6E; }
  .ukn-report .paired-val { font-size: 10.5px; font-weight: 700; color: #fff; }
  .ukn-report .paired-delta { font-size: 13px; font-weight: 600; text-align: right; color: var(--ink); }
  .ukn-report .paired-delta.pos { color: var(--signal); }
  .ukn-report .paired-delta.neg { color: var(--ink); }
  /* Verbatim drill-down modal. Hidden by default; the click handler adds
     the .open class. */
  .vb-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 9999; }
  .vb-overlay.open { display: flex; justify-content: center; align-items: center; }
  .vb-dialog { background: var(--paper); border-radius: 10px; max-width: 760px; width: 94%; max-height: 86vh; display: flex; flex-direction: column; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.25); }
  .vb-close { position: absolute; top: 8px; right: 12px; background: none; border: none; font-size: 26px; line-height: 1; cursor: pointer; color: var(--muted); padding: 4px 8px; }
  .vb-close:hover { color: var(--ink); }
  .vb-header { padding: 22px 28px 8px; border-bottom: 1px solid var(--border); }
  .vb-header h3 { font-family: var(--serif), Georgia, serif; font-size: 18px; font-weight: 600; color: var(--ink); margin: 0 0 4px; line-height: 1.3; }
  .vb-q { font-size: 12.5px; color: var(--muted); margin: 0; font-style: italic; line-height: 1.45; }
  .vb-body { padding: 16px 28px 22px; overflow-y: auto; }
  .vb-card { background: rgba(11,31,58,0.04); border-left: 3px solid var(--signal); padding: 14px 16px; border-radius: 0 6px 6px 0; margin-bottom: 12px; }
  .vb-card .vb-quote { font-family: var(--serif), Georgia, serif; font-style: italic; font-size: 14px; color: var(--rule); line-height: 1.6; margin-bottom: 10px; }
  .vb-card .vb-tags { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .vb-tag { font-size: 10.5px; background: rgba(11,31,58,0.08); color: var(--rule); padding: 2px 9px; border-radius: 10px; font-weight: 500; }
  .vb-tag.bank { background: rgba(184,52,27,0.12); color: var(--signal); font-weight: 600; }
  .vb-empty { font-size: 13px; color: var(--muted); }
  @media print {
    .ukn-report .insight { background: rgba(184, 52, 27, 0.06) !important; border-left: 4px solid var(--signal) !important; }
    .ukn-report .vuln-callout { background: rgba(196, 120, 74, 0.08) !important; border-left: 4px solid #C4784A !important; }
    .ukn-report .opp-callout { background: rgba(42, 122, 110, 0.08) !important; border-left: 4px solid #2A7A6E !important; }
    .ukn-report .bar-fill.signal { background: var(--signal) !important; }
    .ukn-report .bar-fill.ink { background: var(--ink) !important; }
    .ukn-report .bar-fill.warm { background: #C4784A !important; }
    .ukn-report .bar-fill.slate { background: #5A7A94 !important; }
    .ukn-report .bar-fill.teal { background: #2A7A6E !important; }
    .ukn-report .bar-fill.plum { background: #6B4C6E !important; }
    .ukn-report [data-drilldown-chart] .bar-label { text-decoration: none !important; }
    .ukn-report .vb-hint { display: none !important; }
    .ukn-report .paired-fill.w1 { background: var(--ink) !important; }
    .ukn-report .paired-fill.w2 { background: var(--signal) !important; }
    .ukn-report .paired-fill.monzo { background: var(--signal) !important; }
    .ukn-report .paired-fill.starling { background: var(--ink) !important; }
    .ukn-report .paired-fill.push { background: var(--signal) !important; }
    .ukn-report .paired-fill.pull { background: #2A7A6E !important; }
    .ukn-report .heat td.heat-hi { background: rgba(184, 52, 27, 0.18) !important; }
    .ukn-report .heat td.heat-med { background: rgba(184, 52, 27, 0.08) !important; }
    .ukn-report .heat td.heat-lo { background: rgba(11, 31, 58, 0.03) !important; }
    .ukn-report .source-seg.monzo { background: var(--signal) !important; }
    .ukn-report .source-seg.starling { background: var(--ink) !important; }
    .vb-overlay { display: none !important; }
