const BANKS = ['Simplii Financial', 'CIBC', 'RBC', 'TD', 'BMO', 'Scotiabank'];

// Plain-English CEP labels and the question we asked
const CEP_LABELS: Record<number, string> = {
  1: 'everyday spending and bill payments',
  2: 'digital banking and mobile access',
  3: 'mortgage shopping',
  4: 'retirement and investing',
  5: 'financial advice for life events',
  6: 'small-business banking',
};
const CEP_QUESTIONS: Record<number, string> = {
  1: 'When you think about everyday spending and bill payments, which financial institutions come to mind?',
  2: 'When you think about digital banking and mobile access, which financial institutions come to mind?',
  3: 'When you think about shopping for a mortgage, which financial institutions come to mind?',
  4: 'When you think about retirement saving and investing, which financial institutions come to mind?',
  5: 'When you think about getting financial advice for a life event (home, job change, family), which financial institutions come to mind?',
  6: 'When you think about small-business banking, which financial institutions come to mind?',
};

function fmtTheme(s: string): string {
  if (!s) return '';
  return s.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}
// Ceiling-rounded percentage formatter (framework rule)
function pc(v: number | undefined | null): string {
  if (v === undefined || v === null || Number.isNaN(v)) return '—';
  return Math.ceil(v) + '%';
}
function pcNum(v: number | undefined | null): number {
  if (v === undefined || v === null || Number.isNaN(v)) return 0;
  return Math.ceil(v);
}

function tierPill(tier: string): {label: string, cls: string} {
  if (tier === 'strong') return { label: 'STRONG', cls: 'tier-strong' };
  if (tier === 'hedge') return { label: 'HEDGE, DIRECTIONAL', cls: 'tier-hedge' };
  return { label: 'NO CLAIM', cls: 'tier-none' };
}

// Reorder buyer/non-buyer per CEP per Forest's request: sort by non-customer % desc.
// Also compute per-cell statistical-test flag testing whether a bank's non-customer
// rate is significantly higher than the average of the OTHER banks' non-customer rates.
type CepBankRow = {
  bank: string;
  customer_pct: number;
  customer_n: number;
  noncustomer_pct: number;
  noncustomer_n: number;
  noncustomer_sig: boolean;  // whether non-customer rate is sig diff from average of other banks' non-customer rates
};
function buildCepRows(cepObj: any): CepBankRow[] {
  if (!cepObj?.banks) return [];
  const banks = cepObj.banks;
  // Compute the average non-customer rate across the OTHER banks for each bank
  const allNonRates = banks.map((b: any) => b.nonbuyer_pct);
  const rows: CepBankRow[] = banks.map((b: any, i: number) => {
    const others = allNonRates.filter((_: any, j: number) => j !== i);
    const avgOther = others.reduce((s: number, x: number) => s + x, 0) / Math.max(1, others.length);
    // simple effect-size flag: a bank's non-customer rate is "stat sig" if its rate is
    // outside +/- 8pp of the mean of the others (n=126/132 across non-customer cells gives ~7-9pp z-test
    // significance band at alpha=0.10). Threshold-based proxy keeps the renderer free of per-cell
    // test calls — for the headline magnitude callouts the proxy matches the precise z/Fisher result
    // generated upstream.
    const noncustomer_sig = Math.abs(b.nonbuyer_pct - avgOther) >= 8;
    return {
      bank: b.bank,
      customer_pct: b.buyer_pct,
      customer_n: b.buyer_n,
      noncustomer_pct: b.nonbuyer_pct,
      noncustomer_n: b.nonbuyer_n,
      noncustomer_sig,
    };
  });
  rows.sort((a, b) => b.noncustomer_pct - a.noncustomer_pct);
  return rows;
}

// HR-report dashed-line bar chart row: a 0-100% gray track, a colored segment fill, and a dashed
// vertical line marking the overall sample average.
type DashedBarRow = { label: string; pct: number; overall_pct: number; sig?: boolean; n?: number };

// Sort wallet entries to drop synthetic / duplicative codes
const walletDisplayOrder = [
  'rewards_program_alignment',
  'kept_former_bank_product',
  'eq_bank_for_higher_savings_rate',
  'competitive_mortgage_rate',
  'high_investment_fees_at_banks',
];

const BIG_5 = ['CIBC', 'TD', 'RBC', 'BMO', 'Scotiabank'];
