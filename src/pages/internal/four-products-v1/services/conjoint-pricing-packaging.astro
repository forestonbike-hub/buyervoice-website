import ServiceLayout from '../../../../layouts/FourProductsServiceLayout.astro';
---

<ServiceLayout
  serviceName="Conjoint: Pricing and Packaging"
  headline="What will buyers pay and which features do they value?"
  subhead="Choice-based conjoint with customers and prospects reveals willingness to pay per feature, a ranked value hierarchy across your full feature set, and a market simulator for testing pricing and packaging scenarios before you launch."
  description="KwantumLabs Conjoint: Pricing and Packaging uses behavioral choice data to measure what buyers actually value through forced trade-offs, producing willingness-to-pay estimates that are grounded in behavior rather than stated preference."
  buyingTriggers={[
    "You're setting a price for a new product or tier and need something more defensible than competitive benchmarking or cost-plus math",
    "Your current packaging places high-value features in low-priced tiers, leaving revenue on the table",
    "Internal teams disagree about which features belong in which tier, and the debate is blocking a launch decision",
    "Sales reps are discounting because they can't defend pricing with evidence, and you need a value anchor to stop the erosion",
    "You want to test 3-4 pricing scenarios before committing to a go-to-market strategy",
    "You need to know which features are table stakes, which justify a premium, and which to stop investing in",
  ]}
  deliverables={[
    { name: 'Willingness-to-pay estimates', description: 'Precise dollar values for each feature and bundle configuration, by segment. The range of WTP across the full respondent set, showing where the market is homogeneous and where it is price-sensitive.' },
    { name: 'Feature value hierarchy', description: 'Every feature ranked by the incremental willingness-to-pay it adds to a bundle, from highest to lowest. Shows which features justify a tier upgrade and which you are currently misplacing.' },
    { name: 'Market simulator', description: 'A scenario model you can use to test different pricing and packaging configurations and see predicted market share before going to market. Leadership can compare the revenue-maximizing price, the adoption-maximizing price, and any configurations in between.' },
    { name: 'Price sensitivity curves', description: 'Demand curves showing how predicted market share changes as price increases or decreases, with the revenue-maximizing and adoption-maximizing price points marked.' },
    { name: 'Segment WTP comparison', description: 'Willingness-to-pay ranges by segment for each tier, showing where to anchor pricing page messaging and whether persona-specific messaging is worth building.' },
    { name: 'Substitute vs. complement table', description: 'Which features compete with each other inside a bundle and which amplify each other, informing which features should be separated across tiers and which should be grouped together.' },
  ]}
  approach={[
    "Conjoint: Pricing and Packaging uses choice-based conjoint, the gold standard methodology for measuring willingness to pay. Participants see realistic product configurations at different price points and choose between them, the same cognitive process buyers go through when evaluating a purchase. Because the method forces trade-offs rather than asking buyers to rate things on a scale, it produces behavior-grounded estimates rather than hypothetical preferences.",
    "The study is designed around the specific features, tiers, and price ranges relevant to your product. Our team works with you to define the attribute set, the levels within each attribute, and the price ranges to test, drawing on our published research in conjoint methodology and pricing science. Felix Eggers, our Scientific Advisor and one of the world's leading authorities on conjoint analysis, oversees the study design.",
    "The deliverable includes a market simulator, a working model you can use to run scenario planning before committing to a packaging strategy. Instead of launching and adjusting, you can test 3-4 configurations, compare the projected market share at each, and present a defensible rationale to leadership based on measured buyer behavior rather than internal opinion.",
  ]}
  timeline="Most Conjoint: Pricing and Packaging engagements are completed in 3-4 weeks from kickoff to final presentation, including study design, data collection, analysis, and modeling."
  investment="Typical investment: $40,000-$80,000, depending on the number of attributes, levels, segments, and markets included."
  scopeNote="A standard study with 6-8 attributes, two segments, and a single market sits at the lower end. Studies with more attributes, multiple international markets, or a conjoint + sales transcript augmentation component sit at the upper end."
  faqs={[
    { question: 'How is conjoint analysis different from asking buyers what they would pay?', answer: 'When you ask buyers directly what they would pay, they almost always understate it. Conjoint works differently: buyers choose between realistic product configurations at actual price points, the same choice they would make in real life. Because they are forced to trade off features against price, the method captures revealed preference rather than stated preference. The resulting estimates are significantly more reliable for pricing decisions.' },
    { question: 'What types of features or attributes can be tested?', answer: 'Conjoint can test any feature, attribute, or dimension that varies in your product or competitive landscape: functionality (which features are included), quality levels, service terms, pricing structure (per seat vs. flat fee), support tiers, contract length, and others. Our team works with you to define the attribute set that matches your actual pricing decision.' },
    { question: 'How many respondents do you need?', answer: 'A standard study requires 200-300 respondents depending on the number of attributes and the number of segments you want to analyze separately. We work with you to determine the right sample size for the precision level you need.' },
    { question: 'Can you include a sales transcript augmentation?', answer: 'Yes. The conjoint + sales transcript augmentation is a unique add-on where you provide sales call recordings and we use that data to further validate and improve the conjoint model\'s recommendations. It is particularly valuable for B2B pricing decisions where the sales call contains objection patterns and price sensitivity signals that can calibrate the conjoint output.' },
    { question: 'What does the market simulator deliverable include?', answer: 'The market simulator is a model showing predicted market share at different price and feature combinations. You input a pricing and packaging scenario and the model outputs predicted adoption, along with the revenue impact of each configuration. Leadership can compare scenarios side by side and choose the strategy that best matches their objective.' },
    { question: 'How long does it take?', answer: 'Most engagements are completed in 3-4 weeks from kickoff to final presentation, including study design, fielding, analysis, and the market simulator build.' },
  ]}
/>
