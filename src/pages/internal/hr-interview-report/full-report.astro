<style>
:root {
  --ink: #0B1F3A;
  --paper: #F7F5EF;
  --signal: #B8341B;
  --rule: #1A1A1A;
  --muted: #6B6B6B;
  --border: rgba(11, 31, 58, 0.10);
  --card-bg: rgba(11, 31, 58, 0.03);
  --serif: 'Fraunces', Georgia, serif;
  --sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.7; }
  button { font-family: inherit; }

  .print-bar { background: var(--ink); color: #fff; padding: 16px 24px; text-align: center; font-size: 15px; font-weight: 600; }
  .print-bar button { background: var(--paper); color: var(--ink); border: none; padding: 10px 24px; border-radius: 2px; font-size: 14px; font-weight: 700; cursor: pointer; margin-left: 16px; }
  .print-bar button:hover { background: transparent; }
  .print-bar a { color: #fff; margin-left: 16px; text-decoration: underline; font-weight: 400; }

  .container { max-width: 900px; margin: 0 auto; padding: 0 32px; }
  .page-break { page-break-before: always; padding-top: 48px; }
  .section { padding: 48px 0; border-bottom: 1px solid var(--border); }
  .section:last-child { border-bottom: none; }

  h1 { font-family: var(--serif); font-size: 32px; font-weight: 700; color: var(--ink); margin-bottom: 8px; }
  h2 { font-family: var(--serif); font-size: 24px; font-weight: 700; color: var(--ink); margin-bottom: 8px; margin-top: 32px; }
  h3 { font-family: var(--serif); font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 8px; margin-top: 24px; }
  p { font-size: 14px; color: var(--rule); margin-bottom: 12px; }
  .overline { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--ink); margin-bottom: 4px; }
  .subtitle { font-size: 16px; color: var(--rule); margin-bottom: 32px; }

  /* Cover */
  .cover { text-align: center; padding: 120px 32px 80px; }
  .cover h1 { font-size: 38px; margin-bottom: 16px; }
  .cover .subtitle { font-size: 18px; }
  .cover .meta { font-size: 14px; color: var(--muted); margin-top: 32px; }
  .cover .logo { font-family: var(--serif); font-size: 28px; font-weight: 700; color: var(--ink); margin-bottom: 48px; }

  /* Data tables */
  table { width: 100%; border-collapse: collapse; margin: 16px 0 24px; font-size: 13px; }
  th { text-align: left; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--rule); padding: 10px 12px; border-bottom: 2px solid var(--border); }
  td { padding: 10px 12px; border-bottom: 1px solid #F0F0F0; }
  tr:hover { background: #F9FAFB; }

  /* Bars */
  .bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .bar-label { width: 200px; font-size: 13px; font-weight: 500; text-align: right; }
  .bar-track { flex: 1; height: 22px; background: #F0F0F0; border-radius: 2px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 2px; display: flex; align-items: center; padding-left: 8px; min-width: 20px; }
  .bar-fill.green { background: var(--ink); }
  .bar-fill.blue { background: var(--ink); opacity: 0.75; }
  .bar-fill.amber { background: #C08533; }
  .bar-fill.gray { background: rgba(11, 31, 58, 0.35); }
  .bar-val { font-size: 11px; font-weight: 700; color: #fff; }
  .bar-pct { font-size: 12px; font-weight: 600; color: var(--rule); width: 45px; }

  /* Insight boxes */
  .insight { border-left: 4px solid var(--ink); background: transparent; padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 16px 0; }
  .insight p { font-size: 13px; margin-bottom: 0; }
  .insight strong { color: var(--ink); }

  .quote { border-left: 4px solid var(--ink); padding: 12px 20px; background: #F9FAFB; border-radius: 0 6px 6px 0; margin: 12px 0; }
  .quote p { font-style: italic; font-size: 13px; margin-bottom: 4px; }
  .quote .attr { font-size: 11px; font-style: normal; color: var(--muted); }

  /* Stats */
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 16px 0; }
  .stat-card { text-align: center; padding: 16px; background: var(--card-bg); border-radius: 2px; }
  .stat-num { font-family: var(--serif); font-size: 28px; font-weight: 700; color: var(--ink); }
  .stat-label { font-size: 11px; color: var(--rule); margin-top: 4px; }

  /* Heatmap */
  .heatmap { overflow-x: auto; }
  .heatmap table { min-width: 600px; }
  .heatmap td.heat-0 { background: var(--paper); }
  .heatmap td.heat-1 { background: rgba(11, 31, 58, 0.04); }
  .heatmap td.heat-2 { background: rgba(11, 31, 58, 0.10); }
  .heatmap td.heat-3 { background: rgba(11, 31, 58, 0.20); }
  .heatmap td.heat-4 { background: rgba(11, 31, 58, 0.34); }
  .heatmap td.heat-5 { background: rgba(11, 31, 58, 0.78); color: #fff; }
  .heatmap td.heat-open { background: var(--card-bg); font-weight: 600; }

  .footer-print { text-align: center; padding: 32px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--border); margin-top: 48px; }

  @media print {
    .print-bar { display: none; }
    body { font-size: 12px; }
    .cover { padding: 80px 0 60px; }
    .page-break { page-break-before: always; }
    .section { padding: 32px 0; }
    .stat-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
<script>
  function printReport() {
    window.print();
  }
</script>
