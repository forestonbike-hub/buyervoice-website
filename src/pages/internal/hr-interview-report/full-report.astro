<!-- EXECUTIVE SUMMARY -->
<div class="section page-break">
  <p class="overline">Executive Summary</p>
  <h1>Key Findings</h1>

  <div class="stat-grid">
    <div class="stat-card"><div class="stat-num">99%</div><div class="stat-label">Aided awareness</div></div>
    <div class="stat-card"><div class="stat-num">70%</div><div class="stat-label">Cite rapid growth as trigger</div></div>
