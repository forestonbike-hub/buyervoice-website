---
import fs from 'node:fs';
import path from 'node:path';

let dataAvailable = true;
let data: any = null;
try {
  const dataPath = path.resolve(process.cwd(), '../../research-projects/Interview Projects/Retail Banking CIBC/A6 Data Files - Simulated/report-stats.json');
  data = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
} catch {
  dataAvailable = false;
}

const meta = data?.meta;
const sample = data?.sample;
const ma = data?.mental_availability;
const cr = data?.competitive_rejection;
const pf = data?.push_forces;
const likes = data?.current_bank_likes_by_bank;
const frus = data?.current_bank_frustrations_by_bank;
const prevPos = data?.previous_bank_positives_by_bank;
const sel = data?.selection_criteria_by_bank;
const cw = data?.consideration_to_win;
const walletPrimary = data?.wallet_primary;
const walletElsewhere = data?.wallet_elsewhere;
const propensity = data?.propensity_by_bank;
const propReasoning = data?.propensity_reasoning;
const macro = data?.macro_sentiment;
const segPrimary = data?.segments_primary;
const segBig5 = data?.segments_secondary_big5;
const languageBank = data?.language_bank;

const BANKS = ['CIBC', 'Simplii Financial', 'RBC', 'TD', 'BMO', 'Scotiabank'];
const BANK_COLORS: Record<string, string> = {
  'CIBC': '#C41E3A',
  'Simplii Financial': '#E87722',
  'RBC': '#0051A5',
  'TD': '#4CAF50',
  'BMO': '#0079C1',
  'Scotiabank': '#E7211A',
};

function fmtPct(n: number | undefined): string {
  if (n === undefined || n === null) return '—';
  return `${n.toFixed(1)}%`;
}

function barWidth(pct: number, max = 100): number {
  return Math.max(2, Math.min(100, (pct / max) * 100));
}
