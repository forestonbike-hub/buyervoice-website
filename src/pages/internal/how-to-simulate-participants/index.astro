<body>

  <!-- HEADER -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo-link">
        <span class="bv-logo" aria-label="BuyerVoice.AI" style="font-family:'Fraunces',Georgia,serif;display:inline-flex;align-items:baseline;line-height:1;"><span style="font-size:24px;font-weight:600;color:#0B1F3A;letter-spacing:-0.02em;">BuyerVoice</span><span style="font-size:16px;font-weight:500;color:#B8341B;letter-spacing:-0.01em;margin-left:1px;">.AI</span></span>
      </a>
