              <circle cx="16" cy="20" r="4" fill="var(--ink)" opacity="0.6"/>
              <circle cx="30" cy="18" r="3" fill="#D4A843" opacity="0.7"/>
              <circle cx="20" cy="30" r="3.5" fill="#2B8C96" opacity="0.7"/>
