      <p><strong>The two segments represent fundamentally different buying motives.</strong> {segNames[0]} chose based on price (78% vs. 38%), UI intuitiveness (70% vs. 31%), and implementation support (58% vs. 33%). {segNames[1]} chose based on platform unification (40% vs. 5%), IT device management (40% vs. 5%), and were triggered by system integration needs (56% vs. 16%) and investor pressure (44% vs. 14%). These patterns suggest that a single marketing message will not reach both groups effectively.</p>
    </div>

  </div>
</details>

</div> <!-- end container -->

<div class="footer-print">
  <p style="text-transform:uppercase;letter-spacing:0.08em;">BuyerVoice.AI &bull; HR Leaders BGR Interview Research Report &bull; April 2026</p>
</div>

<!-- Verbatim drill-down data -->
<Fragment set:html={vdScript} />

<!-- Verbatim modal -->
<div class="vb-overlay" id="vbOverlay">
  <div class="vb-dialog">
    <button class="vb-close" id="vbClose">&times;</button>
    <div class="vb-header">
      <h3 id="vbTitle"></h3>
      <p id="vbSubtitle"></p>
    </div>
    <div class="vb-body" id="vbBody"></div>
  </div>
</div>

<script is:inline>
(function(){
  var VD = window.__VD;
  var VQ = window.__VQ;
  if (!VD || !VQ) return;

  function escHtml(s) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(s));
    return d.innerHTML;
  }

  /* --- Map each section to its question IDs and chart type --- */
  /* Thematic bar charts use qf.QX.codes with formatLabel; categorical use categories/buckets */
  /* We detect question IDs from the source-note text "Source: QX." */

  function annotateCharts() {
    var sourceNotes = document.querySelectorAll('.source-note');
    sourceNotes.forEach(function(note) {
      var m = note.textContent.match(/Source:\s*Q(\d+)\./);
      if (!m) return;
      var qid = 'Q' + m[1];

      /* Only annotate thematic questions (ones that have codes in VD) */
      var thematicQs = ['Q4','Q7','Q8','Q9','Q11','Q12','Q14','Q15','Q16','Q17','Q18','Q19','Q24'];
      var catQs = ['Q1','Q10','Q13','Q21'];

      var isThematic = thematicQs.indexOf(qid) !== -1;
      var isCat = catQs.indexOf(qid) !== -1;
      if (!isThematic && !isCat) return;

      /* The bar-chart div is the sibling before this source-note */
      var barChart = note.previousElementSibling;
      while (barChart && !barChart.classList.contains('bar-chart')) {
        barChart = barChart.previousElementSibling;
      }
      if (!barChart) return;

      var rows = barChart.querySelectorAll('.bar-row');
      rows.forEach(function(row) {
        var labelEl = row.querySelector('.bar-label');
        if (!labelEl) return;
        var label = labelEl.textContent.trim();
        row.setAttribute('data-drilldown', 'true');
        row.setAttribute('data-q', qid);
        row.setAttribute('data-code', label);
        row.setAttribute('data-type', isThematic ? 'code' : 'cat');
      });
    });
  }

  annotateCharts();

  /* --- Modal logic --- */
  var overlay = document.getElementById('vbOverlay');
  var titleEl = document.getElementById('vbTitle');
  var subtitleEl = document.getElementById('vbSubtitle');
  var bodyEl = document.getElementById('vbBody');
  var closeBtn = document.getElementById('vbClose');

  function openModal(qid, codeName, matchType) {
    var matches = [];
    VD.forEach(function(p) {
      var hit = false;
      if (matchType === 'code') {
        var codes = p.c[qid];
        if (codes) {
          for (var i = 0; i < codes.length; i++) {
            if (codes[i].toLowerCase() === codeName.toLowerCase()) {
              hit = true;
              break;
            }
          }
        }
      } else {
        var cat = p.cat[qid];
        if (cat && cat.toLowerCase() === codeName.toLowerCase()) {
          hit = true;
        }
      }
      if (hit && p.v[qid]) {
        matches.push(p);
      }
    });

    titleEl.textContent = codeName + ' (' + matches.length + ' participant' + (matches.length !== 1 ? 's' : '') + ')';
    subtitleEl.textContent = VQ[qid] || '';

    bodyEl.innerHTML = '';
    if (matches.length === 0) {
      bodyEl.innerHTML = '<p style="color:#6B7280;font-size:13px;">No matching verbatims found.</p>';
    } else {
      matches.forEach(function(p) {
        var card = document.createElement('div');
        card.className = 'vb-card';

        var fullText = p.v[qid];
        var truncated = fullText.length > 500;
        var shortText = truncated ? fullText.substring(0, 500) + '...' : fullText;

        var quoteDiv = document.createElement('div');
        quoteDiv.className = 'vb-quote';
        quoteDiv.textContent = shortText;
        card.appendChild(quoteDiv);

        if (truncated) {
          var moreBtn = document.createElement('button');
          moreBtn.className = 'vb-more';
          moreBtn.textContent = 'Show more';
          var expanded = false;
          moreBtn.addEventListener('click', function() {
            expanded = !expanded;
            quoteDiv.textContent = expanded ? fullText : shortText;
            moreBtn.textContent = expanded ? 'Show less' : 'Show more';
          });
          card.appendChild(moreBtn);
        }

        var tagsDiv = document.createElement('div');
        tagsDiv.className = 'vb-tags';
        var tags = [p.sen, p.sz, p.ind, p.tool].filter(Boolean);
        tags.forEach(function(t) {
          var span = document.createElement('span');
          span.className = 'vb-tag';
          span.textContent = t;
          tagsDiv.appendChild(span);
        });
        card.appendChild(tagsDiv);

        bodyEl.appendChild(card);
      });
    }

    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  document.addEventListener('click', function(e) {
    var row = e.target.closest('[data-drilldown]');
    if (!row) return;
    var qid = row.getAttribute('data-q');
    var code = row.getAttribute('data-code');
    var type = row.getAttribute('data-type') || 'code';
    openModal(qid, code, type);
  });
})();
</script>

</body>
</html>
)}
