    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-body);
      color: var(--color-black);
      background: var(--color-white);
      line-height: 1.6;
      font-size: 16px;
    }

