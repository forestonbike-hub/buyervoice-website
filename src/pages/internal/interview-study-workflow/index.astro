        <div class="step-body">
          <div class="agent-spec">
            <div class="agent-spec-title">Agent Configuration</div>
            <div class="agent-spec-grid">
              <div class="agent-spec-row"><span class="agent-label">Key</span><span class="agent-value"><code>clusterer</code></span></div>
