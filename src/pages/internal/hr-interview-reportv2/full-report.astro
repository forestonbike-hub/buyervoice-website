<Fragment set:html={dataScript} />

<script is:inline>
// Toggle + / x icon text based on open state
document.querySelectorAll('.accordion').forEach(d => {
  d.addEventListener('toggle', () => {
    const icon = d.querySelector('.accordion-icon');
    if (icon) icon.textContent = d.open ? '\u00d7' : '+';
  });
});

// Print function: open all accordions, print, then restore
function printReport() {
  const accordions = document.querySelectorAll('details.accordion');
  const previousStates = [];
  accordions.forEach(d => {
    previousStates.push(d.open);
    d.open = true;
  });
  setTimeout(() => {
    window.print();
    setTimeout(() => {
      accordions.forEach((d, i) => {
        d.open = previousStates[i];
        const icon = d.querySelector('.accordion-icon');
        if (icon) icon.textContent = d.open ? '\u00d7' : '+';
      });
    }, 500);
  }, 100);
}

// ── Verbatim drill-down ──────────────────────────────────────────
var VD = window.__VD || [];
var QUESTIONS = window.__QS || {};

function escHtml(s) {
  var d = document.createElement('div');
  d.textContent = s || '';
  return d.innerHTML;
}

function filterParticipants(filters) {
  return VD.filter(function(p) {
    return filters.every(function(f) {
      if (f.type === 'rejection') {
        return (p['Q3.8_rejections'] || []).some(function(r) {
          return r.tool === f.tool && r.rejection_themes.includes(f.theme);
        });
      }
      var v = p[f.field];
      if (f.negate) {
        if (Array.isArray(v)) return !v.includes(f.value);
        return v !== f.value;
      }
      if (v === undefined || v === null) return false;
      if (Array.isArray(v)) return v.includes(f.value);
      return v === f.value;
    });
  });
}

// Chart filter configurations
var CHARTS = {
  'satisfaction': {
    q: 'Q2.4',
    filters: function(l) { return [{ field: 'Q5.1_main_tool', value: l.replace(/ \(n=\d+\)/, '') }]; },
    groupBy: 'Q2.4_satisfaction_level',
    groups: [
      { value: 'Very satisfied', label: 'Very Satisfied', color: 'var(--ink)' },
      { value: 'Somewhat satisfied', label: 'Somewhat Satisfied', color: 'var(--ink)' },
      { value: 'Neutral / mixed', label: 'Neutral / Mixed', color: '#94A3B8' },
      { value: 'Somewhat dissatisfied', label: 'Somewhat Dissatisfied', color: '#F59E0B' },
      { value: 'Very dissatisfied', label: 'Very Dissatisfied', color: '#EF4444' }
    ]
  },
  'frustrations-nonuser': {
    q: 'Q2.5',
    filters: function(l) { return [{ field: 'Q2.5_frustration_themes', value: l }, { field: 'is_bamboohr_user', value: false }]; },
    groupBy: 'Q2.5_frustration_intensity',
    groups: [
      { value: 'High', label: 'High Intensity', color: '#EF4444' },
      { value: 'Moderate', label: 'Moderate Intensity', color: '#F59E0B' },
      { value: 'Low', label: 'Low Intensity', color: '#94A3B8' }
    ]
  },
  'frustrations-user': {
    q: 'Q2.5',
    filters: function(l) { return [{ field: 'Q2.5_frustration_themes', value: l }, { field: 'is_bamboohr_user', value: true }]; },
    groupBy: 'Q2.5_frustration_intensity',
    groups: [
      { value: 'High', label: 'High Intensity', color: '#EF4444' },
      { value: 'Moderate', label: 'Moderate Intensity', color: '#F59E0B' },
      { value: 'Low', label: 'Low Intensity', color: '#94A3B8' }
    ]
  },
  'motivations': {
    q: 'Q3.3',
    filters: function(l) { return [{ field: 'Q3.3_Q3.4_motivation_themes', value: l }]; }
  },
  'attraction': {
    q: 'Q3.7',
    filters: function(l) { return [{ field: 'Q3.7_purchase_drivers', value: l }]; }
  },
  'rejection-BambooHR': {
    q: 'Q3.8',
    filters: function(l) { return [{ type: 'rejection', tool: 'BambooHR', theme: l }]; }
  },
  'rejection-Workday': {
    q: 'Q3.8',
    filters: function(l) { return [{ type: 'rejection', tool: 'Workday', theme: l }]; }
  },
  'rejection-Greenhouse': {
    q: 'Q3.8',
    filters: function(l) { return [{ type: 'rejection', tool: 'Greenhouse', theme: l }]; }
  },
  'rejection-Lever': {
    q: 'Q3.8',
    filters: function(l) { return [{ type: 'rejection', tool: 'Lever', theme: l }]; }
  },
  'sentiment-bamboohr': {
    q: 'Q4.1',
    filters: function(l) {
      return l.startsWith('Users') ? [{ field: 'is_bamboohr_user', value: true }] : [{ field: 'is_bamboohr_user', value: false }];
    },
    groupBy: 'Q4.1_sentiment',
    groups: [
      { value: 'Positive', label: 'Positive', color: 'var(--ink)' },
      { value: 'Neutral', label: 'Neutral', color: '#94A3B8' },
      { value: 'Mixed', label: 'Mixed', color: '#F59E0B' },
      { value: 'Negative', label: 'Negative', color: '#EF4444' }
    ]
  },
  'sentiment-workday': {
    q: 'Q4.2',
    filters: function(l) {
      return l.startsWith('Users') ? [{ field: 'Q5.1_main_tool', value: 'Workday' }] : [{ field: 'Q5.1_main_tool', value: 'Workday', negate: true }];
    },
    groupBy: 'Q4.2_sentiment',
    groups: [
      { value: 'Positive', label: 'Positive', color: 'var(--ink)' },
      { value: 'Neutral', label: 'Neutral', color: '#94A3B8' },
      { value: 'Mixed', label: 'Mixed', color: '#F59E0B' },
      { value: 'Negative', label: 'Negative', color: '#EF4444' }
    ]
  },
  'sentiment-greenhouse': {
    q: 'Q4.3',
    filters: function(l) {
      return l.startsWith('Users') ? [{ field: 'Q5.1_main_tool', value: 'Greenhouse' }] : [{ field: 'Q5.1_main_tool', value: 'Greenhouse', negate: true }];
    },
    groupBy: 'Q4.3_sentiment',
    groups: [
      { value: 'Positive', label: 'Positive', color: 'var(--ink)' },
      { value: 'Neutral', label: 'Neutral', color: '#94A3B8' },
      { value: 'Mixed', label: 'Mixed', color: '#F59E0B' },
      { value: 'Negative', label: 'Negative', color: '#EF4444' }
    ]
  },
  'perception-bamboohr-users': {
    q: 'Q4.1',
    filters: function(l) { return [{ field: 'Q4.1_description_themes', value: l }, { field: 'is_bamboohr_user', value: true }]; }
  },
  'perception-bamboohr-nonusers': {
    q: 'Q4.1',
    filters: function(l) { return [{ field: 'Q4.1_description_themes', value: l }, { field: 'is_bamboohr_user', value: false }]; }
  },
  'perception-workday-users': {
    q: 'Q4.2',
    filters: function(l) { return [{ field: 'Q4.2_description_themes', value: l }, { field: 'Q5.1_main_tool', value: 'Workday' }]; }
  },
  'perception-workday-nonusers': {
    q: 'Q4.2',
    filters: function(l) { return [{ field: 'Q4.2_description_themes', value: l }, { field: 'Q5.1_main_tool', value: 'Workday', negate: true }]; }
  },
  'perception-greenhouse-users': {
    q: 'Q4.3',
    filters: function(l) { return [{ field: 'Q4.3_description_themes', value: l }, { field: 'Q5.1_main_tool', value: 'Greenhouse' }]; }
  },
  'perception-greenhouse-nonusers': {
    q: 'Q4.3',
    filters: function(l) { return [{ field: 'Q4.3_description_themes', value: l }, { field: 'Q5.1_main_tool', value: 'Greenhouse', negate: true }]; }
  },
  'challenges': {
    q: 'Q5.5',
    filters: function(l) { return [{ field: 'Q5.5_challenge_themes', value: l }]; }
  }
};

// Annotate rows within a container as clickable
function annotateRows(container, rowSel, lblSel, chartId) {
  if (!container) return;
  container.querySelectorAll(rowSel).forEach(function(row) {
    var labelEl = row.querySelector(lblSel);
    if (!labelEl) return;
    row.dataset.drilldown = 'true';
    row.dataset.chartId = chartId;
    row.dataset.label = labelEl.textContent.trim();
  });
}

function getSection(id) {
  var el = document.getElementById(id);
  return el ? el.querySelector('.accordion-body') : null;
}

// Section 4: Satisfaction + Frustrations
var s4 = getSection('section-4');
if (s4) {
  annotateRows(s4.querySelector('.chart-group'), '.sentiment-row', '.sentiment-label', 'satisfaction');
  var s4bars = s4.querySelectorAll(':scope > .bar-chart');
  annotateRows(s4bars[0], '.bar-row', '.bar-label', 'frustrations-nonuser');
  annotateRows(s4bars[1], '.bar-row', '.bar-label', 'frustrations-user');
}

// Section 5: Motivations
var s5 = getSection('section-5');
if (s5) {
  annotateRows(s5.querySelector(':scope > .bar-chart'), '.bar-row', '.bar-label', 'motivations');
}

// Section 6: Attraction + Rejections
var s6 = getSection('section-6');
if (s6) {
  var s6bars = s6.querySelectorAll(':scope > .bar-chart');
  // [0]=timeline, [1]=tools count, [2]=attraction, [3-6]=rejections
  annotateRows(s6bars[2], '.bar-row', '.bar-label', 'attraction');
  annotateRows(s6bars[3], '.bar-row', '.bar-label', 'rejection-BambooHR');
  annotateRows(s6bars[4], '.bar-row', '.bar-label', 'rejection-Workday');
  annotateRows(s6bars[5], '.bar-row', '.bar-label', 'rejection-Greenhouse');
  annotateRows(s6bars[6], '.bar-row', '.bar-label', 'rejection-Lever');
}

// Section 7: Sentiment + Perceptions
var s7 = getSection('section-7');
if (s7) {
  var s7cg = s7.querySelectorAll(':scope > .chart-group');
  // [0]=legend/header, [1]=BambooHR, [2]=Workday, [3]=Greenhouse
  annotateRows(s7cg[1], '.sentiment-row', '.sentiment-label', 'sentiment-bamboohr');
  annotateRows(s7cg[2], '.sentiment-row', '.sentiment-label', 'sentiment-workday');
  annotateRows(s7cg[3], '.sentiment-row', '.sentiment-label', 'sentiment-greenhouse');

  var brands = ['bamboohr', 'workday', 'greenhouse'];
  var s7twocol = s7.querySelectorAll(':scope > .two-col');
  s7twocol.forEach(function(tc, i) {
    var divs = tc.querySelectorAll(':scope > div');
    if (divs[0]) annotateRows(divs[0].querySelector('.bar-chart'), '.bar-row', '.bar-label', 'perception-' + brands[i] + '-users');
    if (divs[1]) annotateRows(divs[1].querySelector('.bar-chart'), '.bar-row', '.bar-label', 'perception-' + brands[i] + '-nonusers');
  });
}

// Section 9: Challenges
var s9 = getSection('section-9');
if (s9) {
  annotateRows(s9.querySelector(':scope > .bar-chart'), '.bar-row', '.bar-label', 'challenges');
}

// Click handler (event delegation)
document.addEventListener('click', function(e) {
  var row = e.target.closest('[data-drilldown]');
  if (!row) return;

  var chartId = row.dataset.chartId;
  var label = row.dataset.label;
  var cfg = CHARTS[chartId];
  if (!cfg) return;

  var filters = cfg.filters(label);
  var matches = filterParticipants(filters);
  var qIds = cfg.q === 'Q3.3' ? ['Q3.3', 'Q3.4'] : [cfg.q];

  showVerbatimModal(label, qIds, matches, cfg);
});

function renderCard(p, qIds) {
  var responses = qIds.map(function(q) { return p.verbatims[q]; }).filter(Boolean);
  var response = responses.join(' ');
  if (!response) return '';
  var tagStyle = 'display:inline-block;font-size:11px;background:var(--border);color:var(--rule);padding:2px 8px;border-radius:10px;font-weight:500;margin:0 4px 4px 0;';
  return '<div class="vb-card">' +
    '<p class="vb-quote">' + escHtml(response) + '</p>' +
    '<div class="vb-tags" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;">' +
      '<span style="' + tagStyle + '">' + escHtml(p['Q1.1_seniority']) + '</span>' +
      '<span style="' + tagStyle + '">' + escHtml(p['Q1.2_company_size']) + '</span>' +
      '<span style="' + tagStyle + '">' + escHtml(p['Q1.2_industry']) + '</span>' +
      '<span style="' + tagStyle + '">' + escHtml(p['Q5.1_main_tool']) + '</span>' +
    '</div></div>';
}

function showVerbatimModal(label, qIds, participants, cfg) {
  var modal = document.getElementById('vb-modal');
  var qText = qIds.map(function(q) { return QUESTIONS[q]; }).filter(Boolean).join(' | ');

  modal.querySelector('.vb-title').textContent = label;
  modal.querySelector('.vb-context').textContent =
    participants.length + ' participant' + (participants.length !== 1 ? 's' : '') + ' matched';
  modal.querySelector('.vb-question').textContent = qText;

  var body = modal.querySelector('.vb-body');
  if (participants.length === 0) {
    body.innerHTML = '<p style="color:var(--muted);text-align:center;padding:32px;">No matching verbatim responses found.</p>';
  } else if (cfg && cfg.groupBy && cfg.groups) {
    // Group participants by sub-coding with colored banners
    var grouped = {};
    cfg.groups.forEach(function(g) { grouped[g.value] = []; });
    participants.forEach(function(p) {
      var val = p[cfg.groupBy];
      if (grouped[val]) grouped[val].push(p);
    });
    var html = '';
    cfg.groups.forEach(function(g) {
      var people = grouped[g.value];
      if (!people || people.length === 0) return;
      html += '<div class="vb-group-banner" style="background:' + g.color + ';">' +
        escHtml(g.label) + ' (' + people.length + ')</div>';
      people.forEach(function(p) { html += renderCard(p, qIds); });
    });
    body.innerHTML = html;
  } else {
    body.innerHTML = participants.map(function(p) { return renderCard(p, qIds); }).filter(Boolean).join('');
  }

  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

// Close modal on overlay click, close button, or ESC
document.getElementById('vb-modal').addEventListener('click', function(e) {
  if (e.target.classList.contains('vb-overlay') || e.target.classList.contains('vb-close')) {
    e.target.closest('.vb-overlay').style.display = 'none';
    document.body.style.overflow = '';
  }
});
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    var m = document.getElementById('vb-modal');
    if (m.style.display === 'flex') { m.style.display = 'none'; document.body.style.overflow = ''; }
  }
});
</script>

