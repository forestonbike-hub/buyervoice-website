<tr><td style="text-align:left; font-weight:600;">Easy to use / simple</td><td class="above-avg">37%</td><td>26%</td><td>20%</td></tr>
<tr><td style="text-align:left; font-weight:600;">Good for basics</td><td>26%</td><td>26%</td><td class="above-avg">30%</td></tr>
<tr><td style="text-align:left; font-weight:600;">Not a recruiting specialist</td><td>37%</td><td>21%</td><td>17%</td></tr>
</table>
</div>
