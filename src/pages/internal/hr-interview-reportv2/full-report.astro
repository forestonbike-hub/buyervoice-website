---
import coded from '../../../data/hr-interview-reportv2/coded-data-v2.json';
import transcriptsRaw from '../../../data/hr-interview-reportv2/transcripts-v2-all.json';

const dataAvailable = true;
const QUESTIONS: Record<string, string> = {};
(transcriptsRaw as any).participants[0].transcript.forEach((t: any) => {
  QUESTIONS[t.question_id] = t.question;
});
const VD = (coded as any[]).map((p: any) => {
  const tp = (transcriptsRaw as any).participants.find((t: any) => t.participant_id === p.participant_id);
  const verbatims: Record<string, string> = {};
  if (tp) {
    tp.transcript.forEach((t: any) => { verbatims[t.question_id] = t.response; });
  }
  return { ...p, verbatims };
});
const dataScript = '<script>window.__VD=' + JSON.stringify(VD).replace(/<\//g, '<\\/') + ';window.__QS=' + JSON.stringify(QUESTIONS).replace(/<\//g, '<\\/') + ';<' + '/script>';
---
<!-- HR Interview Report V2 -->
