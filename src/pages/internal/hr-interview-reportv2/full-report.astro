<tr><td style="text-align:left; font-weight:600;">JazzHR</td><td>37%</td><td>0%</td><td>0%</td></tr>
<tr><td style="text-align:left; font-weight:600;">SAP SuccessFactors</td><td>0%</td><td>0%</td><td>33%</td></tr>
</table>
