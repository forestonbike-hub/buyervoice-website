<Fragment set:html={dataScript} />

<script is:inline>
const D = window.__SEG;

// Warn list
const warnings = D.dimensions
  .filter(d => d.stat && d.stat.warn)
  .map(d => {
    const s = d.stat;
    if (s.type_stat === 'binary') {
      const dir = s.pct_positive > 80 ? `${s.pct_positive}% positive (>80% — low variance)` : `${s.pct_positive}% positive (<20% — low variance)`;
      return `<strong>${d.label}</strong>: ${dir}`;
    }
    return `<strong>${d.label}</strong>: zero variance`;
  });

const warnList = document.getElementById('warn-list');
warnings.forEach(w => {
  const li = document.createElement('li');
  li.innerHTML = w;
  warnList.appendChild(li);
});
if (!warnings.length) {
  document.getElementById('warn-banner').style.display = 'none';
}

// Type color
function typeColor(t) {
  if (t === 'composite_binary' || t === 'binary_field') return 'var(--ink)';
  if (t === 'ordinal_encoded' || t === 'composite_ordinal') return '#2563EB';
  return '#9CA3AF';
}

function esc(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// Variance bar
function varianceBar(dim) {
  const s = dim.stat || {};
  if (s.type_stat === 'binary') {
    const pct = s.pct_positive || 0;
    const color = s.warn ? '#F59E0B' : 'var(--ink)';
    return `<div class="variance-inline">
      <div class="var-bar-track"><div class="var-bar-fill" style="width:${pct}%;background:${color}"></div></div>
      <span class="var-val" style="color:${s.warn?'#92400E':'var(--rule)'}">${pct}%</span>
    </div>`;
  }
  if (s.type_stat === 'ordinal') {
    const maxVal = s.max || 1;
    const fillPct = Math.round((s.mean / maxVal) * 100);
    const color = s.warn ? '#F59E0B' : '#2563EB';
    return `<div class="variance-inline">
      <div class="var-bar-track"><div class="var-bar-fill" style="width:${fillPct}%;background:${color}"></div></div>
      <span class="var-val">${s.min}&ndash;${s.max}</span>
    </div>`;
  }
  return '<span style="font-size:12px;color:#9CA3AF">passthrough</span>';
}

// Ordinal distribution bars
function ordinalDist(stat) {
  if (!stat.distribution) return '';
  const dist = stat.distribution;
  const keys = Object.keys(dist).map(Number).sort((a,b)=>a-b);
  const maxCount = Math.max(...keys.map(k => dist[k]));
  return keys.map(k => {
    const pct = Math.round(dist[k] / maxCount * 100);
    return `<div class="dist-row">
      <div class="dist-label">${k}</div>
      <div class="dist-track"><div class="dist-fill" style="width:${pct}%;background:#2563EB;opacity:0.7"></div></div>
      <div class="dist-count">${dist[k]}</div>
    </div>`;
  }).join('');
}

function renderDimCard(dim, idx) {
  const s = dim.stat || {};
  const isWarn = s.warn;
  const comps = dim.component_themes || [];
  const srcQs = dim.source_questions || [];
  const srcTexts = dim.source_question_texts || [];

  // Variance detail block
  let varDetail = '';
  if (s.type_stat === 'binary') {
    const color = isWarn ? '#F59E0B' : 'var(--ink)';
    const bgColor = isWarn ? '#FFFBEB' : 'transparent';
    varDetail = `<div style="background:${bgColor};border-radius:8px;padding:14px 16px">
      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--muted);margin-bottom:10px">Variance — Binary (${s.n_pos}/${s.n_total} = ${s.pct_positive}% positive)</div>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">
        <div style="flex:1;height:16px;background:#E5E7EB;border-radius:8px;overflow:hidden">
          <div style="width:${s.pct_positive}%;height:100%;background:${color};border-radius:8px"></div>
        </div>
        <span style="font-size:13px;font-weight:700;color:${isWarn?'#92400E':'#166534'}">${s.pct_positive}%</span>
      </div>
      ${isWarn ? `<div style="font-size:12px;color:#92400E;font-weight:600">! Low variance: ${s.pct_positive > 80 ? 'Too many participants coded positive — this dimension may not differentiate clusters.' : 'Too few participants coded positive — limited signal for clustering.'}</div>` : ''}
    </div>`;
  } else if (s.type_stat === 'ordinal') {
    varDetail = `<div style="background:#EEF2FF;border-radius:8px;padding:14px 16px">
      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--muted);margin-bottom:10px">Variance — Ordinal (mean: ${s.mean}, range: ${s.min}&ndash;${s.max})</div>
      ${ordinalDist(s)}
    </div>`;
  }

  // Component themes
  const compHtml = comps.length
    ? `<ul class="theme-list">${comps.map(c => `<li>${esc(c)}</li>`).join('')}</ul>`
    : '<span style="font-size:12px;color:#9CA3AF">None (derived from question answer directly)</span>';

  // Source questions
  const srcHtml = srcQs.map((q, i) =>
    `<div class="source-q-item"><span class="q-tag">${esc(q)}</span>${esc(srcTexts[i] || q)}</div>`
  ).join('');

  return `<div class="dim-card${isWarn ? ' warn' : ''}" id="dim-${idx}" data-purpose="${dim.purpose}" data-type="${dim.type}" data-stat-type="${s.type_stat || 'none'}" data-warn="${isWarn ? '1' : '0'}">
    <div class="dim-header" onclick="toggleDim('${idx}')">
      <div class="dim-left">
        <div class="dim-name">${esc(dim.label)}</div>
        <div class="dim-label" style="font-family:monospace;font-size:11px;color:#9CA3AF">${esc(dim.name)}</div>
      </div>
      <div class="dim-right">
        ${varianceBar(dim)}
        <span class="type-badge" style="border-left:3px solid ${typeColor(dim.type)}">${esc(dim.type)}</span>
        <span class="purpose-badge ${dim.purpose}">${esc(dim.purpose)}</span>
        ${isWarn ? '<span class="warn-pill">! Warn</span>' : ''}
        <span class="expand-icon" id="icon-${idx}">&#9660;</span>
      </div>
    </div>
    <div class="dim-body" id="body-${idx}">
      <div class="dim-body-grid">
        <div>
          <div class="dim-section" style="margin-bottom:16px">
            <div class="dim-section-label">Source Questions</div>
            <div class="source-qs">${srcHtml || '<span style="font-size:12px;color:#9CA3AF">None specified</span>'}</div>
          </div>
          <div class="dim-section" style="margin-bottom:16px">
            <div class="dim-section-label">Component Themes</div>
            ${compHtml}
            ${dim.type === 'composite_binary' ? `<div style="margin-top:6px;font-size:11px;color:var(--muted)">Logic: <strong>${esc(dim.logic)}</strong> (1 if <em>${dim.logic}</em> component theme is coded across source questions)</div>` : ''}
          </div>
          <div class="dim-section">
            <div class="dim-section-label">Rationale</div>
            <div class="dim-section-text">${esc(dim.rationale)}</div>
          </div>
        </div>
        <div>
          ${varDetail || '<div style="font-size:13px;color:#9CA3AF;padding:16px">No variance data (passthrough or array join)</div>'}
        </div>
      </div>
    </div>
  </div>`;
}

// Render grids
let defFilter = 'all';
let proFilter = 'all';

function renderBasis() {
  const search = document.getElementById('def-search').value.toLowerCase();
  const dims = D.dimensions.filter(d => d.purpose === 'basis');
  const filtered = dims.filter((d, i) => {
    if (search && !d.label.toLowerCase().includes(search) && !d.name.toLowerCase().includes(search)) return false;
    if (defFilter === 'warn') return d.stat && d.stat.warn;
    if (defFilter === 'binary') return d.type === 'composite_binary' || d.type === 'binary_field';
    if (defFilter === 'ordinal') return d.type === 'ordinal_encoded' || d.type === 'composite_ordinal';
    return true;
  });
  document.getElementById('basis-grid').innerHTML = filtered.map((d, i) => renderDimCard(d, 'def_' + i)).join('');
  document.getElementById('def-count').textContent = `Showing ${filtered.length} of ${dims.length} basis dimensions`;
}

function renderDescriptor() {
  const search = document.getElementById('pro-search').value.toLowerCase();
  const dims = D.dimensions.filter(d => d.purpose !== 'basis');
  const filtered = dims.filter(d => {
    if (search && !d.label.toLowerCase().includes(search) && !d.name.toLowerCase().includes(search)) return false;
    if (proFilter === 'descriptor') return d.purpose === 'descriptor';
    if (proFilter === 'criterion') return d.purpose === 'criterion';
    return true;
  });
  document.getElementById('descriptor-grid').innerHTML = filtered.map((d, i) => renderDimCard(d, 'pro_' + i)).join('');
  document.getElementById('pro-count').textContent = `Showing ${filtered.length} of ${dims.length} descriptor/criterion dimensions`;
}

function filterDims(section) {
  if (section === 'basis') renderBasis();
  else renderDescriptor();
}

function setDimFilter(section, mode) {
  if (section === 'basis') {
    defFilter = mode;
    ['all','warn','binary','ordinal'].forEach(m => {
      const el = document.getElementById(`def-btn-${m}`);
      if (el) el.classList.toggle('active', m === mode);
    });
    renderBasis();
  } else {
    proFilter = mode;
    ['all','descriptor','criterion'].forEach(m => {
      const el = document.getElementById(`pro-btn-${m}`);
      if (el) el.classList.toggle('active', m === mode);
    });
    renderDescriptor();
  }
}

function toggleDim(idx) {
  const body = document.getElementById('body-' + idx);
  const icon = document.getElementById('icon-' + idx);
  if (!body) return;
  const isOpen = body.classList.contains('open');
  body.classList.toggle('open');
  if (icon) icon.classList.toggle('open');
}

// Nav scroll
document.querySelectorAll('.page-nav a').forEach(a => {
  a.addEventListener('click', function(e) {
    e.preventDefault();
    const target = document.querySelector(this.getAttribute('href'));
    if (target) target.scrollIntoView({ behavior: 'smooth' });
    document.querySelectorAll('.page-nav a').forEach(x => x.classList.remove('active'));
    this.classList.add('active');
  });
});

const obs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      const id = e.target.id;
      document.querySelectorAll('.page-nav a').forEach(a => {
        a.classList.toggle('active', a.getAttribute('href') === '#' + id);
      });
    }
  });
}, { threshold: 0.2 });
['overview','basis','descriptor'].forEach(id => { const el = document.getElementById(id); if (el) obs.observe(el); });

// Init
renderBasis();
renderDescriptor();
</script>
</body>
</html>
)}
