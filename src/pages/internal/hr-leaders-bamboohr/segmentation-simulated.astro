<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />

  <meta name="robots" content="noindex, nofollow" />
<title>Segmentation Prep — HR Leaders BambooHR (Simulated)</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:inline>
:root {
  --ink: #0B1F3A;
  --paper: #F7F5EF;
  --signal: #B8341B;
  --rule: #1A1A1A;
  --muted: #6B6B6B;
  --border: rgba(11, 31, 58, 0.10);
  --card-bg: rgba(11, 31, 58, 0.03);
  --serif: 'Fraunces', Georgia, serif;
  --sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: var(--sans); color: var(--rule); line-height: 1.6; background: var(--paper); }
.container { max-width: 980px; margin: 0 auto; padding: 0 32px; }

/* Header */
.page-header { padding: 40px 0 32px; border-bottom: 2px solid var(--border); }
.logo { font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--ink); margin-bottom: 24px; }
.page-header h1 { font-family: var(--serif); font-size: 32px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
.page-header .sub { font-size: 15px; color: var(--muted); }
.track-badge { display: inline-block; background: #EEF2FF; color: #4F46E5; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; padding: 3px 10px; border-radius: 20px; margin-left: 10px; vertical-align: middle; }
.overline { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--ink); margin-bottom: 4px; }

/* Nav */
.page-nav { display: flex; gap: 0; border-bottom: 1px solid var(--border); }
.page-nav a { padding: 14px 20px; font-size: 13px; font-weight: 500; color: var(--muted); text-decoration: none; border-bottom: 3px solid transparent; margin-bottom: -1px; }
.page-nav a:hover { color: var(--ink); }
.page-nav a.active { color: var(--ink); border-bottom-color: var(--ink); font-weight: 600; }

/* Stat grid */
.section { padding: 40px 0 32px; border-bottom: 1px solid var(--border); }
.section:last-child { border-bottom: none; }
.section-title { font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
.section-sub { font-size: 13px; color: var(--muted); margin-bottom: 24px; }
.stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 16px; }
.stat-card { padding: 20px 16px; background: var(--card-bg); border-radius: 10px; text-align: center; }
.stat-num { font-family: var(--serif); font-size: 32px; font-weight: 700; color: var(--ink); line-height: 1; margin-bottom: 6px; }
.stat-num.amber { color: #D97706; }
.stat-num.red { color: #DC2626; }
.stat-num.blue { color: #2563EB; }
.stat-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }

/* Warnings banner */
.warn-banner { background: #FFFBEB; border: 1px solid #FCD34D; border-radius: 10px; padding: 16px 20px; margin-bottom: 24px; }
.warn-banner-title { font-size: 13px; font-weight: 700; color: #92400E; margin-bottom: 8px; }
.warn-list { list-style: none; }
.warn-list li { font-size: 13px; color: var(--muted); padding: 3px 0; display: flex; align-items: flex-start; gap: 8px; }
.warn-list li::before { content: '!'; display: inline-block; background: #F59E0B; color: #fff; font-size: 10px; font-weight: 700; width: 16px; height: 16px; border-radius: 50%; text-align: center; line-height: 16px; flex-shrink: 0; margin-top: 2px; }

/* Dimension cards */
.dim-grid { display: flex; flex-direction: column; gap: 0; }
.dim-card { border: 1px solid var(--border); border-radius: 10px; margin-bottom: 12px; overflow: hidden; }
.dim-card.warn { border-left: 3px solid var(--muted); }
.dim-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 16px 20px; cursor: pointer; user-select: none; background: var(--paper); }
.dim-header:hover { background: #FAFAFA; }
.dim-left { flex: 1; min-width: 0; }
.dim-name { font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 2px; }
.dim-label { font-size: 12px; color: var(--muted); }
.dim-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.purpose-badge { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 3px 9px; border-radius: 2px; }
.purpose-badge.basis { background: rgba(184, 52, 27, 0.08); color: #166534; }
.purpose-badge.descriptor { background: #EEF2FF; color: #4338CA; }
.purpose-badge.criterion { background: var(--card-bg); color: #92400E; }
.type-badge { font-size: 10px; color: #9CA3AF; font-weight: 500; background: #F3F4F6; padding: 2px 8px; border-radius: 2px; }
.warn-pill { font-size: 10px; font-weight: 700; color: #92400E; background: var(--card-bg); padding: 2px 8px; border-radius: 2px; }
.expand-icon { font-size: 16px; color: #9CA3AF; transition: transform 0.2s; flex-shrink: 0; }
.expand-icon.open { transform: rotate(180deg); }

/* Variance bar inline in header */
.variance-inline { display: flex; align-items: center; gap: 8px; min-width: 140px; }
.var-bar-track { width: 80px; height: 8px; background: #F0F0F0; border-radius: 2px; overflow: hidden; flex-shrink: 0; }
.var-bar-fill { height: 100%; border-radius: 2px; }
.var-val { font-size: 12px; font-weight: 600; color: var(--rule); white-space: nowrap; }

/* Dim body */
.dim-body { display: none; padding: 0 20px 20px; border-top: 1px solid #F0F0F0; background: #FAFAFA; }
.dim-body.open { display: block; }
.dim-body-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px; }
.dim-section { }
.dim-section-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #9CA3AF; margin-bottom: 6px; }
.dim-section-text { font-size: 13px; color: var(--rule); line-height: 1.5; }
.theme-list { list-style: none; display: flex; flex-direction: column; gap: 3px; }
.theme-list li { font-size: 12px; color: var(--rule); padding: 4px 8px; background: #F3F4F6; border-radius: 2px; line-height: 1.4; }
.q-tag { display: inline-block; font-size: 10px; font-weight: 700; color: #4338CA; background: #EEF2FF; padding: 1px 6px; border-radius: 2px; margin-right: 4px; }
.source-qs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
.source-q-item { font-size: 12px; color: var(--rule); padding: 4px 10px; background: #F3F4F6; border-radius: 2px; }

/* Ordinal distribution bar */
.dist-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
.dist-label { font-size: 11px; color: var(--muted); width: 20px; text-align: right; flex-shrink: 0; }
.dist-track { flex: 1; height: 14px; background: #F0F0F0; border-radius: 3px; overflow: hidden; }
.dist-fill { height: 100%; border-radius: 3px; }
.dist-count { font-size: 11px; color: var(--muted); width: 32px; text-align: right; }

/* Filter row */
.filter-row { display: flex; gap: 10px; align-items: center; margin-bottom: 20px; flex-wrap: wrap; }
.filter-btn { padding: 7px 14px; border: 1px solid var(--border); border-radius: 2px; font-size: 12px; font-weight: 500; cursor: pointer; background: var(--paper); color: var(--rule); font-family: var(--sans); }
.filter-btn.active { background: var(--ink); color: #fff; border-color: var(--ink); }
.search-input { padding: 8px 12px; border: 1px solid var(--border); border-radius: 2px; font-size: 13px; font-family: var(--sans); width: 260px; }
.search-input:focus { outline: none; border-color: var(--ink); }
.result-count { font-size: 12px; color: var(--muted); margin-top: 4px; }

/* How it works */
.how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 20px 0; }
.how-card { background: var(--card-bg); border-radius: 10px; padding: 20px; }
.how-num { font-family: var(--serif); font-size: 28px; font-weight: 700; color: var(--border); line-height: 1; margin-bottom: 8px; }
.how-title { font-size: 14px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
.how-text { font-size: 13px; color: var(--muted); line-height: 1.5; }
.pipeline-flow { display: flex; align-items: center; gap: 0; margin: 20px 0; flex-wrap: wrap; }
.pipeline-step { background: var(--card-bg); border-radius: 2px; padding: 12px 16px; font-size: 12px; font-weight: 600; color: var(--rule); flex-shrink: 0; }
.pipeline-arrow { font-size: 18px; color: #9CA3AF; padding: 0 8px; flex-shrink: 0; }
.pipeline-step.active { background: var(--ink); color: #fff; }
.dim-type-legend { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0; }
.legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
.legend-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }

/* Responsive */
@media (max-width: 700px) {
  .stat-grid { grid-template-columns: repeat(2, 1fr); }
  .dim-body-grid { grid-template-columns: 1fr; }
  .how-grid { grid-template-columns: 1fr; }
}
</style>
</head>
