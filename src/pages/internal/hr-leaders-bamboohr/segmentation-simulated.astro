---
import fs from 'node:fs';
import path from 'node:path';

let dataAvailable = true;
let dataScript = '';
try {
  const dataPath = path.resolve(process.cwd(), '../../research-projects/Interview Projects/HR Leaders BambooHR/A5 Report Segmentation - Simulated/segmentation_page_data.json');
  const DATA = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
  dataScript = '<script>window.__SEG=' + JSON.stringify(DATA).replace(/<\//g, '<\\/') + ';<' + '/script>';
} catch {
  dataAvailable = false;
}
---
{!dataAvailable && (
<html lang="en"><head><meta charset="UTF-8"><meta name="robots" content="noindex, nofollow" /><title>Data Not Available</title></head>
<body style="font-family:system-ui;padding:4rem;text-align:center;color:#333">
<h1 style="margin-bottom:1rem">Segmentation data not available</h1>
<p>This page requires research data files that are not present in this deployment.</p>
<p style="margin-top:1rem"><a href="/internal/hr-leaders-bamboohr/">Back to Study</a></p>
</body></html>
)}
{dataAvailable && (
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
