<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Interview Guide Design | BuyerVoice.AI</title>
  <meta name="description" content="How to design and annotate interview guides that produce data ready for segmentation analysis." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --color-green: var(--ink);
      --color-deep-green: var(--ink);
      --color-teal: #1a7a5e;
      --color-black: #1A1A1A;
      --color-white: #FFFFFF;
      --color-slate: var(--rule);
      --color-light-gray: var(--card-bg);
      --color-medium-gray: var(--border);
      --color-amber: #D97706;
      --color-amber-light: #FEF3C7;
      --color-red: #DC2626;
      --color-red-light: #FEE2E2;
      --color-blue: #2563EB;
      --color-blue-light: #EFF6FF;
      --color-green-light: transparent;
      --font-heading: var(--serif), Georgia, serif;
      --font-body: var(--sans);
      --max-width: 1200px;
      --max-text-width: 760px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-body);
      color: var(--color-black);
      background: var(--color-white);
      line-height: 1.6;
      font-size: 16px;
    }

    /* NAV */
    nav {
      position: sticky;
      top: 0;
      background: var(--color-white);
      border-bottom: 1px solid var(--color-medium-gray);
      z-index: 100;
      padding: 0 24px;
    }
    .nav-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
      gap: 16px;
    }
    .nav-logo {
      font-family: var(--font-heading);
      font-size: 18px;
      font-weight: 700;
      color: var(--color-black);
      text-decoration: none;
      white-space: nowrap;
    }
    .nav-links {
      display: flex;
      gap: 4px;
      flex-wrap: wrap;
      list-style: none;
    }
    .nav-links a {
      font-size: 13px;
      font-weight: 500;
      color: var(--color-slate);
      text-decoration: none;
      padding: 4px 8px;
      border-radius: 2px;
      transition: color 0.15s, background 0.15s;
      white-space: nowrap;
    }
    .nav-links a:hover {
      color: var(--color-green);
      background: var(--color-green-light);
    }

    /* HERO */
    .hero {
      background: var(--color-green);
      color: var(--color-white);
      padding: 72px 24px;
      text-align: center;
    }
    .hero-eyebrow {
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      opacity: 0.85;
      margin-bottom: 16px;
    }
    .hero h1 {
      font-family: var(--font-heading);
      font-size: clamp(32px, 5vw, 52px);
      font-weight: 700;
      line-height: 1.15;
      margin-bottom: 20px;
    }
    .hero p {
      font-size: 18px;
      opacity: 0.9;
      max-width: 640px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* SECTIONS */
    section {
      padding: 64px 24px;
    }
    section.gray {
      background: var(--color-light-gray);
    }
    .section-inner {
      max-width: var(--max-width);
      margin: 0 auto;
    }
    .section-header {
      margin-bottom: 40px;
    }
    .section-number {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-green);
      margin-bottom: 8px;
    }
    h2 {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3vw, 36px);
      font-weight: 700;
      line-height: 1.2;
      color: var(--color-black);
      margin-bottom: 12px;
    }
    .section-subtitle {
      font-size: 17px;
      color: var(--color-slate);
      max-width: var(--max-text-width);
      line-height: 1.6;
    }
    h3 {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 12px;
      margin-top: 36px;
      color: var(--color-black);
    }
    h3:first-of-type { margin-top: 0; }
    p {
      font-size: 15px;
      color: var(--color-slate);
      max-width: var(--max-text-width);
      line-height: 1.7;
      margin-bottom: 0;
    }

    /* CALLOUT */
    .callout {
      background: var(--color-blue-light);
      border-left: 4px solid var(--color-blue);
      border-radius: 0 8px 8px 0;
      padding: 16px 20px;
      margin-top: 24px;
    }
    .callout p { color: var(--color-black); font-size: 14px; max-width: none; }
    .callout.warning {
      background: var(--color-amber-light);
      border-color: var(--color-amber);
    }
    .callout.danger {
      background: var(--color-red-light);
      border-color: var(--color-red);
    }

    /* TABLE */
    .table-wrap {
      overflow-x: auto;
      margin-top: 20px;
      border-radius: 2px;
      border: 1px solid var(--color-medium-gray);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    th {
      background: var(--color-light-gray);
      padding: 10px 16px;
      text-align: left;
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-slate);
      border-bottom: 1px solid var(--color-medium-gray);
      white-space: nowrap;
    }
    td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--color-medium-gray);
      vertical-align: top;
      font-size: 14px;
      color: var(--color-black);
    }
    tr:last-child td { border-bottom: none; }
    td code, th code { background: var(--color-medium-gray); padding: 1px 5px; border-radius: 3px; font-size: 12px; font-family: monospace; }

    /* CARDS */
    .cards-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 24px;
    }
    @media (max-width: 768px) {
      .cards-3 { grid-template-columns: 1fr; }
    }
    .card {
      border-radius: 10px;
      padding: 24px;
      border: 1px solid var(--color-medium-gray);
    }
    .card.green { background: var(--color-green-light); border-color: #86efac; }
    .card.amber { background: var(--color-amber-light); border-color: #fcd34d; }
    .card.blue { background: var(--color-blue-light); border-color: #93c5fd; }
    .card-title {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 10px;
    }
    .card-title.green { color: var(--color-deep-green); }
    .card-title.amber { color: #92400e; }
    .card-title.blue { color: #1e40af; }
    .card p { font-size: 13px; max-width: none; }
    .card ul { font-size: 13px; padding-left: 16px; margin-top: 8px; color: var(--color-slate); }
    .card li { margin-bottom: 4px; }

    /* TEMPORAL DIAGRAM */
    .temporal-diagram {
      margin-top: 28px;
      display: flex;
      align-items: stretch;
      gap: 0;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--color-medium-gray);
    }
    .temporal-side {
      flex: 1;
      padding: 24px;
    }
    .temporal-side.module-a { background: var(--color-green-light); }
    .temporal-side.module-b { background: var(--color-amber-light); }
    .temporal-divider {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: var(--color-black);
      color: var(--color-white);
      padding: 12px 10px;
      font-size: 11px;
      font-weight: 600;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      min-width: 60px;
      writing-mode: vertical-rl;
      text-orientation: mixed;
    }
    .temporal-label {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 8px;
    }
    .temporal-label.a { color: var(--color-deep-green); }
    .temporal-label.b { color: #92400e; }
    .temporal-role {
      font-size: 12px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 2px;
      display: inline-block;
      margin-bottom: 10px;
    }
    .temporal-role.a { background: #dcfce7; color: var(--color-deep-green); }
    .temporal-role.b { background: #fef3c7; color: #92400e; }
    .temporal-side ul { font-size: 13px; padding-left: 16px; color: var(--color-slate); margin-top: 8px; }
    .temporal-side li { margin-bottom: 5px; }
    @media (max-width: 700px) {
      .temporal-diagram { flex-direction: column; }
      .temporal-divider { writing-mode: horizontal-tb; min-width: auto; padding: 10px 24px; }
    }

    /* ANNOTATION EXAMPLE */
    .annotation-example {
      background: #1e1e2e;
      border-radius: 10px;
      padding: 24px;
      margin-top: 20px;
      font-family: monospace;
      font-size: 13px;
      line-height: 1.7;
      color: #cdd6f4;
      overflow-x: auto;
    }
    .ann-qnum { color: #89dceb; font-weight: bold; }
    .ann-tag { color: #a6e3a1; }
    .ann-pipe { color: #6c7086; }
    .ann-question { color: #cdd6f4; }
    .ann-note-label { color: #fab387; font-weight: 600; }
    .ann-note { color: #bac2de; font-style: italic; }
    .ann-criterion { color: #f38ba8; }
    .ann-descriptor { color: #89dceb; }
    .ann-basis { color: #a6e3a1; }
    .ann-comment { color: #6c7086; }

    /* BADGE TAGS */
    .badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 2px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge-basis { background: #dcfce7; color: var(--color-deep-green); }
    .badge-criterion { background: #fee2e2; color: #991b1b; }
    .badge-descriptor { background: #eff6ff; color: #1e40af; }
    .badge-module-a { background: #dcfce7; color: var(--color-deep-green); }
    .badge-module-b { background: #fef3c7; color: #92400e; }

    /* CODE BLOCK */
    .code-block {
      background: #1e1e2e;
      color: #cdd6f4;
      border-radius: 2px;
      padding: 20px 24px;
      font-family: monospace;
      font-size: 13px;
      line-height: 1.7;
      overflow-x: auto;
      margin-top: 16px;
    }
    .code-key { color: #89b4fa; }
    .code-string { color: #a6e3a1; }
    .code-comment { color: #6c7086; font-style: italic; }

    /* CHECKLIST */
    .checklist {
      list-style: none;
      padding: 0;
      margin-top: 16px;
    }
    .checklist li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--color-medium-gray);
      font-size: 14px;
      color: var(--color-black);
    }
    .checklist li:last-child { border-bottom: none; }
    .checklist-box {
      width: 20px;
      height: 20px;
      border: 2px solid var(--color-medium-gray);
      border-radius: 2px;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .checklist-content { flex: 1; }
    .checklist-title { font-weight: 600; display: block; margin-bottom: 2px; }
    .checklist-desc { font-size: 13px; color: var(--color-slate); }

    /* QUICK REF */
    .quick-ref-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-top: 24px;
    }
    @media (max-width: 700px) { .quick-ref-grid { grid-template-columns: 1fr; } }
    .quick-ref-card {
      border: 1px solid var(--color-medium-gray);
      border-radius: 10px;
      overflow: hidden;
    }
    .quick-ref-header {
      background: var(--color-light-gray);
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-slate);
      border-bottom: 1px solid var(--color-medium-gray);
    }
    .quick-ref-body {
      padding: 16px;
    }
    .quick-ref-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      padding: 7px 0;
      border-bottom: 1px solid var(--color-medium-gray);
      font-size: 13px;
    }
    .quick-ref-row:last-child { border-bottom: none; }
    .quick-ref-label { color: var(--color-black); font-weight: 500; }
    .quick-ref-value { color: var(--color-slate); text-align: right; }

    /* FOOTER */
    footer {
      background: var(--color-black);
      color: rgba(255,255,255,0.5);
      padding: 32px 24px;
      text-align: center;
      font-size: 13px;
    }
    footer a { color: rgba(255,255,255,0.7); text-decoration: none; }
    footer a:hover { color: var(--color-white); }
  </style>
</head>
