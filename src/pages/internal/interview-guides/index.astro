            <span class="quick-ref-label">80 participants</span>
            <span class="quick-ref-value">max 8 basis dimensions</span>
          </div>
          <div class="quick-ref-row">
            <span class="quick-ref-label">100 participants</span>
            <span class="quick-ref-value">max 10 basis dimensions</span>
          </div>
          <div class="quick-ref-row">
            <span class="quick-ref-label">200 participants</span>
            <span class="quick-ref-value">max 20 basis dimensions</span>
          </div>
