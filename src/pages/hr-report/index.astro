import reportStats from '../../data/hr-leaders-bgr/report-stats-v2.json';
import verbatimData from '../../data/hr-leaders-bgr/verbatim-data.json';
import verbatimQuestions from '../../data/hr-leaders-bgr/verbatim-questions.json';

const d = reportStats;
const VD = verbatimData;
const VQ = verbatimQuestions;
const vdScript = '<script>window.__VD=' + JSON.stringify(VD).replace(/<\//g, '<\\/') + ';window.__VQ=' + JSON.stringify(VQ).replace(/<\//g, '<\\/') + ';<' + '/script>';
const es = d.executive_stats;
const bp = d.bamboo_profile;

// Helper: format code label for display
function formatLabel(label: string): string {
  return label
    .replace(/\bHr\b/g, 'HR')
    .replace(/\bHris\b/g, 'HRIS')
    .replace(/\bIt\b/g, 'IT')
    .replace(/\bSso\b/g, 'SSO')
    .replace(/\bCfo\b/g, 'CFO')
    .replace(/\bAi\b/g, 'AI')
    .replace(/\bAts\b/g, 'ATS')
    .replace(/\bUi\b/g, 'UI')
    .replace(/\bWtp\b/g, 'WTP');
}

// Fixed sort orders
const companySizeOrder = ['50-100 employees', '101-250 employees', '251-500 employees', '501-1,000 employees'];
const seniorityOrder = ['Manager', 'Senior Manager', 'Director', 'VP or above', 'C-suite'];

function sortByOrder(categories: any[], order: string[]): any[] {
  return [...categories].sort((a, b) => {
    const ai = order.indexOf(a.label);
    const bi = order.indexOf(b.label);
    return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
  });
}

// Question text lookup
const questionText: Record<string, string> = {
  Q1: 'To start, please tell me your current seniority and function.',
  Q2: 'How many years have you worked in your current company?',
  Q3: 'What industry is your company in? And, roughly, how many people work at your company?',
  Q4: 'Currently, does your team use one platform or several different tools for HR, payroll, and benefits? What is the main software or set of tools that you use?',
  Q5: 'How long ago did your team last consider buying an HR, payroll, and benefits tool?',
  Q6: 'What software or tools were you using when you started this evaluation?',
  Q7: 'What motivated your team to consider other HR, payroll, or benefits tools?',
  Q8: 'Was there anything else happening more broadly at your company or industry that motivated you to consider other tools?',
  Q9: 'Was your HR, payroll, or benefits tools causing any particular frustrations or challenges?',
  Q10: 'Which tools did you seriously consider?',
  Q11: 'Did you have any minimum criteria that a tool had to have in order to be seriously considered?',
  Q12: 'Who else was involved in the final decision during this evaluation? What role did they play?',
  Q13: 'After your evaluation, did you purchase and switch to a new one or continue using your previous software?',
  Q14: 'Why did you choose that tool? How did it stand out?',
  Q15: 'For each of the tools that you considered but rejected, please share the main reasons why.',
  Q16: 'What does your current tool(s) do well?',
  Q17: 'Where does it fall short of what you need today?',
  Q18: 'What is your biggest frustration with your current tool(s)?',
  Q19: 'What has changed about your needs since the last time you considered HR, payroll, and benefits tools?',
  Q20: 'On an annual basis, how much does your company spend on your current HR, payroll, and benefits tool(s)?',
  Q21: 'Do you think the cost is reasonable relative to the value your company gets?',
  Q22: 'How much would it be worth to your company annually to solve your biggest frustration?',
  Q23: 'Within the next 6 months, do you think you will likely consider switching to new HR, payroll, and benefits tools?',
  Q24: 'What are the biggest challenges with HR, payroll, and benefits tools today?',
};
