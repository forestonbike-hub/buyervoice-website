<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="theme-color" content="#F7F5EF">
<title>Perceptions of Retail Banking Brands in British Columbia and Alberta | BuyerVoice.AI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
<style is:inline>
:root {
  --ink: #0B1F3A;
  --paper: #F7F5EF;
  --signal: #B8341B;
  --rule: #1A1A1A;
  --muted: #6B6B6B;
  --border: rgba(11, 31, 58, 0.10);
  --card-bg: rgba(11, 31, 58, 0.03);
  --serif: 'Fraunces', Georgia, serif;
  --sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: var(--sans); color: var(--rule); line-height: 1.65; background: var(--paper); }
.pdf-btn { position: fixed; top: 16px; right: 24px; background: var(--signal); color: #fff; border: none; font-size: 13px; font-weight: 600; cursor: pointer; padding: 8px 16px; border-radius: 6px; z-index: 100; text-decoration: none; font-family: var(--sans); }
.pdf-btn:hover { background: #922B16; }
.container { max-width: 960px; margin: 0 auto; padding: 0 32px; }
.cover { text-align: center; padding: 96px 32px 64px; }
.bv-logo { font-family: var(--serif); margin: 0 auto 48px; line-height: 1; display: inline-block; text-decoration: none; transition: opacity 0.15s; }
.bv-logo:hover { opacity: 0.75; }
.bv-logo-name { font-size: 28px; font-weight: 600; color: var(--ink); letter-spacing: -0.02em; }
.bv-logo-tld { font-size: 28px; font-weight: 600; color: var(--signal); letter-spacing: -0.02em; }
.cover h1 { font-family: var(--serif); font-size: 44px; font-weight: 600; color: var(--signal); margin-bottom: 18px; line-height: 1.15; letter-spacing: -0.02em; }
.cover .subtitle { font-size: 18px; color: var(--muted); margin-bottom: 16px; line-height: 1.5; max-width: 680px; margin-left: auto; margin-right: auto; }
.cover .prepared-for { font-family: var(--sans); font-size: 13px; font-weight: 500; color: var(--ink); margin-top: 4px; margin-bottom: 0; text-transform: uppercase; letter-spacing: 0.12em; }
h1 { font-family: var(--serif); font-size: 36px; font-weight: 600; color: var(--ink); margin-bottom: 8px; letter-spacing: -0.02em; }
h2 { font-family: var(--serif); font-size: 26px; font-weight: 600; color: var(--ink); margin-bottom: 8px; margin-top: 32px; letter-spacing: -0.01em; }
h3 { font-family: var(--serif); font-size: 20px; font-weight: 600; color: var(--ink); margin-bottom: 8px; margin-top: 28px; letter-spacing: -0.01em; }
h4 { font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 8px; margin-top: 16px; text-transform: uppercase; letter-spacing: 0.08em; }
p { font-size: 15px; color: var(--rule); margin-bottom: 14px; }
ul, ol { padding-left: 22px; margin-bottom: 14px; }
ul li, ol li { font-size: 15px; color: var(--rule); margin-bottom: 4px; }
.stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 20px 0; }
.stat-card { text-align: center; padding: 20px 12px; background: var(--card-bg); border: 1px solid var(--border); border-radius: 2px; }
.stat-num { font-family: var(--serif); font-size: 30px; font-weight: 600; color: var(--ink); letter-spacing: -0.02em; }
.stat-label { font-size: 11px; color: var(--muted); margin-top: 6px; text-transform: uppercase; letter-spacing: 0.05em; }

/* Bar chart */
.bar-chart { margin: 16px 0; }
.bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.bar-label { width: 240px; font-size: 13px; font-weight: 500; text-align: right; flex-shrink: 0; color: var(--rule); }
.bar-track { flex: 1; height: 24px; background: rgba(11, 31, 58, 0.06); border-radius: 4px; overflow: hidden; position: relative; min-width: 200px; }
.bar-fill { height: 100%; border-radius: 4px 0 0 4px; display: flex; align-items: center; justify-content: flex-end; padding-right: 8px; min-width: 36px; }
.bar-fill.signal { background: var(--signal); }
.bar-fill.ink { background: var(--ink); }
.bar-fill.ink-75 { background: var(--ink); opacity: 0.78; }
.bar-fill.amber { background: #C08533; }
.bar-fill.muted { background: rgba(11, 31, 58, 0.35); }
.bar-fill.strength { background: #8FADC8; }
.bar-val { font-size: 11px; font-weight: 600; color: var(--paper); letter-spacing: 0.02em; }
.bar-val.dark { color: var(--ink); }
.bar-avg { position: absolute; top: 0; bottom: 0; width: 0; border-left: 2px dashed rgba(11, 31, 58, 0.45); z-index: 2; pointer-events: none; }
.dashed-legend { display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: var(--muted); margin: 6px 0 0 250px; }
.dashed-legend-line { width: 22px; height: 0; border-top: 2px dashed rgba(11, 31, 58, 0.45); }

/* Stacked intensity */
.stack-bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.stack-bar-label { width: 240px; font-size: 13px; font-weight: 500; text-align: right; flex-shrink: 0; color: var(--rule); }
.stack-bar-track { flex: 1; height: 24px; background: rgba(11, 31, 58, 0.06); border-radius: 4px; overflow: hidden; display: flex; min-width: 200px; }
.stack-seg { height: 100%; display: flex; align-items: center; justify-content: center; color: var(--paper); font-size: 11px; font-weight: 600; }
.stack-seg.sigh { background: var(--signal); }
.stack-seg.medi { background: #C08533; }
.stack-seg.lowi { background: rgba(11, 31, 58, 0.45); }

table { width: 100%; border-collapse: collapse; margin: 16px 0 24px; font-size: 14px; }
th { text-align: left; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); padding: 12px 10px; border-bottom: 2px solid var(--ink); background: transparent; vertical-align: bottom; }
td { padding: 11px 10px; border-bottom: 1px solid var(--border); vertical-align: top; font-size: 13.5px; }
tr:hover { background: var(--card-bg); }
.crosstab { font-size: 13px; overflow-x: auto; margin: 16px 0; }
.crosstab table { min-width: 700px; }
.crosstab th, .crosstab td { padding: 10px 10px; text-align: right; white-space: nowrap; }
.crosstab th:first-child, .crosstab td:first-child { text-align: left; min-width: 220px; }
.crosstab th { text-align: center; }
.sig-pos { color: var(--ink); font-weight: 600; }
.sig-neg { color: var(--signal); font-weight: 600; }
.sig-sup { color: var(--signal); font-weight: 700; font-size: 11px; vertical-align: super; line-height: 0; }

/* heatmap cells for CEP matrix */
.heat td.cell { text-align: center; font-weight: 600; color: var(--ink); }
.heat td.cell .cust { display: block; font-size: 10px; font-weight: 400; color: var(--muted); margin-top: 2px; }
.heat td.hi { background: rgba(11, 31, 58, 0.18); }
.heat td.med { background: rgba(11, 31, 58, 0.09); }
.heat td.lo { background: rgba(11, 31, 58, 0.03); color: var(--muted); }
.heat td.simplii-hi { background: rgba(184, 52, 27, 0.22); color: var(--signal); }
.heat td.simplii-med { background: rgba(184, 52, 27, 0.12); color: var(--signal); }
.heat td.simplii-lo { background: rgba(184, 52, 27, 0.05); color: var(--muted); }
.heat tr.simplii-row td:first-child { color: var(--signal); font-weight: 700; }
.heat td.divider { border-top: 2px dashed var(--border); padding-top: 8px; }

/* Push-pull matrix cells */
.pp td.pp-cell { text-align: center; font-size: 12px; }
.pp td.pp-cell .push { color: var(--muted); font-weight: 500; }
.pp td.pp-cell .arrow { color: var(--muted); margin: 0 2px; }
.pp td.pp-cell .pull { font-weight: 700; }
.pp td.pp-resolved .pull { color: var(--ink); }
.pp td.pp-regressed .pull { color: var(--signal); }
.pp td.pp-partial .pull { color: #8B5A1F; }
.pp td.pp-empty { color: var(--muted); font-size: 12px; text-align: center; }

/* Callouts */
.insight { border-left: 4px solid var(--signal); background: rgba(184, 52, 27, 0.06); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 18px 0; }
.insight p { font-size: 15px; margin-bottom: 6px; line-height: 1.6; }
.insight p:last-child { margin-bottom: 0; }
.insight strong { color: var(--ink); font-weight: 600; }
.insight .owner { display: block; font-size: 12px; color: var(--muted); font-style: italic; margin-top: 8px; }
.opp-callout { border-left: 4px solid #2A7A6E; background: rgba(42, 122, 110, 0.08); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 18px 0; }
.opp-callout p { font-size: 14px; margin-bottom: 6px; }
.opp-callout p:last-child { margin-bottom: 0; }
.opp-callout strong { color: #2A7A6E; }
.vuln-callout { border-left: 4px solid #C4784A; background: rgba(196, 120, 74, 0.10); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 18px 0; }
.vuln-callout p { font-size: 14px; margin-bottom: 6px; }
.vuln-callout p:last-child { margin-bottom: 0; }
.vuln-callout strong { color: #8B5A1F; }
.neutral-callout { border-left: 4px solid var(--ink); background: var(--card-bg); padding: 16px 20px; border-radius: 0 6px 6px 0; margin: 18px 0; }
.neutral-callout p { font-size: 14px; margin-bottom: 6px; }
.neutral-callout p:last-child { margin-bottom: 0; }
.neutral-callout strong { color: var(--ink); }
.caveat { border-left: 3px solid var(--muted); background: transparent; padding: 4px 20px; margin: 16px 0; font-size: 13.5px; color: var(--muted); font-style: italic; }
.caveat strong { color: var(--ink); font-style: normal; }
.source-note { font-size: 12px; color: var(--muted); margin-top: 8px; margin-bottom: 16px; font-style: italic; }
.question-text { font-size: 13px; color: var(--ink); font-style: italic; margin-top: 2px; margin-bottom: 12px; opacity: 0.85; }
.xref { font-size: 13px; color: var(--muted); font-style: italic; margin: 8px 0 16px; }
.xref a { color: var(--ink); }

/* compact stat row for demographics */
.compact-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 18px 0; }
.compact-stat { padding: 14px 12px; background: var(--card-bg); border: 1px solid var(--border); border-radius: 2px; }
.compact-stat .csn { font-family: var(--serif); font-size: 22px; font-weight: 600; color: var(--ink); line-height: 1.1; }
.compact-stat .csn.signal { color: var(--signal); }
.compact-stat .csl { font-size: 11.5px; color: var(--muted); margin-top: 6px; line-height: 1.35; }

.tier-pill { display: inline-block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 2px 8px; border-radius: 2px; margin-right: 8px; vertical-align: middle; }
.tier-strong { background: rgba(11, 31, 58, 0.12); color: var(--ink); }
.tier-hedge { background: rgba(192, 133, 51, 0.18); color: #8B5A1F; }
.verdict-resolved { color: var(--ink); font-weight: 600; }
.verdict-partial { color: #8B5A1F; font-weight: 600; }
.verdict-regressed { color: var(--signal); font-weight: 600; }
.pill { display: inline-block; padding: 2px 10px; border-radius: 2px; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-right: 4px; }
.pill.ink { background: rgba(11, 31, 58, 0.10); color: var(--ink); }
.pill.signal { background: rgba(184, 52, 27, 0.10); color: var(--signal); }
.pill.amber { background: rgba(192, 133, 51, 0.15); color: #8B5A1F; }
.pill.muted { background: rgba(107, 107, 107, 0.10); color: var(--muted); }
.pill.green { background: rgba(42, 122, 110, 0.12); color: #2A7A6E; }

.accordion { border-bottom: 1px solid var(--border); }
.accordion-header { display: flex; align-items: center; gap: 16px; padding: 24px 0; cursor: pointer; list-style: none; }
.accordion-header::-webkit-details-marker { display: none; }
.accordion-num { font-family: var(--serif); font-size: 32px; font-weight: 600; color: var(--signal); min-width: 40px; }
.accordion-text { flex: 1; }
.accordion-title { font-family: var(--serif); font-size: 22px; font-weight: 600; color: var(--ink); display: block; letter-spacing: -0.02em; }
.accordion-subtitle { font-size: 14px; color: var(--muted); display: block; margin-top: 4px; }
.accordion-icon { font-family: var(--serif); font-size: 28px; font-weight: 300; color: var(--signal); min-width: 30px; text-align: center; transition: transform 0.2s; }
details[open] .accordion-icon { transform: rotate(45deg); }
.accordion-body { padding: 0 0 56px 0; }

.criterion-block { margin: 22px 0; padding: 0 0 18px; border-bottom: 1px solid var(--border); }
.criterion-block:last-of-type { border-bottom: none; }
.criterion-block h4 { margin-top: 0; }
.criterion-signal { font-size: 14px; color: var(--ink); margin-bottom: 10px; }

/* Row-block layout: a two-line block where the first line has the compact lead
   (theme/asset/dimension + quick tag) and the second line runs edge-to-edge with
   the rationale / commentary. Used to replace wide crosstab tables that would
   otherwise need horizontal scrolling. */
.row-block { padding: 14px 0 14px; border-bottom: 1px solid var(--border); }
.row-block:last-of-type { border-bottom: none; }
.row-block .rb-head { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 6px; }
.row-block .rb-head .rb-lead { font-size: 14px; font-weight: 600; color: var(--ink); }
.row-block .rb-head .rb-tag { font-size: 12px; color: var(--muted); font-weight: 500; }
.row-block .rb-head .rb-val { margin-left: auto; font-size: 13px; color: var(--muted); font-weight: 500; }
.row-block .rb-body { font-size: 13.5px; color: var(--rule); line-height: 1.55; }
.row-block .rb-body strong { color: var(--ink); }

/* Moat-section header: a horizontal bar that introduces a grouping of row-blocks
   (Strong / Vulnerability / Valued-but-not-differentiated). */
.moat-section { margin: 26px 0 6px; padding: 8px 14px; border-radius: 4px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
.moat-section.strong { background: rgba(42, 122, 110, 0.12); color: #2A7A6E; }
.moat-section.vuln { background: rgba(184, 52, 27, 0.10); color: var(--signal); }
.moat-section.valued { background: rgba(11, 31, 58, 0.08); color: var(--ink); }

/* Heatmap tightening: per-column width cap so the CEP heatmap fits without
   horizontal scroll. The first column (CEP question) gets its own narrower
   cap with wrapped text. Bank columns get a fixed narrow width. */
.heat.compact table { min-width: 0; }
.heat.compact th, .heat.compact td { padding: 8px 6px; }
.heat.compact th:first-child, .heat.compact td:first-child { min-width: 0; width: 210px; max-width: 210px; white-space: normal; line-height: 1.25; }
.heat.compact th:not(:first-child), .heat.compact td:not(:first-child) { width: auto; }
.heat.compact td.cell { padding: 8px 4px; font-size: 13px; }
.heat.compact td.cell .cust { font-size: 10px; }

/* Expanded heatmap that fits 12+ bank columns by rotating column headers 45 degrees. */
.heat.wide table { min-width: 0; width: 100%; table-layout: fixed; }
.heat.wide { overflow-x: visible; }
.heat.wide thead th:first-child { width: 200px; padding: 8px 6px; vertical-align: bottom; }
.heat.wide thead th:not(:first-child) { width: auto; padding: 0; height: 130px; vertical-align: bottom; overflow: visible; font-size: 11px; }
.heat.wide thead .hdr-rot { display: block; transform: rotate(-45deg); transform-origin: left bottom; white-space: nowrap; padding-left: 8px; padding-bottom: 4px; line-height: 1; }

/* Sub-type heatmap (Section 8b): narrow 3-column variant with rotated headers */
.heat.subtype-heat { overflow: visible; margin-top: 72px; }
.heat.subtype-heat table { width: 100%; table-layout: fixed; }
.heat.subtype-heat thead th:first-child { width: 34%; text-align: left; padding: 8px 10px; vertical-align: bottom; font-size: 12px; color: var(--muted); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 2px solid var(--border); }
.heat.subtype-heat thead th:not(:first-child) { width: 22%; padding: 0 0 6px; height: 170px; vertical-align: bottom; font-size: 11.5px; line-height: 1.2; text-align: left; border-bottom: 2px solid var(--border); overflow: visible; }
.heat.subtype-heat thead .hdr-rot { display: inline-block; transform: rotate(-45deg); transform-origin: left bottom; white-space: nowrap; padding: 0 0 6px 6px; line-height: 1.15; font-weight: 600; color: var(--ink); }
.heat.subtype-heat tbody td:first-child { padding: 12px 10px; font-size: 13px; color: var(--ink); font-weight: 500; line-height: 1.35; border-bottom: 1px solid var(--border); }
.heat.subtype-heat tbody td.cell { padding: 12px 8px; font-size: 14px; text-align: center; vertical-align: middle; font-weight: 600; border-bottom: 1px solid var(--border); }
.heat.subtype-heat td.heat-hi { background: rgba(11, 31, 58, 0.22); color: var(--ink); }
.heat.subtype-heat td.heat-med { background: rgba(11, 31, 58, 0.09); color: var(--ink); }
.heat.subtype-heat td.heat-lo { background: rgba(11, 31, 58, 0.02); color: var(--muted); font-weight: 500; }
.heat.subtype-heat td.heat-max { outline: 2px solid var(--signal); outline-offset: -2px; color: var(--signal); }
.heat-swatch { display: inline-block; width: 12px; height: 10px; vertical-align: middle; margin-right: 2px; border-radius: 2px; }
.heat-swatch.heat-hi { background: rgba(11, 31, 58, 0.22); }
.heat-swatch.heat-med { background: rgba(11, 31, 58, 0.09); }
.heat-swatch.heat-lo { background: rgba(11, 31, 58, 0.04); border: 1px solid var(--border); }

/* Diverging bar chart (Section 8a): origin at center, bars extend left or right */
.div-chart { margin: 12px 0 24px; }
.div-head { display: grid; grid-template-columns: 260px 1fr; gap: 14px; margin-bottom: 12px; padding-bottom: 10px; border-bottom: 1px solid var(--border); align-items: end; }
.div-head-spacer { grid-column: 1; }
.div-head-labels { grid-column: 2; display: flex; justify-content: space-between; align-items: baseline; }
.div-head-label { font-size: 11.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
.div-head-label.left { color: var(--signal); }
.div-head-label.right { color: #3E5A7A; }
.div-row { display: grid; grid-template-columns: 260px 1fr; gap: 14px; align-items: center; margin: 6px 0; }
.div-label { font-size: 13px; color: var(--ink); text-align: right; line-height: 1.35; }
.div-track { position: relative; height: 24px; background: rgba(11, 31, 58, 0.03); border-radius: 2px; }
.div-track::before { content: ''; position: absolute; left: 50%; top: -3px; bottom: -3px; width: 1px; background: var(--ink); opacity: 0.7; }
.div-fill { position: absolute; top: 3px; bottom: 3px; display: flex; align-items: center; color: #fff; font-size: 11px; font-weight: 600; }
.div-fill.right { left: 50%; background: #3E5A7A; border-radius: 0 2px 2px 0; justify-content: flex-end; padding-right: 6px; }
.div-fill.left { right: 50%; background: var(--signal); border-radius: 2px 0 0 2px; justify-content: flex-start; padding-left: 6px; }
.div-val { white-space: nowrap; }
@media print {
  .div-track { background: rgba(11, 31, 58, 0.06) !important; }
  .div-fill.right { background: #3E5A7A !important; }
  .div-fill.left { background: var(--signal) !important; }
  .div-val { color: #fff !important; }
}
.heat.wide tbody td:first-child { width: 200px; padding: 10px 6px; white-space: normal; line-height: 1.25; font-size: 12.5px; vertical-align: top; }
.heat.wide tbody td.cell { padding: 6px 2px; font-size: 12px; text-align: center; vertical-align: middle; }
.heat.wide tbody td.cell .cust { font-size: 9.5px; display: block; margin-top: 1px; color: var(--muted); }
.heat.wide .challenger-hdr { color: #2A7A6E; font-weight: 700; }

/* Migration matrix tightening */
.mig-matrix table { min-width: 0; }
.mig-matrix th:first-child, .mig-matrix td:first-child { min-width: 0; width: 120px; }
.mig-matrix th, .mig-matrix td { padding: 10px 6px; text-align: center; }
.mig-matrix th:first-child, .mig-matrix td:first-child { text-align: left; }

/* Per-bank frustration block (Section 3c replacement for wide table) */
.frus-block { padding: 10px 0; border-bottom: 1px solid var(--border); }
