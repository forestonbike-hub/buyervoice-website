---
// Retail Banking Switcher Study — canonical client-facing report at
// /retail-banking-report/. Self-contained HTML; all data is hardcoded in the
// markup. This replaces the earlier data-loading prototype now archived at
// /retail-banking-report-v2/ (kept for reference only; not for client share).
// Wrapped as Astro with is:inline directives so Astro doesn't scope styles or
// hoist scripts, plus the GA/GTM tags required on every public BV page.
import verbatimExemplars from '../../data/retail-banking-cibc/verbatim-exemplars.json';
const vxScript = '<script>window.__VX=' + JSON.stringify(verbatimExemplars).replace(/<\//g, '<\\/') + ';<' + '/script>';
---
<!DOCTYPE html>
<html lang="en">
<head>
