  <body>
    <div id="root"></div>
    <!-- reCAPTCHA Enterprise - Only load in production -->
    <script>
      // Only load reCAPTCHA Enterprise in production environments
      if (window.location.hostname !== 'localhost' && 
          !window.location.hostname.includes('replit') && 
          !window.location.hostname.includes('127.0.0.1')) {
        const script = document.createElement('script');
        script.src = 'https://www.google.com/recaptcha/enterprise.js?render=6LePCKgrAAAAAEMN98jzeWA6jT9jxrrfMG_MG8o9';
        script.async = true;
        script.defer = true;
        document.head.appendChild(script);
      } else {
        console.log('Development environment detected - skipping reCAPTCHA Enterprise script loading');
        // Set up a mock for development
        window.grecaptcha = {
          enterprise: {
            ready: function(callback) { callback(); },
            execute: function(siteKey, options) { 
              console.log('Development environment - executing mock reCAPTCHA for action:', options.action);
              return Promise.resolve('dev-bypass-token-' + Date.now()); 
            }
          }
        };
      }
    </script>
    <!-- This is a replit script which adds a banner on the top of the page when opened in development mode outside the replit environment -->
    <script type="text/javascript" src="https://replit.com/public/js/replit-dev-banner.js"></script>
